             return Ok(AppRunControl::Continue);
         }
         let (mut resume_config, local_settings) = match self
-            .resume_config_for_target(tui, app_server, &target_session)
+            .resume_config_for_target(
+                tui,
+                app_server,
+                &target_session,
+                super::resume_config::ResumeTargetCwdPolicy::FollowResumePreference,
+            )
             .await
         {
             Ok(config) => config,
