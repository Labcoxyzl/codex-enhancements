             self.transcript.saw_plan_item_this_turn = false;
         }
         if !from_replay {
-            if matches!(self.codex_op_target, CodexOpTarget::AppEvent)
+            if self.supports_service_queue()
                 && let Some(thread_id) = self.thread_id
             {
                 self.app_event_tx
