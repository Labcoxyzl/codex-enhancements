 const READ_TIMEOUT: Duration = Duration::from_secs(/*secs*/ 10);
 
+#[tokio::test]
+async fn second_server_cannot_recover_a_dispatch_owned_by_first_server() -> Result<()> {
+    let (mut first, codex_home, _server) = queue_app(vec![blocked_turn_response()?]).await?;
+    let source_id = first
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    let (_turn_id, _approval_id) = start_blocked_turn(&mut first, &source_id).await?;
+    let item = queue_item(
+        &mut first,
+        ThreadQueueAddParams {
+            destination: Some(QueueDestination::NewThread { name: None }),
+            ..submission(&source_id, "owned dispatch")
+        },
+    )
+    .await?;
+
+    // Model an in-flight fresh-thread reservation while the first server owns the source.
+    let pool = SqlitePool::connect_with(
+        SqliteConnectOptions::new().filename(codex_home.path().join("queue_1.sqlite")),
+    )
+    .await?;
+    let stored: String =
+        sqlx::query_scalar("SELECT payload_json FROM queued_items WHERE thread_id = ? AND id = ?")
+            .bind(&source_id)
+            .bind(&item.id)
+            .fetch_one(&pool)
+            .await?;
+    let mut payload: Value = serde_json::from_str(&stored)?;
+    payload["state"] = json!("dispatching");
+    payload["revision"] = json!(item.revision + 1);
+    payload["createdThreadId"] = json!(uuid::Uuid::now_v7().to_string());
+    sqlx::query("UPDATE queued_items SET payload_json = ? WHERE thread_id = ? AND id = ?")
+        .bind(serde_json::to_string(&payload)?)
+        .bind(&source_id)
+        .bind(&item.id)
+        .execute(&pool)
+        .await?;
+    pool.close().await;
+
+    let mut second = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_managed_config()
+        .build_initialized()
+        .await?;
+    let resume_id = second
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: source_id.clone(),
+            exclude_turns: true,
+            ..Default::default()
+        })
+        .await?;
+    let error: JSONRPCError = timeout(
+        READ_TIMEOUT,
+        second.read_stream_until_error_message(RequestId::Integer(resume_id)),
+    )
+    .await??;
+    assert!(error.error.message.contains("already has an active writer"));
+    // The second server's queue watcher polls every ten seconds.
+    tokio::time::sleep(Duration::from_secs(/*secs*/ 11)).await;
+    let queued = list_queue(&mut first, &source_id).await?.data;
+    assert_eq!(queued[0].id, item.id);
+    assert_eq!(queued[0].state, QueueItemState::Dispatching);
+    assert_eq!(queued[0].revision, item.revision + 1);
+    Ok(())
+}
