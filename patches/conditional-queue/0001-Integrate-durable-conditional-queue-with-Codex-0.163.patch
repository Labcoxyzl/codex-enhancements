+#[tokio::test]
+async fn completed_goal_resumes_unloaded_queue_source_and_preserves_fifo() -> Result<()> {
+    let server = create_mock_responses_server_sequence_unchecked(vec![
+        create_final_assistant_message_sse_response("seed done")?,
+        create_final_assistant_message_sse_response("after goal done")?,
+        create_final_assistant_message_sse_response("tail done")?,
+    ])
+    .await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_approval_policy("on-request")
+        .with_root_config("approvals_reviewer = \"user\"\nthread_unload_delay_secs = 0")
+        .enable_feature(Feature::Goals)
+        .write(home.path())?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .without_managed_config()
+        .build_initialized()
+        .await?;
+    let thread_id = app
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    app.start_turn_and_wait_for_completion(TurnStartParams {
+        thread_id: thread_id.clone(),
+        input: vec![text("seed")],
+        ..Default::default()
+    })
+    .await?;
+    let goal = set_goal(&mut app, &thread_id, "paused").await?;
+    let goal_id = goal.goal_id.context("goal ID missing")?;
+    let head: ThreadQueueAddResponse = app
+        .request(|request_id| ClientRequest::ThreadQueueAdd {
+            request_id,
+            params: ThreadQueueAddParams {
+                thread_id: thread_id.clone(),
+                input: vec![text("after cold goal")],
+                client_user_message_id: "cold-goal-head".to_string(),
+                trigger: Some(QueueTrigger::GoalCompleted {
+                    goal_id: goal_id.clone(),
+                }),
+                action: None,
+                destination: None,
+            },
+        })
+        .await?;
+    let tail: ThreadQueueAddResponse = app
+        .request(|request_id| ClientRequest::ThreadQueueAdd {
+            request_id,
+            params: ThreadQueueAddParams {
+                thread_id: thread_id.clone(),
+                input: vec![text("ready tail")],
+                client_user_message_id: "cold-goal-tail".to_string(),
+                trigger: None,
+                action: None,
+                destination: None,
+            },
+        })
+        .await?;
+    assert_eq!(head.queued_submission.state, QueueItemState::Pending);
+    assert_eq!(tail.queued_submission.state, QueueItemState::Pending);
+    let _: ThreadUnsubscribeResponse = app
+        .request(|request_id| ClientRequest::ThreadUnsubscribe {
+            request_id,
+            params: ThreadUnsubscribeParams {
+                thread_id: thread_id.clone(),
+            },
+        })
+        .await?;
+    timeout(Duration::from_secs(30), async {
+        loop {
+            let loaded: ThreadLoadedListResponse = app
+                .request(|request_id| ClientRequest::ThreadLoadedList {
+                    request_id,
+                    params: ThreadLoadedListParams::default(),
+                })
+                .await?;
+            if !loaded.data.contains(&thread_id) {
+                break Ok::<_, anyhow::Error>(());
+            }
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+    })
+    .await??;
+    tokio::time::sleep(Duration::from_secs(11)).await;
+    let loaded: ThreadLoadedListResponse = app
+        .request(|request_id| ClientRequest::ThreadLoadedList {
+            request_id,
+            params: ThreadLoadedListParams::default(),
+        })
+        .await?;
+    assert!(!loaded.data.contains(&thread_id));
+    assert_eq!(
+        server
+            .received_requests()
+            .await
+            .context("model requests unavailable")?
+            .len(),
+        1
+    );
+    let queued = list_queue(&mut app, &thread_id).await?;
+    assert_eq!(queued.data.len(), 2);
+    assert_eq!(queued.data[0].state, QueueItemState::Pending);
+    assert_eq!(queued.data[1].state, QueueItemState::Pending);
+
+    let request_id = app
+        .send_raw_request(
+            "thread/goal/set",
+            Some(json!({"threadId": thread_id, "status": "complete", "origin": "automatic"})),
+        )
+        .await?;
+    let completed: ThreadGoalSetResponse = app.read_response(request_id).await?;
+    assert_eq!(completed.goal_id.as_deref(), Some(goal_id.as_str()));
+    let delivery = timeout(Duration::from_secs(40), async {
+        loop {
+            let requests = server
+                .received_requests()
+                .await
+                .context("model requests unavailable")?;
+            if requests.len() == 3 {
+                break Ok::<_, anyhow::Error>(());
+            }
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+    })
+    .await;
+    if let Err(error) = delivery {
+        let queued = list_queue(&mut app, &thread_id).await?.data;
+        let loaded: ThreadLoadedListResponse = app
+            .request(|request_id| ClientRequest::ThreadLoadedList {
+                request_id,
+                params: ThreadLoadedListParams::default(),
+            })
+            .await?;
+        let request_count = server
+            .received_requests()
+            .await
+            .context("model requests unavailable")?
+            .len();
+        anyhow::bail!(
+            "cold queue delivery stalled: {error}; queue={queued:?}; loaded={:?}; requests={request_count}",
+            loaded.data
+        );
+    }
+    delivery??;
+    timeout(Duration::from_secs(10), async {
+        loop {
+            if list_queue(&mut app, &thread_id).await?.data.is_empty() {
+                break Ok::<_, anyhow::Error>(());
+            }
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+    })
+    .await??;
+    let read: ThreadReadResponse = timeout(Duration::from_secs(10), async {
+        loop {
+            let read_id = app
+                .send_thread_read_request(ThreadReadParams {
+                    thread_id: thread_id.clone(),
+                    include_turns: true,
+                })
+                .await?;
+            let read: ThreadReadResponse = app.read_response(read_id).await?;
+            if read
+                .thread
+                .turns
+                .iter()
+                .filter(|turn| turn.status == TurnStatus::Completed)
+                .count()
+                == 3
+            {
+                break Ok::<_, anyhow::Error>(read);
+            }
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+    })
+    .await??;
+    assert_eq!(
+        read.thread
+            .turns
+            .iter()
+            .filter(|turn| turn.status == TurnStatus::Completed)
+            .count(),
+        3
+    );
+    let requests = server
+        .received_requests()
+        .await
+        .context("model requests unavailable")?;
+    let prompts = requests
+        .iter()
+        .map(wiremock::Request::body_json::<Value>)
+        .collect::<Result<Vec<_>, _>>()?;
+    assert!(prompts[0]["input"].to_string().contains("seed"));
+    assert!(prompts[1]["input"].to_string().contains("after cold goal"));
+    assert!(prompts[2]["input"].to_string().contains("ready tail"));
+    Ok(())
+}
