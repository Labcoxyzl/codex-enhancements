diff --git a/codex-rs/app-server/tests/suite/v2/thread_queue_restart.rs b/codex-rs/app-server/tests/suite/v2/thread_queue_restart.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6278affea42e2399f28acac45f1e8e4267f96c3c
--- /dev/null
+++ b/codex-rs/app-server/tests/suite/v2/thread_queue_restart.rs
@@ -0,0 +1,293 @@
+//! Queue recovery checks through separate app-server processes sharing one disposable home.
+
+use std::time::Duration;
+
+use anyhow::Context;
+use anyhow::Result;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use app_test_support::create_mock_responses_server_repeating_assistant;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::ItemStartedNotification;
+use codex_app_server_protocol::JSONRPCError;
+use codex_app_server_protocol::QueueAction;
+use codex_app_server_protocol::QueueItemState;
+use codex_app_server_protocol::QueueTrigger;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ThreadItem;
+use codex_app_server_protocol::ThreadQueueAckParams;
+use codex_app_server_protocol::ThreadQueueAckResponse;
+use codex_app_server_protocol::ThreadQueueAddParams;
+use codex_app_server_protocol::ThreadQueueAddResponse;
+use codex_app_server_protocol::ThreadQueueClaimParams;
+use codex_app_server_protocol::ThreadQueueClaimResponse;
+use codex_app_server_protocol::ThreadQueueListParams;
+use codex_app_server_protocol::ThreadQueueListResponse;
+use codex_app_server_protocol::ThreadResumeParams;
+use codex_app_server_protocol::ThreadResumeResponse;
+use codex_app_server_protocol::ThreadStartParams;
+use codex_app_server_protocol::TurnCompletedNotification;
+use codex_app_server_protocol::TurnStartParams;
+use codex_app_server_protocol::TurnStatus;
+use codex_app_server_protocol::UserInput;
+use codex_state::SqliteConfig;
+use codex_utils_absolute_path::test_support::PathExt;
+use serde_json::Value;
+use serde_json::json;
+use tempfile::TempDir;
+use tokio::time::timeout;
+
+const READ_TIMEOUT: Duration = Duration::from_secs(20);
+
+#[tokio::test]
+async fn restart_keeps_claimed_ui_head_ahead_of_pending_prompt() -> Result<()> {
+    let (mut first, home, mock) = queue_app().await?;
+    let thread_id = materialized_thread(&mut first).await?;
+    let ui = add(
+        &mut first,
+        ThreadQueueAddParams {
+            input: vec![],
+            action: Some(QueueAction::UiCommand {
+                draft: json!({"text": "/help"}),
+            }),
+            ..submission(&thread_id, "claimed UI head")
+        },
+    )
+    .await?;
+    let tail = add(&mut first, submission(&thread_id, "prompt after UI ack")).await?;
+    let claimed: ThreadQueueClaimResponse = first
+        .request(|request_id| ClientRequest::ThreadQueueClaim {
+            request_id,
+            params: ThreadQueueClaimParams {
+                thread_id: thread_id.clone(),
+            },
+        })
+        .await?;
+    assert_eq!(
+        claimed
+            .queued_submission
+            .context("UI head was not claimed")?
+            .id,
+        ui
+    );
+    assert_eq!(
+        queue(&mut first, &thread_id).await?.data[0].state,
+        QueueItemState::AwaitingUi
+    );
+    timeout(READ_TIMEOUT, first.shutdown_gracefully()).await??;
+    drop(first);
+
+    let mut resumed = restart(home.path()).await?;
+    let _: ThreadResumeResponse = resumed
+        .request(|request_id| ClientRequest::ThreadResume {
+            request_id,
+            params: ThreadResumeParams {
+                thread_id: thread_id.clone(),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let entries = queue(&mut resumed, &thread_id).await?.data;
+    assert_eq!(
+        entries
+            .iter()
+            .map(|entry| entry.id.as_str())
+            .collect::<Vec<_>>(),
+        vec![ui.as_str(), tail.as_str()]
+    );
+    assert_eq!(entries[0].state, QueueItemState::AwaitingUi);
+    assert_eq!(entries[1].state, QueueItemState::Pending);
+    assert_eq!(
+        response_requests(&mock).await?,
+        1,
+        "pending tail ran before UI acknowledgement"
+    );
+    let claim_again: ThreadQueueClaimResponse = resumed
+        .request(|request_id| ClientRequest::ThreadQueueClaim {
+            request_id,
+            params: ThreadQueueClaimParams {
+                thread_id: thread_id.clone(),
+            },
+        })
+        .await?;
+    assert!(
+        claim_again.queued_submission.is_none(),
+        "claimed UI action replayed"
+    );
+
+    let _: ThreadQueueAckResponse = resumed
+        .request(|request_id| ClientRequest::ThreadQueueAck {
+            request_id,
+            params: ThreadQueueAckParams {
+                thread_id: thread_id.clone(),
+                queued_submission_id: ui,
+                revision: entries[0].revision,
+            },
+        })
+        .await?;
+    let started: ItemStartedNotification =
+        timeout(READ_TIMEOUT, resumed.read_notification("item/started")).await??;
+    let ThreadItem::UserMessage { content, .. } = started.item else {
+        anyhow::bail!("queued prompt did not start as a user message");
+    };
+    assert_eq!(content, vec![text("prompt after UI ack")]);
+    let completed: TurnCompletedNotification =
+        timeout(READ_TIMEOUT, resumed.read_notification("turn/completed")).await??;
+    assert_eq!(completed.thread_id, thread_id);
+    assert_eq!(completed.turn.status, TurnStatus::Completed);
+    assert!(queue(&mut resumed, &thread_id).await?.data.is_empty());
+    assert_eq!(
+        response_requests(&mock).await?,
+        2,
+        "tail was sent more than once"
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn restart_marks_ambiguous_dispatch_uncertain_without_resending() -> Result<()> {
+    let (mut first, home, mock) = queue_app().await?;
+    let thread_id = materialized_thread(&mut first).await?;
+    let item_id = add(
+        &mut first,
+        ThreadQueueAddParams {
+            trigger: Some(QueueTrigger::TurnCompleted {
+                turn_id: "future-turn".to_string(),
+            }),
+            ..submission(&thread_id, "never duplicate this prompt")
+        },
+    )
+    .await?;
+    assert_eq!(
+        queue(&mut first, &thread_id).await?.data[0].state,
+        QueueItemState::Pending
+    );
+    timeout(READ_TIMEOUT, first.shutdown_gracefully()).await??;
+    drop(first);
+
+    // Simulate a crash after persisting dispatch intent but before recording its outcome.
+    let sqlite = SqliteConfig::new_for_testing(home.path().abs());
+    let pool = sqlite.open_read_write_pool(&sqlite.queue_db_path()).await?;
+    let raw: String = sqlx::query_scalar("SELECT payload_json FROM queued_items WHERE id = ?")
+        .bind(&item_id)
+        .fetch_one(&pool)
+        .await?;
+    let mut payload: Value = serde_json::from_str(&raw)?;
+    assert_eq!(payload["state"], "pending");
+    payload["state"] = json!("dispatching");
+    sqlx::query("UPDATE queued_items SET payload_json = ? WHERE id = ?")
+        .bind(payload.to_string())
+        .bind(&item_id)
+        .execute(&pool)
+        .await?;
+    pool.close().await;
+
+    let mut resumed = restart(home.path()).await?;
+    let _: ThreadResumeResponse = resumed
+        .request(|request_id| ClientRequest::ThreadResume {
+            request_id,
+            params: ThreadResumeParams {
+                thread_id: thread_id.clone(),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let entries = queue(&mut resumed, &thread_id).await?.data;
+    assert_eq!(entries.len(), 1);
+    assert_eq!(entries[0].id, item_id);
+    assert_eq!(entries[0].state, QueueItemState::Uncertain);
+    let request_id = resumed
+        .send_raw_request("thread/queue/start", Some(json!({"threadId": thread_id})))
+        .await?;
+    let error: JSONRPCError = timeout(
+        READ_TIMEOUT,
+        resumed.read_stream_until_error_message(RequestId::Integer(request_id)),
+    )
+    .await??;
+    assert!(error.error.message.contains("waiting"));
+    assert_eq!(
+        response_requests(&mock).await?,
+        1,
+        "ambiguous prompt was resent"
+    );
+    Ok(())
+}
+
+async fn queue_app() -> Result<(TestAppServer, TempDir, wiremock::MockServer)> {
+    let home = TempDir::new()?;
+    let mock = create_mock_responses_server_repeating_assistant("reply").await;
+    MockResponsesConfig::new(&mock.uri()).write(home.path())?;
+    Ok((restart(home.path()).await?, home, mock))
+}
+
+async fn restart(home: &std::path::Path) -> Result<TestAppServer> {
+    TestAppServer::builder()
+        .with_codex_home(home)
+        .without_managed_config()
+        .build_initialized()
+        .await
+}
+
+async fn materialized_thread(app: &mut TestAppServer) -> Result<String> {
+    let thread_id = app
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    let completed = app
+        .start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: thread_id.clone(),
+            input: vec![text("materialize before restart")],
+            ..Default::default()
+        })
+        .await?;
+    assert_eq!(completed.turn.status, TurnStatus::Completed);
+    Ok(thread_id)
+}
+
+async fn add(app: &mut TestAppServer, params: ThreadQueueAddParams) -> Result<String> {
+    let added: ThreadQueueAddResponse = app
+        .request(|request_id| ClientRequest::ThreadQueueAdd { request_id, params })
+        .await?;
+    Ok(added.queued_submission.id)
+}
+
+async fn queue(app: &mut TestAppServer, thread_id: &str) -> Result<ThreadQueueListResponse> {
+    app.request(|request_id| ClientRequest::ThreadQueueList {
+        request_id,
+        params: ThreadQueueListParams {
+            thread_id: thread_id.to_string(),
+            cursor: None,
+            limit: None,
+        },
+    })
+    .await
+}
+
+async fn response_requests(mock: &wiremock::MockServer) -> Result<usize> {
+    Ok(mock
+        .received_requests()
+        .await
+        .context("mock request capture unavailable")?
+        .iter()
+        .filter(|request| request.url.path().ends_with("/responses"))
+        .count())
+}
+
+fn submission(thread_id: &str, content: &str) -> ThreadQueueAddParams {
+    ThreadQueueAddParams {
+        thread_id: thread_id.to_string(),
+        input: vec![text(content)],
+        client_user_message_id: format!("queued-{content}"),
+        trigger: None,
+        action: None,
+        destination: None,
+    }
+}
+
+fn text(value: &str) -> UserInput {
+    UserInput::Text {
+        text: value.to_string(),
+        text_elements: Vec::new(),
+    }
+}
