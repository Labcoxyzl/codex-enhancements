+        loaded_thread_queue(&test)?,
+        Arc::downgrade(&test.thread_manager),
+        Arc::new(NoopExtensionEventSink),
+    );
+    let listener_attached = Arc::new(AtomicBool::new(false));
+    let attached = Arc::clone(&listener_attached);
+    let manager = Arc::downgrade(&test.thread_manager);
+    service.set_target_loader(Arc::new(move |thread_id| {
+        let manager = manager.clone();
+        let attached = Arc::clone(&attached);
+        Box::pin(async move {
+            let manager = manager
+                .upgrade()
+                .ok_or_else(|| std::io::Error::other("thread manager unavailable"))?;
+            let thread = manager
+                .get_thread(thread_id)
+                .await
+                .map_err(|error| std::io::Error::other(error.to_string()))?;
+            attached.store(true, Ordering::SeqCst);
+            Ok(QueueLoadedTarget::new(thread, Box::new(())))
+        })
+    }));
+    let first = service
+        .enqueue_with_metadata(
+            source_id,
+            user_input("fresh prompt"),
+            QueueMetadata {
+                destination: QueueDestination::NewThread,
+                ..Default::default()
+            },
+        )
+        .await?;
+    let follow_up = service
+        .enqueue_with_metadata(
+            source_id,
+            user_input("later in fresh thread"),
