+use super::*;
+use codex_app_server_protocol::QueueItemState;
+use codex_app_server_protocol::QueueTrigger;
+use codex_app_server_protocol::ThreadQueueUpdateParams;
+
+#[test]
+fn editing_text_replaces_all_chunks_without_losing_attachments() {
+    let item = QueuedSubmission {
+        id: "item".into(),
+        input: vec![
+            UserInput::Text {
+                text: "old ".into(),
+                text_elements: Vec::new(),
+            },
+            UserInput::Image {
+                image: codex_app_server_protocol::ImageReference::Inline {
+                    url: "https://example.com/image.png".into(),
+                },
+                detail: None,
+            },
+            UserInput::LocalImage {
+                path: "/tmp/image.png".into(),
+                detail: None,
+            },
+            UserInput::Text {
+                text: "stale".into(),
+                text_elements: Vec::new(),
+            },
+            UserInput::Mention {
+                name: "tool".into(),
+                path: "app://tool".into(),
+            },
+        ],
+        client_user_message_id: "message".into(),
+        trigger: QueueTrigger::NextTurn,
+        action: QueueAction::Prompt,
+        destination: QueueDestination::SourceThread,
+        state: QueueItemState::Pending,
+        revision: 0,
+        position: 0,
+        created_goal_id: None,
+        created_thread_id: None,
+    };
+    let (input, action) = edit_queue_item_text(&item, "new text".into(), &[]).unwrap();
+    assert!(action.is_none());
+    assert_eq!(
+        input,
+        vec![
+            UserInput::Text {
+                text: "new text".into(),
+                text_elements: Vec::new()
+            },
+            UserInput::Image {
+                image: codex_app_server_protocol::ImageReference::Inline {
+                    url: "https://example.com/image.png".into(),
+                },
+                detail: None,
+            },
+            UserInput::LocalImage {
+                path: "/tmp/image.png".into(),
+                detail: None
+            },
+        ]
+    );
+}
+
+#[test]
+fn editing_prompt_keeps_app_mention_by_visible_slug() {
+    let item = QueuedSubmission {
+        id: "app-prompt".into(),
+        input: vec![
+            UserInput::Text {
+                text: "Ask $google-calendar".into(),
+                text_elements: Vec::new(),
+            },
+            UserInput::Mention {
+                name: "Google Calendar".into(),
+                path: "app://calendar-id".into(),
+            },
+        ],
+        client_user_message_id: "message".into(),
+        trigger: QueueTrigger::NextTurn,
+        action: QueueAction::Prompt,
+        destination: QueueDestination::SourceThread,
+        state: QueueItemState::Pending,
+        revision: 0,
+        position: 0,
+        created_goal_id: None,
+        created_thread_id: None,
+    };
+    let (input, _) = edit_queue_item_text(&item, "Ask $google-calendar today".into(), &[]).unwrap();
+    assert!(
+        input
+            .iter()
+            .any(|part| matches!(part, UserInput::Mention { name, path }
+            if name == "Google Calendar" && path == "app://calendar-id"))
+    );
+
+    for edited in [
+        "Ask today",
+        "Ask $google-calendar-extra",
+        "Ask $google-calendarish",
+    ] {
+        let (removed, _) = edit_queue_item_text(&item, edited.into(), &[]).unwrap();
+        assert!(
+            !removed
+                .iter()
+                .any(|part| matches!(part, UserInput::Mention { .. })),
+            "app mention was retained for {edited:?}"
+        );
+    }
+    let (kept, _) = edit_queue_item_text(&item, "Ask $google-calendar.".into(), &[]).unwrap();
+    assert!(
+        kept.iter()
+            .any(|part| matches!(part, UserInput::Mention { .. }))
+    );
+
+    let Some(QueueAction::UiCommand { draft }) =
+        crate::chatwidget::service_queue_ui_action_from_item(&item)
+    else {
+        panic!("expected UI command")
+    };
+    let reconstructed: crate::chatwidget::QueueUiDraft = serde_json::from_value(draft).unwrap();
+    assert_eq!(reconstructed.user_message.mention_bindings[0].sigil, '$');
+    assert_eq!(
+        reconstructed.user_message.mention_bindings[0].mention,
+        "google-calendar"
+    );
+
+    let mut ui_item = item;
+    ui_item.action = QueueAction::UiCommand {
+        draft: serde_json::json!({
+            "user_message": {
+                "text": "Ask $google-calendar",
+                "local_images": [],
+                "remote_image_urls": [],
+                "text_elements": [],
+                "mention_bindings": [{"sigil": "$", "mention": "google-calendar", "path": "app://calendar-id"}]
+            },
+            "action": "Literal",
+            "pending_pastes": [],
+            "source": "Prompt",
+            "history_record": "UserMessageText"
+        }),
+    };
+    let (input, action) =
+        edit_queue_item_text(&ui_item, "Ask $google-calendar-extra".into(), &[]).unwrap();
+    assert!(
+        !input
+            .iter()
+            .any(|part| matches!(part, UserInput::Mention { .. }))
+    );
+    let Some(QueueAction::UiCommand { draft }) = action else {
+        panic!("expected UI command")
+    };
+    let edited: crate::chatwidget::QueueUiDraft = serde_json::from_value(draft).unwrap();
+    assert!(edited.user_message.mention_bindings.is_empty());
+}
+
+#[test]
+fn goal_choices_and_edits_keep_objective_out_of_prompt_input() {
+    let mut item = QueuedSubmission {
+        id: "goal".into(),
+        input: vec![UserInput::Text {
+            text: "/goal first objective".into(),
+            text_elements: Vec::new(),
+        }],
+        client_user_message_id: "message".into(),
+        trigger: QueueTrigger::NextTurn,
+        action: QueueAction::Prompt,
