+use super::App;
+use super::queue_item_editor::converted_queue_action;
+use super::queue_item_editor::edit_queue_item_from_editor;
+use super::queue_item_editor::service_queue_action_choices;
+use crate::app_event::AppEvent;
+use crate::app_event::ServiceQueueChange;
+use crate::app_server_session::AppServerSession;
+use crate::bottom_pane::QueueViewOutput;
+use crate::bottom_pane::SelectionAction;
+use crate::bottom_pane::SelectionItem;
+use crate::bottom_pane::SelectionViewParams;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::QueueAction;
+use codex_app_server_protocol::QueueDestination;
+use codex_app_server_protocol::QueueTrigger;
+use codex_app_server_protocol::QueuedSubmission;
+use codex_app_server_protocol::ThreadQueueAckParams;
+use codex_app_server_protocol::ThreadQueueAckResponse;
+use codex_app_server_protocol::ThreadQueueClaimParams;
+use codex_app_server_protocol::ThreadQueueClaimResponse;
+use codex_app_server_protocol::ThreadQueueDeleteParams;
+use codex_app_server_protocol::ThreadQueueDeleteResponse;
+use codex_app_server_protocol::ThreadQueueListParams;
+use codex_app_server_protocol::ThreadQueueListResponse;
+use codex_app_server_protocol::ThreadQueueReorderParams;
+use codex_app_server_protocol::ThreadQueueReorderResponse;
+use codex_app_server_protocol::ThreadQueueUpdateParams;
+use codex_app_server_protocol::ThreadQueueUpdateResponse;
+use codex_app_server_protocol::UserInput;
+use codex_protocol::ThreadId;
+
+impl App {
+    pub(super) async fn refresh_service_queue(
+        &mut self,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+        open: bool,
+    ) {
+        if self.chat_widget.thread_id() == Some(thread_id) {
+            self.chat_widget.recover_pending_service_queue_drafts();
+        }
+        let mut items = Vec::new();
+        let mut cursor = None;
+        loop {
+            let request_id = app_server.next_request_id();
+            let result: Result<ThreadQueueListResponse, _> = app_server
+                .request_handle()
+                .request_typed(ClientRequest::ThreadQueueList {
+                    request_id,
+                    params: ThreadQueueListParams {
+                        thread_id: thread_id.to_string(),
+                        cursor,
+                        limit: Some(200),
+                    },
+                })
+                .await;
+            let response = match result {
+                Ok(response) => response,
+                Err(_) => {
+                    if self.chat_widget.thread_id() == Some(thread_id) {
+                        self.chat_widget.add_error_message(
+                            "Could not read the server queue. Local recovery drafts are shown."
+                                .into(),
+                        );
+                        self.chat_widget
+                            .set_service_queue_items(thread_id, Vec::new());
+                        if open {
+                            self.chat_widget.show_service_queue_manager(thread_id);
+                        }
+                    }
+                    return;
+                }
+            };
+            items.extend(response.data);
+            let Some(next) = response.next_cursor else {
+                break;
+            };
+            cursor = Some(next);
+        }
+        if let Ok(pending) = crate::queue_add_journal::load_for_thread(
+            self.local_settings.codex_home.as_path(),
+            thread_id,
+        ) {
+            for submission in pending {
+                if items
+                    .iter()
+                    .any(|item| item.client_user_message_id == submission.client_user_message_id)
+                {
+                    self.confirm_service_queue_add(thread_id, &submission.client_user_message_id)
+                        .await;
+                }
+            }
+        }
+        if self.current_displayed_thread_id() == Some(thread_id) {
+            self.chat_widget.set_service_queue_items(thread_id, items);
+            if open {
+                self.chat_widget.show_service_queue_manager(thread_id);
+            }
+        }
+    }
+
+    pub(super) async fn apply_service_queue_view_output(
+        &mut self,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+        output: QueueViewOutput,
+    ) {
+        if self.current_displayed_thread_id() != Some(thread_id) {
+            return;
+        }
+        match output {
+            QueueViewOutput::Edit { id } => {
+                if let Some(item) = self
+                    .chat_widget
+                    .service_queue_items()
+                    .iter()
+                    .find(|item| item.id == id)
+                    .cloned()
+                {
+                    self.chat_widget
+                        .open_service_queue_text_editor(thread_id, &item);
+                }
+            }
+            QueueViewOutput::Trigger { id } => {
+                self.show_service_queue_trigger_choices(app_server, thread_id, id)
+                    .await;
+            }
+            QueueViewOutput::Action { id } => {
+                self.show_service_queue_action_choices(thread_id, id);
+            }
+            QueueViewOutput::Destination { id } => {
+                self.show_service_queue_destination_choices(thread_id, id);
+            }
+            QueueViewOutput::RecheckLocal {
+                client_user_message_id,
+            } => {
+                if !self.has_local_queue_add(&client_user_message_id) {
+                    return;
+                }
+                if self
+                    .service_queue_add_is_confirmed(app_server, thread_id, &client_user_message_id)
+                    .await
+                {
+                    self.confirm_service_queue_add(thread_id, &client_user_message_id)
+                        .await;
+                    self.refresh_service_queue(app_server, thread_id, false)
+                        .await;
+                    self.claim_service_queue_ui(app_server, thread_id).await;
+                } else {
+                    self.chat_widget.add_info_message(
+                        "Delivery is still unconfirmed. The draft has not been resent. Do not retry until delivery is resolved."
+                            .into(),
+                        None,
+                    );
+                }
+            }
+            QueueViewOutput::DiscardLocal {
+                client_user_message_id,
+            } => {
+                if !self.has_local_queue_add(&client_user_message_id) {
+                    return;
+                }
+                let action: SelectionAction = Box::new(move |tx| {
+                    tx.send(AppEvent::ServiceQueueViewOutput {
+                        thread_id,
+                        output: QueueViewOutput::ConfirmDiscardLocal {
+                            client_user_message_id: client_user_message_id.clone(),
+                        },
+                    });
+                });
+                self.chat_widget.show_selection_view(SelectionViewParams {
+                    title: Some(
+                        "Discard local copy? The server action may still run; this does not cancel it."
+                            .into(),
+                    ),
+                    items: vec![
+                        SelectionItem {
+                            name: "Keep draft".into(),
+                            actions: vec![Box::new(|_| {})],
+                            dismiss_on_select: true,
+                            ..Default::default()
+                        },
+                        SelectionItem {
+                            name: "Discard local copy only".into(),
+                            actions: vec![action],
+                            dismiss_on_select: true,
+                            ..Default::default()
+                        },
+                    ],
+                    ..Default::default()
+                });
+            }
+            QueueViewOutput::ConfirmDiscardLocal {
+                client_user_message_id,
+            } => {
+                if !self.has_local_queue_add(&client_user_message_id) {
+                    return;
+                }
+                if crate::queue_add_journal::remove(
+                    self.local_settings.codex_home.as_path(),
+                    thread_id,
+                    &client_user_message_id,
+                )
+                .is_err()
+                {
+                    self.chat_widget.add_error_message(
+                        "Could not discard the local queue recovery copy. The draft was kept."
+                            .into(),
+                    );
+                    return;
+                }
+                self.discard_local_queue_add(thread_id, &client_user_message_id)
+                    .await;
+                self.refresh_service_queue(app_server, thread_id, false)
+                    .await;
+            }
+            QueueViewOutput::Cancel { id } => {
+                let client_id = self
+                    .chat_widget
+                    .service_queue_items()
+                    .iter()
+                    .find(|item| item.id == id)
+                    .map(|item| item.client_user_message_id.clone());
+                let request_id = app_server.next_request_id();
+                let result: Result<ThreadQueueDeleteResponse, _> = app_server
+                    .request_handle()
+                    .request_typed(ClientRequest::ThreadQueueDelete {
+                        request_id,
+                        params: ThreadQueueDeleteParams {
+                            thread_id: thread_id.to_string(),
+                            queued_submission_id: id,
+                        },
+                    })
+                    .await;
+                // The server snapshot's exact client ID proves this add was accepted, even if
+                // deletion races with dispatch or its reply is lost.
+                if let Some(client_id) = client_id {
+                    self.confirm_service_queue_add(thread_id, &client_id).await;
+                }
+                match result {
+                    Ok(response) if response.deleted => {}
+                    Ok(_) => self.chat_widget.add_info_message(
+                        "The queued item was not canceled and may still run on the server.".into(),
+                        None,
+                    ),
+                    Err(_) => self.chat_widget.add_error_message(
+                        "Could not confirm cancellation. The queued item may still run.".into(),
+                    ),
+                }
+                self.refresh_service_queue(app_server, thread_id, false)
+                    .await;
+            }
+            QueueViewOutput::Reorder { id, to_index } => {
+                let mut ids: Vec<String> = self
+                    .chat_widget
+                    .service_queue_items()
+                    .iter()
+                    .filter(|item| {
+                        !matches!(
+                            item.state,
+                            codex_app_server_protocol::QueueItemState::Completed
+                                | codex_app_server_protocol::QueueItemState::Canceled
+                        )
+                    })
+                    .map(|item| item.id.clone())
+                    .collect();
+                if let Some(index) = ids.iter().position(|item_id| item_id == &id) {
+                    let moved = ids.remove(index);
+                    ids.insert(to_index.min(ids.len()), moved);
+                    let request_id = app_server.next_request_id();
+                    let result: Result<ThreadQueueReorderResponse, _> = app_server
+                        .request_handle()
+                        .request_typed(ClientRequest::ThreadQueueReorder {
+                            request_id,
+                            params: ThreadQueueReorderParams {
+                                thread_id: thread_id.to_string(),
+                                queued_submission_ids: ids,
+                            },
+                        })
+                        .await;
+                    if let Err(error) = result {
+                        self.chat_widget
+                            .add_error_message(format!("Could not reorder queue: {error}"));
+                    }
+                    self.refresh_service_queue(app_server, thread_id, false)
+                        .await;
+                }
+            }
+        }
+    }
+
+    fn show_service_queue_choices(
+        &mut self,
+        thread_id: ThreadId,
+        id: String,
+        title: &str,
+        choices: Vec<(String, ServiceQueueChange)>,
+        disabled: Vec<(String, String)>,
+    ) {
+        let mut items: Vec<_> = choices
+            .into_iter()
+            .map(|(name, change)| {
+                let id = id.clone();
+                let action: SelectionAction = Box::new(move |tx| {
+                    tx.send(AppEvent::ServiceQueueChange {
+                        thread_id,
+                        id: id.clone(),
+                        change: change.clone(),
+                    });
+                });
+                SelectionItem {
+                    name,
+                    actions: vec![action],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                }
+            })
+            .collect();
+        items.extend(disabled.into_iter().map(|(name, reason)| SelectionItem {
+            name,
+            disabled_reason: Some(reason),
+            ..Default::default()
+        }));
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            title: Some(title.to_string()),
+            items,
+            ..Default::default()
+        });
+    }
+
+    async fn show_service_queue_trigger_choices(
+        &mut self,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+        id: String,
+    ) {
+        let Some(item) = self
+            .chat_widget
+            .service_queue_items()
+            .iter()
+            .find(|item| item.id == id)
+        else {
+            return;
+        };
+        let position = item.position;
+        let mut choices = vec![(
+            "After response (or now if idle)".to_string(),
+            ServiceQueueChange::Trigger(QueueTrigger::NextTurn),
+        )];
+        if let Some(turn_id) = self.chat_widget.service_queue_latest_turn_id() {
+            choices.push((
+                "After latest response".to_string(),
+                ServiceQueueChange::Trigger(QueueTrigger::TurnCompleted { turn_id }),
+            ));
+        }
+        if let Ok(response) = app_server.thread_goal_get(thread_id).await
+            && let Some(goal_id) = response.goal_id
+        {
+            choices.push((
+                "After current goal completes".to_string(),
+                ServiceQueueChange::Trigger(QueueTrigger::GoalCompleted { goal_id }),
+            ));
+        }
+        for prior in self
+            .chat_widget
+            .service_queue_items()
+            .iter()
+            .filter(|candidate| candidate.position < position)
+        {
+            if matches!(prior.action, QueueAction::Goal { .. }) {
+                choices.push((
+                    format!("After queued goal {}", prior.position + 1),
+                    ServiceQueueChange::Trigger(QueueTrigger::QueuedGoalCompleted {
+                        queued_item_id: prior.id.clone(),
+                    }),
+                ));
+            }
+        }
+        self.show_service_queue_choices(
+            thread_id,
+            id,
+            "When should this run?",
+            choices,
+            Vec::new(),
+        );
+    }
+
+    fn show_service_queue_action_choices(&mut self, thread_id: ThreadId, id: String) {
+        let Some(item) = self
+            .chat_widget
+            .service_queue_items()
+            .iter()
+            .find(|item| item.id == id)
+        else {
+            return;
+        };
+        let (choices, disabled) = service_queue_action_choices(item);
+        self.show_service_queue_choices(
+            thread_id,
+            id,
+            "What should this item do?",
+            choices,
+            disabled,
+        );
+    }
+
+    fn show_service_queue_destination_choices(&mut self, thread_id: ThreadId, id: String) {
+        let Some(item) = self
+            .chat_widget
+            .service_queue_items()
+            .iter()
+            .find(|item| item.id == id)
+        else {
+            return;
+        };
+        let position = item.position;
+        let mut choices = vec![(
+            "Current thread".to_string(),
+            ServiceQueueChange::Destination(QueueDestination::SourceThread),
+        )];
+        if !matches!(item.action, QueueAction::UiCommand { .. }) {
+            choices.push((
+                "New thread".to_string(),
+                ServiceQueueChange::Destination(QueueDestination::NewThread),
+            ));
+            for prior in self
+                .chat_widget
+                .service_queue_items()
+                .iter()
+                .filter(|candidate| candidate.position < position)
+            {
+                if prior.destination == QueueDestination::NewThread {
+                    choices.push((
+                        format!("Thread from item {}", prior.position + 1),
+                        ServiceQueueChange::Destination(QueueDestination::CreatedThread {
+                            queued_item_id: prior.id.clone(),
+                        }),
+                    ));
+                }
+            }
+        }
+        self.show_service_queue_choices(
+            thread_id,
+            id,
+            "Where should this run?",
+            choices,
+            Vec::new(),
+        );
+    }
+
+    pub(super) async fn change_service_queue_item(
+        &mut self,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+        id: String,
+        change: ServiceQueueChange,
+    ) {
+        if self.current_displayed_thread_id() != Some(thread_id) {
+            return;
+        }
+        let Some(item) = self
+            .chat_widget
+            .service_queue_items()
+            .iter()
+            .find(|item| item.id == id)
+            .cloned()
+        else {
+            self.chat_widget
+                .add_error_message("Queue item was removed before editing.".to_string());
+            return;
+        };
+        let (trigger, action, destination, input) = match change {
+            ServiceQueueChange::Trigger(value) => (Some(value), None, None, item.input.clone()),
+            ServiceQueueChange::Action(value) => match converted_queue_action(&item, value) {
+                Ok((input, action)) => (None, Some(action), None, input),
+                Err(reason) => {
+                    self.chat_widget.add_error_message(reason);
+                    return;
+                }
+            },
+            ServiceQueueChange::Destination(value) => (None, None, Some(value), item.input.clone()),
+        };
+        self.update_service_queue_item(
+            app_server,
+            thread_id,
+            item,
+            input,
+            action,
+            trigger,
+            destination,
+        )
+        .await;
+    }
+
+    pub(super) async fn edit_service_queue_text(
+        &mut self,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+        id: String,
+        text: String,
+    ) {
+        if self.current_displayed_thread_id() != Some(thread_id) {
+            return;
+        }
+        let Some(item) = self
+            .chat_widget
+            .service_queue_items()
+            .iter()
+            .find(|item| item.id == id)
+            .cloned()
+        else {
+            self.chat_widget
+                .add_error_message("Queue item was removed before editing.".to_string());
+            return;
+        };
+        let (input, action) = match edit_queue_item_from_editor(&item, text) {
+            Ok(edited) => edited,
+            Err(error) => {
+                self.chat_widget.add_error_message(error);
+                return;
+            }
+        };
+        self.update_service_queue_item(app_server, thread_id, item, input, action, None, None)
+            .await;
+    }
+
+    async fn update_service_queue_item(
+        &mut self,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+        item: QueuedSubmission,
+        input: Vec<UserInput>,
+        action: Option<QueueAction>,
+        trigger: Option<codex_app_server_protocol::QueueTrigger>,
+        destination: Option<codex_app_server_protocol::QueueDestination>,
+    ) {
+        let request_id = app_server.next_request_id();
+        let result: Result<ThreadQueueUpdateResponse, _> = app_server
+            .request_handle()
+            .request_typed(ClientRequest::ThreadQueueUpdate {
+                request_id,
+                params: ThreadQueueUpdateParams {
+                    thread_id: thread_id.to_string(),
+                    queued_submission_id: item.id,
+                    input,
+                    trigger,
+                    action,
+                    destination,
+                    expected_revision: Some(item.revision),
+                },
+            })
+            .await;
+        if let Err(error) = result {
+            self.chat_widget
+                .add_error_message(format!("Could not update queue item: {error}"));
+        }
+        self.refresh_service_queue(app_server, thread_id, false)
+            .await;
+    }
+
+    pub(super) async fn claim_service_queue_ui(
+        &mut self,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+    ) {
+        if !self.chat_widget.can_claim_service_queue_ui(thread_id) {
+            return;
+        }
+        let request_id = app_server.next_request_id();
+        let result: Result<ThreadQueueClaimResponse, _> = app_server
+            .request_handle()
+            .request_typed(ClientRequest::ThreadQueueClaim {
+                request_id,
+                params: ThreadQueueClaimParams {
+                    thread_id: thread_id.to_string(),
+                },
+            })
+            .await;
+        let item = match result {
+            Ok(response) => response.queued_submission,
+            Err(error) => {
+                self.chat_widget
+                    .add_error_message(format!("Could not claim queued command: {error}"));
+                return;
+            }
+        };
+        let Some(item) = item else {
+            return;
+        };
+        if !self.chat_widget.can_claim_service_queue_ui(thread_id) {
+            return;
+        }
+        let QueueAction::UiCommand { draft } = item.action else {
+            return;
+        };
+        let draft = match serde_json::from_value::<crate::chatwidget::QueueUiDraft>(draft) {
+            Ok(draft) => draft,
+            Err(error) => {
+                self.chat_widget
+                    .add_error_message(format!("Queued command could not be decoded: {error}"));
+                return;
+            }
+        };
+        if self
+            .chat_widget
+            .run_claimed_service_queue_draft(thread_id, draft, &item.input)
+        {
+            self.chat_widget
+                .acknowledge_claimed_service_queue_ui_when_ready(thread_id, item.id, item.revision);
+        } else {
+            self.chat_widget.add_error_message(
+                "Queued command needs manual recovery before the queue can continue.".to_string(),
+            );
+        }
+    }
+
+    pub(super) async fn ack_service_queue_ui(
+        &mut self,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+        id: String,
+        revision: u64,
+    ) {
+        let request_id = app_server.next_request_id();
+        let result: Result<ThreadQueueAckResponse, _> = app_server
+            .request_handle()
+            .request_typed(ClientRequest::ThreadQueueAck {
+                request_id,
+                params: ThreadQueueAckParams {
+                    thread_id: thread_id.to_string(),
+                    queued_submission_id: id,
+                    revision,
+                },
+            })
+            .await;
+        if let Err(error) = result
+            && self.current_displayed_thread_id() == Some(thread_id)
+        {
+            self.chat_widget.add_error_message(format!(
+                "Queue command acknowledgement was not confirmed: {error}"
+            ));
+        }
+        self.refresh_service_queue(app_server, thread_id, false)
+            .await;
+    }
+}
