+#[test]
+fn queued_draft_editor_can_remove_markerless_remote_image() {
+    let url = "data:image/png;base64,aGVsbG8=";
+    let item = QueuedSubmission {
+        id: "remote-image".into(),
+        input: vec![
+            UserInput::Image {
+                image: codex_app_server_protocol::ImageReference::Inline { url: url.into() },
+                detail: None,
+            },
+            UserInput::Text {
+                text: "Describe this".into(),
+                text_elements: Vec::new(),
+            },
+        ],
+        client_user_message_id: "message".into(),
+        trigger: QueueTrigger::NextTurn,
+        action: QueueAction::UiCommand {
+            draft: serde_json::json!({
+                "user_message": {
+                    "text": "Describe this",
+                    "local_images": [],
+                    "remote_image_urls": [url],
+                    "text_elements": [],
+                    "mention_bindings": []
+                },
+                "action": "Literal",
+                "pending_pastes": [],
+                "source": "Prompt",
+                "history_record": "UserMessageText"
+            }),
+        },
+        destination: QueueDestination::SourceThread,
+        state: QueueItemState::Pending,
+        revision: 0,
+        position: 0,
+        created_goal_id: None,
+        created_thread_id: None,
+    };
+    let markers =
+        crate::chatwidget::ChatWidget::remote_image_editor_markers(&item, "Describe this");
+    assert_eq!(markers.len(), 1);
+    let marker = &markers[0].1;
+    let (kept_input, kept_action) =
+        edit_queue_item_from_editor(&item, format!("Describe this\n{marker}")).unwrap();
+    assert_eq!(kept_input, item.input);
+    let Some(QueueAction::UiCommand { draft }) = kept_action else {
+        panic!("expected UI command")
+    };
+    let kept: crate::chatwidget::QueueUiDraft = serde_json::from_value(draft).unwrap();
+    assert_eq!(kept.user_message.text, "Describe this");
+    assert_eq!(kept.user_message.remote_image_urls, vec![url]);
+
+    let mut literal_item = item.clone();
+    let UserInput::Text { text, .. } = &mut literal_item.input[1] else {
+        panic!("expected prompt text")
+    };
+    *text = "Describe [Image #1] literally".into();
+    let QueueAction::UiCommand { draft } = &mut literal_item.action else {
+        panic!("expected UI command")
+    };
+    draft["user_message"]["text"] = serde_json::json!("Describe [Image #1] literally");
+    let markers = crate::chatwidget::ChatWidget::remote_image_editor_markers(
+        &literal_item,
+        "Describe [Image #1] literally",
+    );
+    assert_eq!(markers.len(), 1);
+    let (literal_input, literal_action) = edit_queue_item_from_editor(
+        &literal_item,
+        format!("Describe literally\n{}", markers[0].1),
+    )
+    .unwrap();
+    assert!(
+        literal_input
+            .iter()
+            .any(|part| matches!(part, UserInput::Image { .. }))
+    );
+    let Some(QueueAction::UiCommand { draft }) = literal_action else {
+        panic!("expected UI command")
+    };
+    let literal: crate::chatwidget::QueueUiDraft = serde_json::from_value(draft).unwrap();
+    assert_eq!(literal.user_message.remote_image_urls, vec![url]);
+    assert_eq!(literal.user_message.text, "Describe literally");
+
+    let (removed_input, removed_action) =
+        edit_queue_item_from_editor(&item, "Describe this".into()).unwrap();
+    assert!(
+        !removed_input
+            .iter()
+            .any(|part| matches!(part, UserInput::Image { .. }))
+    );
+    let Some(QueueAction::UiCommand { draft }) = removed_action else {
+        panic!("expected UI command")
+    };
+    let removed: crate::chatwidget::QueueUiDraft = serde_json::from_value(draft).unwrap();
+    assert!(removed.user_message.remote_image_urls.is_empty());
+}
