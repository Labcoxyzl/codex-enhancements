diff --git a/codex-rs/ext/queue/src/dispatch.rs b/codex-rs/ext/queue/src/dispatch.rs
new file mode 100644
index 0000000000000000000000000000000000000000..71191805515c9ef5cbe93a6f76654b8f4fd2cf76
--- /dev/null
+++ b/codex-rs/ext/queue/src/dispatch.rs
@@ -0,0 +1,692 @@
+use super::*;
+use codex_core::StartThreadOptions;
+use codex_rollout::RolloutItem;
+use codex_state::ThreadGoalStatus;
+use codex_thread_store::ListTurnsParams;
+use codex_thread_store::QueuedUserSubmissionRecord;
+use codex_thread_store::SortDirection;
+use codex_thread_store::StoredTurnItemsView;
+use codex_thread_store::StoredTurnStatus;
+
+impl QueuedItemService {
+    async fn check_dispatch(&self, thread: &CodexThread) -> Result<(), QueueServiceError> {
+        if let Some(check) = &self.dispatch_check {
+            check(thread.config().await)
+                .await
+                .map_err(QueueServiceError::DispatchDenied)?;
+        }
+        Ok(())
+    }
+
+    pub(super) async fn head_record(
+        &self,
+        thread_id: ThreadId,
+    ) -> Result<Option<(QueuedUserSubmissionRecord, Vec<QueuedItem>)>, QueueServiceError> {
+        let records = self.queue.list_page(thread_id, 0, MAX_QUEUE_ITEMS).await?;
+        let items = records
+            .iter()
+            .cloned()
+            .map(visible_item_from_record)
+            .collect::<Vec<_>>();
+        Ok(records
+            .into_iter()
+            .find(|record| {
+                items
+                    .iter()
+                    .find(|item| item.id == record.id)
+                    .is_some_and(|item| item.state != QueueItemState::Completed)
+            })
+            .map(|record| (record, items)))
+    }
+
+    pub(super) async fn persist_item(
+        &self,
+        thread_id: ThreadId,
+        record: QueuedUserSubmissionRecord,
+        mut item: QueuedItem,
+    ) -> Result<(QueuedUserSubmissionRecord, QueuedItem), QueueServiceError> {
+        item.revision += 1;
+        let payload = to_payload(&item)?;
+        let changed = self
+            .queue
+            .update_if_unchanged(thread_id, record.id, record.payload, payload)
+            .await?
+            .ok_or(QueueServiceError::RevisionConflict)?;
+        self.emit_changed(thread_id);
+        Ok((changed, item))
+    }
+
+    pub(super) async fn eligible(
+        &self,
+        source_id: ThreadId,
+        source: Option<&CodexThread>,
+        item: &QueuedItem,
+        items: &[QueuedItem],
+    ) -> Result<Eligibility, QueueServiceError> {
+        match &item.trigger {
+            QueueTrigger::NextTurn => Ok(Eligibility::Ready),
+            QueueTrigger::TurnCompleted { turn_id } => {
+                if let Some(thread_store) = &self.thread_store {
+                    let mut cursor = None;
+                    loop {
+                        let page = match thread_store
+                            .list_turns(ListTurnsParams {
+                                thread_id: source_id,
+                                include_archived: false,
+                                cursor,
+                                page_size: 100,
+                                sort_direction: SortDirection::Desc,
+                                items_view: StoredTurnItemsView::NotLoaded,
+                            })
+                            .await
+                        {
+                            Ok(page) => page,
+                            Err(ThreadStoreError::Unsupported {
+                                operation: "list_turns",
+                            }) => break,
+                            Err(
+                                ThreadStoreError::ThreadNotFound { .. }
+                                | ThreadStoreError::InvalidRequest { .. },
+                            ) => return Ok(Eligibility::Waiting),
+                            Err(error) => return Err(error.into()),
+                        };
+                        if let Some(turn) = page.turns.iter().find(|turn| turn.turn_id == *turn_id)
+                        {
+                            return Ok(
+                                if turn.status == StoredTurnStatus::Completed
+                                    && turn.error.is_none()
+                                {
+                                    Eligibility::Ready
+                                } else {
+                                    Eligibility::Waiting
+                                },
+                            );
+                        }
+                        let Some(next_cursor) = page.next_cursor else {
+                            return Ok(Eligibility::Waiting);
+                        };
+                        cursor = Some(next_cursor);
+                    }
+                }
+                let Some(source) = source else {
+                    // A cold source needs its rollout only when the turn store cannot decide.
+                    return Ok(Eligibility::Ready);
+                };
+                let history = match source.load_history(/*include_archived*/ false).await {
+                    Ok(history) => history,
+                    Err(ThreadStoreError::InvalidRequest { .. }) => {
+                        return Ok(Eligibility::Waiting);
+                    }
+                    Err(error) => return Err(error.into()),
+                };
+                Ok(
+                    if history.items.iter().any(|event| {
+                        matches!(event,
+                            RolloutItem::EventMsg(EventMsg::TurnComplete(completed))
+                                if completed.turn_id == *turn_id && completed.error.is_none()
+                        )
+                    }) {
+                        Eligibility::Ready
+                    } else {
+                        Eligibility::Waiting
+                    },
+                )
+            }
+            QueueTrigger::GoalCompleted { goal_id } => self.goal_complete(source_id, goal_id).await,
+            QueueTrigger::QueuedGoalCompleted { queued_item_id } => {
+                let Some(prior) = items.iter().find(|prior| &prior.id == queued_item_id) else {
+                    return Ok(Eligibility::Uncertain);
+                };
+                let Some(goal_id) = prior.created_goal_id.as_deref() else {
+                    return Ok(if prior.state == QueueItemState::Completed {
+                        Eligibility::Uncertain
+                    } else {
+                        Eligibility::Waiting
+                    });
+                };
+                let Some(target_id) = self.destination_id(source_id, prior, items) else {
+                    return Ok(Eligibility::Uncertain);
+                };
+                self.goal_complete(target_id, goal_id).await
+            }
+        }
+    }
+
+    async fn goal_complete(
+        &self,
+        thread_id: ThreadId,
+        goal_id: &str,
+    ) -> Result<Eligibility, QueueServiceError> {
+        let Some(state_db) = &self.state_db else {
+            return Ok(Eligibility::Waiting);
+        };
+        let goal = state_db
+            .thread_goals()
+            .get_thread_goal(thread_id)
+            .await
+            .map_err(|error| QueueServiceError::InvalidEntry(error.to_string()))?;
+        Ok(match goal {
+            Some(goal) if goal.goal_id == goal_id => {
+                if goal.status == ThreadGoalStatus::Complete {
+                    Eligibility::Ready
+                } else {
+                    Eligibility::Waiting
+                }
+            }
+            _ => Eligibility::Uncertain,
+        })
+    }
+
+    fn destination_id(
+        &self,
+        source_id: ThreadId,
+        item: &QueuedItem,
+        items: &[QueuedItem],
+    ) -> Option<ThreadId> {
+        match &item.destination {
+            QueueDestination::SourceThread => Some(source_id),
+            QueueDestination::NewThread => item
+                .created_thread_id
+                .as_deref()
+                .and_then(|id| ThreadId::from_string(id).ok()),
+            QueueDestination::CreatedThread { queued_item_id } => items
+                .iter()
+                .find(|prior| &prior.id == queued_item_id)
+                .and_then(|prior| prior.created_thread_id.as_deref())
+                .and_then(|id| ThreadId::from_string(id).ok()),
+        }
+    }
+
+    async fn finish_item(
+        &self,
+        source_id: ThreadId,
+        record: QueuedUserSubmissionRecord,
+        mut item: QueuedItem,
+    ) -> Result<(), QueueServiceError> {
+        item.state = QueueItemState::Completed;
+        self.persist_item(source_id, record, item).await?;
+        self.prune_completed(source_id).await
+    }
+
+    pub(super) async fn prune_completed(
+        &self,
+        source_id: ThreadId,
+    ) -> Result<(), QueueServiceError> {
+        let items = self.list(source_id).await?;
+        for item in &items {
+            if item.state != QueueItemState::Completed {
+                continue;
+            }
+            let referenced = items.iter().any(|later| {
+                later.state != QueueItemState::Completed
+                    && (matches!(&later.trigger,
+                        QueueTrigger::QueuedGoalCompleted { queued_item_id } if queued_item_id == &item.id)
+                        || matches!(&later.destination,
+                            QueueDestination::CreatedThread { queued_item_id } if queued_item_id == &item.id))
+            });
+            if !referenced && self.queue.delete(source_id, item.id.clone()).await? {
+                self.emit_changed(source_id);
+            }
+        }
+        Ok(())
+    }
+
+    pub(super) async fn start_head(
+        &self,
+        thread: &CodexThread,
+        requested_id: Option<&str>,
+        trace: Option<W3cTraceContext>,
+    ) -> Result<StartIfIdleSubmission, QueueServiceError> {
+        let source_id = thread.startup_metadata().thread_id;
+        if matches!(
+            thread.agent_status().await,
+            AgentStatus::Interrupted
+                | AgentStatus::Errored(_)
+                | AgentStatus::Shutdown
+                | AgentStatus::NotFound
+        ) {
+            return Err(QueueServiceError::InvalidEntry(
+                "queued entry is waiting for a completed turn".to_string(),
+            ));
+        }
+        let (record, items) = self
+            .head_record(source_id)
+            .await?
+            .ok_or_else(|| QueueServiceError::InvalidEntry("queue is empty".to_string()))?;
+        let item = from_record(record.clone())?;
+        if requested_id.is_some_and(|id| id != item.id) {
+            return Err(QueueServiceError::InvalidEntry(
+                "only the head of the queue can start".to_string(),
+            ));
+        }
+        if item.state != QueueItemState::Pending
+            || item.action != QueueAction::Prompt
+            || item.destination != QueueDestination::SourceThread
+        {
+            return Err(QueueServiceError::InvalidEntry(
+                "queued entry is waiting for its trigger or action handler".to_string(),
+            ));
+        }
+        match self
+            .eligible(source_id, Some(thread), &item, &items)
+            .await?
+        {
+            Eligibility::Ready => {}
+            Eligibility::Waiting => {
+                return Err(QueueServiceError::InvalidEntry(
+                    "queued entry is waiting for its trigger or action handler".to_string(),
+                ));
+            }
+            Eligibility::Uncertain => {
+                let mut item = item;
+                item.state = QueueItemState::Uncertain;
+                self.persist_item(source_id, record, item).await?;
+                return Err(QueueServiceError::InvalidEntry(
+                    "queued entry's goal changed; review the queue".to_string(),
+                ));
+            }
+        }
+        self.check_dispatch(thread).await?;
+        self.start_prompt(source_id, record, item, thread, trace)
+            .await
+    }
+
+    async fn start_prompt(
+        &self,
+        source_id: ThreadId,
+        record: QueuedUserSubmissionRecord,
+        mut item: QueuedItem,
+        target: &CodexThread,
+        trace: Option<W3cTraceContext>,
+    ) -> Result<StartIfIdleSubmission, QueueServiceError> {
+        let input = item.input.clone();
+        item.state = QueueItemState::Dispatching;
+        let (record, mut item) = self.persist_item(source_id, record, item).await?;
+        let submission = target
+            .start_turn_if_idle(TurnInputRequest::new(input).with_trace(trace).on_start(
+                TurnStartOptions {
+                    turn_trigger: Some("queue".to_string()),
+                    ..Default::default()
+                },
+            ))
+            .await;
+        match submission {
+            Ok(started @ StartIfIdleSubmission::Started { .. }) => {
+                self.finish_item(source_id, record, item).await?;
+                Ok(started)
+            }
+            Ok(not_submitted @ StartIfIdleSubmission::NotSubmitted { .. }) => {
+                item.state = if item.destination == QueueDestination::NewThread {
+                    QueueItemState::Uncertain
+                } else {
+                    QueueItemState::Pending
+                };
+                self.persist_item(source_id, record, item).await?;
+                Ok(not_submitted)
+            }
+            Err(error) => {
+                item.state = QueueItemState::Uncertain;
+                self.persist_item(source_id, record, item).await?;
+                Err(error.into())
+            }
+        }
+    }
+
+    pub(super) async fn dispatch_ready_head(
+        &self,
+        source_id: ThreadId,
+    ) -> Result<(), QueueServiceError> {
+        while self.dispatch_one(source_id).await? {}
+        Ok(())
+    }
+
+    async fn dispatch_one(&self, source_id: ThreadId) -> Result<bool, QueueServiceError> {
+        let Some(manager) = self.thread_manager.upgrade() else {
+            return Ok(false);
+        };
+        let Ok(source) = manager.get_thread(source_id).await else {
+            return Ok(false);
+        };
+        let Some((record, items)) = self.head_record(source_id).await? else {
+            return Ok(false);
+        };
+        let item = match from_record(record.clone()) {
+            Ok(item) => item,
+            Err(error) => {
+                tracing::warn!(item_id = %record.id, %error, "invalid queued item blocks the queue");
+                return Ok(false);
+            }
+        };
+        if item.state == QueueItemState::Dispatching {
+            let mut uncertain = item;
+            uncertain.state = QueueItemState::Uncertain;
+            self.persist_item(source_id, record, uncertain).await?;
+            return Ok(false);
+        }
+        if matches!(
+            source.agent_status().await,
+            AgentStatus::Running
+                | AgentStatus::Interrupted
+                | AgentStatus::Errored(_)
+                | AgentStatus::Shutdown
+                | AgentStatus::NotFound
+        ) {
+            return Ok(false);
+        }
+        if item.state != QueueItemState::Pending {
+            return Ok(false);
+        }
+        match self
+            .eligible(source_id, Some(&source), &item, &items)
+            .await?
+        {
+            Eligibility::Ready => {}
+            Eligibility::Waiting => return Ok(false),
+            Eligibility::Uncertain => {
+                let mut item = item;
+                item.state = QueueItemState::Uncertain;
+                self.persist_item(source_id, record, item).await?;
+                return Ok(false);
+            }
+        }
+        if matches!(item.action, QueueAction::UiCommand { .. }) {
+            return Ok(false);
+        }
+
+        self.check_dispatch(&source).await?;
+
+        let mut target_hold = None;
+        let (record, mut item, target) = if item.destination == QueueDestination::NewThread
+            && item.created_thread_id.is_none()
+        {
+            let snapshot = source.config_snapshot().await;
+            let settings = source.restorable_thread_settings().await;
+            let reserved_id = manager.reserve_thread_id();
+            let mut item = item;
+            item.created_thread_id = Some(reserved_id.to_string());
+            item.state = QueueItemState::Dispatching;
+            let (record, mut item) = self.persist_item(source_id, record, item).await?;
+            let mut options = StartThreadOptions::new(source.config().await.as_ref().clone());
+            options.reserved_thread_id = Some(reserved_id);
+            options.history_mode = Some(snapshot.history_mode);
+            options.session_source = Some(snapshot.session_source);
+            options.thread_source = snapshot.thread_source;
+            options.disabled_plugin_ids = Some(snapshot.disabled_plugin_ids);
+            options.environments = settings
+                .environments
+                .as_ref()
+                .map(|requests| requests.environment_requests.clone());
+            match manager.start_thread(options).await {
+                Ok(new_thread) => {
+                    let restore = async {
+                        new_thread
+                            .thread
+                            .restore_thread_settings(settings)
+                            .await
+                            .map_err(|error| {
+                                QueueServiceError::InvalidEntry(format!(
+                                    "fresh thread settings could not be restored: {error}"
+                                ))
+                            })?;
+                        new_thread.thread.checkpoint_thread_settings().await?;
+                        Ok::<_, QueueServiceError>(())
+                    }
+                    .await;
+                    if let Err(error) = restore {
+                        item.state = QueueItemState::Uncertain;
+                        self.persist_item(source_id, record, item).await?;
+                        return Err(error);
+                    }
+                    let loader = self
+                        .target_loader
+                        .lock()
+                        .unwrap_or_else(std::sync::PoisonError::into_inner)
+                        .clone();
+                    let target = if let Some(loader) = loader {
+                        let loaded = match loader(reserved_id).await {
+                            Ok(loaded) => loaded,
+                            Err(error) => {
+                                item.state = QueueItemState::Uncertain;
+                                self.persist_item(source_id, record, item).await?;
+                                return Err(QueueServiceError::InvalidEntry(format!(
+                                    "fresh thread listener could not be attached: {error}"
+                                )));
+                            }
+                        };
+                        if loaded.thread.startup_metadata().thread_id != reserved_id {
+                            item.state = QueueItemState::Uncertain;
+                            self.persist_item(source_id, record, item).await?;
+                            return Err(QueueServiceError::InvalidEntry(
+                                "fresh thread listener returned a different thread".to_string(),
+                            ));
+                        }
+                        let thread = Arc::clone(&loaded.thread);
+                        target_hold = Some(loaded);
+                        thread
+                    } else {
+                        new_thread.thread
+                    };
+                    (record, item, target)
+                }
+                Err(error) => {
+                    item.state = QueueItemState::Uncertain;
+                    self.persist_item(source_id, record, item).await?;
+                    return Err(error.into());
+                }
+            }
+        } else {
+            let Some(target_id) = self.destination_id(source_id, &item, &items) else {
+                return Ok(false);
+            };
+            let target = if matches!(item.destination, QueueDestination::CreatedThread { .. }) {
+                let loader = self
+                    .target_loader
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                    .clone();
+                if let Some(loader) = loader {
+                    let loaded = match loader(target_id).await {
+                        Ok(loaded) => loaded,
+                        Err(error) => {
+                            tracing::warn!(%target_id, %error, "could not retain created queue target");
+                            return Ok(false);
+                        }
+                    };
+                    if loaded.thread.startup_metadata().thread_id != target_id {
+                        tracing::warn!(%target_id, "created queue target loader returned a different thread");
+                        return Ok(false);
+                    }
+                    let thread = Arc::clone(&loaded.thread);
+                    target_hold = Some(loaded);
+                    thread
+                } else {
+                    let Ok(target) = manager.get_thread(target_id).await else {
+                        tracing::debug!(%target_id, "created queue target is unloaded and has no loader");
+                        return Ok(false);
+                    };
+                    target
+                }
+            } else {
+                let Ok(target) = manager.get_thread(target_id).await else {
+                    return Ok(false);
+                };
+                target
+            };
+            (record, item, target)
+        };
+
+        if let Err(error) = self.check_dispatch(&target).await {
+            if item.state == QueueItemState::Dispatching {
+                item.state = QueueItemState::Uncertain;
+                self.persist_item(source_id, record, item).await?;
+            }
+            return Err(error);
+        }
+        if matches!(
+            target.agent_status().await,
+            AgentStatus::Running
+                | AgentStatus::Interrupted
+                | AgentStatus::Errored(_)
+                | AgentStatus::Shutdown
+                | AgentStatus::NotFound
+        ) {
+            return Ok(false);
+        }
+
+        let outcome = match &item.action {
+            QueueAction::Prompt => {
+                let submission = self
+                    .start_prompt(source_id, record, item, &target, /*trace*/ None)
+                    .await?;
+                if let StartIfIdleSubmission::NotSubmitted { reason } = submission {
+                    tracing::debug!(%source_id, ?reason, "queued prompt is waiting for target thread");
+                }
+                Ok(false)
+            }
+            QueueAction::Goal { objective } => {
+                let objective = objective.clone();
+                if let QueueTrigger::QueuedGoalCompleted { queued_item_id } = &item.trigger
+                    && let Some(prior) = items.iter().find(|prior| &prior.id == queued_item_id)
+                    && self.destination_id(source_id, prior, &items)
+                        == Some(target.startup_metadata().thread_id)
+                {
+                    item.expected_goal_id = prior.created_goal_id.clone();
+                }
+                if item.state == QueueItemState::Pending {
+                    item.state = QueueItemState::Dispatching;
+                    let (next_record, next_item) =
+                        self.persist_item(source_id, record, item).await?;
+                    self.dispatch_goal(source_id, next_record, next_item, &target, &objective)
+                        .await?;
+                } else {
+                    self.dispatch_goal(source_id, record, item, &target, &objective)
+                        .await?;
+                }
+                Ok(true)
+            }
+            QueueAction::UiCommand { .. } => Ok(false),
+        };
+        drop(target_hold);
+        outcome
+    }
+
+    async fn dispatch_goal(
+        &self,
+        source_id: ThreadId,
+        record: QueuedUserSubmissionRecord,
+        mut item: QueuedItem,
+        target: &CodexThread,
+        objective: &str,
+    ) -> Result<(), QueueServiceError> {
+        let target_id = target.startup_metadata().thread_id;
+        let Some(goal_service) = &self.goal_service else {
+            return Err(QueueServiceError::InvalidEntry(
+                "goal service is unavailable".to_string(),
+            ));
+        };
+        let Some(state_db) = &self.state_db else {
+            return Err(QueueServiceError::InvalidEntry(
+                "goal storage is unavailable".to_string(),
+            ));
+        };
+        let result = goal_service
+            .replace_queued_goal(
+                state_db,
+                target_id,
+                objective,
+                item.expected_goal_id.as_deref(),
+                target.config().await.max_goal_token_budget,
+            )
+            .await;
+        let outcome = match result {
+            Ok(outcome) => outcome,
+            Err(error) => {
+                item.state = QueueItemState::Uncertain;
+                self.persist_item(source_id, record, item).await?;
+                return Err(QueueServiceError::InvalidEntry(error.to_string()));
+            }
+        };
+        item.created_goal_id = Some(outcome.goal_id().to_string());
+        let (record, item) = self.persist_item(source_id, record, item).await?;
+        if let Err(error) = target
+            .append_rollout_items(&[outcome.thread_goal_updated_item()])
+            .await
+        {
+            tracing::warn!(%target_id, %error, "failed to append queued goal update");
+        }
+        self.finish_item(source_id, record, item).await?;
+        outcome.apply_runtime_effects(goal_service).await;
+        Ok(())
+    }
+
+    pub async fn claim_ui(
+        &self,
+        thread: &CodexThread,
+    ) -> Result<Option<QueuedItem>, QueueServiceError> {
+        let source_id = thread.startup_metadata().thread_id;
+        let _guard = self.dispatch_guard(source_id).await;
+        if matches!(
+            thread.agent_status().await,
+            AgentStatus::Running
+                | AgentStatus::Interrupted
+                | AgentStatus::Errored(_)
+                | AgentStatus::Shutdown
+                | AgentStatus::NotFound
+        ) {
+            return Ok(None);
+        }
+        let Some((record, items)) = self.head_record(source_id).await? else {
+            return Ok(None);
+        };
+        let item = from_record(record.clone())?;
+        if item.state != QueueItemState::Pending
+            || !matches!(item.action, QueueAction::UiCommand { .. })
+            || item.destination != QueueDestination::SourceThread
+        {
+            return Ok(None);
+        }
+        match self
+            .eligible(source_id, Some(thread), &item, &items)
+            .await?
+        {
+            Eligibility::Ready => {}
+            Eligibility::Waiting => return Ok(None),
+            Eligibility::Uncertain => {
+                let mut item = item;
+                item.state = QueueItemState::Uncertain;
+                self.persist_item(source_id, record, item).await?;
+                return Ok(None);
+            }
+        }
+        let mut item = item;
+        item.state = QueueItemState::AwaitingUi;
+        let (_, item) = self.persist_item(source_id, record, item).await?;
+        Ok(Some(item))
+    }
+
+    pub async fn ack_ui(
+        &self,
+        source_id: ThreadId,
+        queued_item_id: &str,
+        revision: u64,
+    ) -> Result<(), QueueServiceError> {
+        {
+            let _guard = self.dispatch_guard(source_id).await;
+            let Some((record, _)) = self.head_record(source_id).await? else {
+                return Err(QueueServiceError::InvalidEntry(
+                    "queue is empty".to_string(),
+                ));
+            };
+            let item = from_record(record.clone())?;
+            if item.id != queued_item_id
+                || item.revision != revision
+                || item.state != QueueItemState::AwaitingUi
+            {
+                return Err(QueueServiceError::RevisionConflict);
+            }
+            self.finish_item(source_id, record, item).await?;
+        }
+        self.wake_if_loaded(source_id).await;
+        Ok(())
+    }
+}
