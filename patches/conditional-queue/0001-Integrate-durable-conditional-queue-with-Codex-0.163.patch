+//! Reconcile Tab queue adds against durable receipts and retain unresolved drafts.
+
+use super::App;
+use super::TypedRequestError;
+use crate::app_server_session::AppServerSession;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::ThreadQueueAddParams;
+use codex_app_server_protocol::ThreadQueueAddResponse;
+use codex_app_server_protocol::ThreadQueueListParams;
+use codex_app_server_protocol::ThreadQueueListResponse;
+use codex_protocol::ThreadId;
+
+fn definite_queue_add_rejection(error: &TypedRequestError) -> bool {
+    let TypedRequestError::Server { source, .. } = error else {
+        return false;
+    };
+    // These are checked before enqueue. Other server errors can occur after the row is saved.
+    source.code == -32600
+        && (source
+            .message
+            .starts_with("remote image URLs are not supported")
+            || source.message.starts_with("invalid thread id:")
+            || source.message.starts_with("thread not found:")
+            || source
+                .message
+                .starts_with("ephemeral thread does not support queued submissions:")
+            || (source.message.starts_with("session ") && source.message.contains(" is archived."))
+            || source.message == "user message queue is unavailable")
+}
+
+impl App {
+    pub(super) async fn add_service_queue_submission(
+        &mut self,
+        app_server: &mut AppServerSession,
+        submission: crate::chatwidget::QueueTabSubmission,
+    ) {
+        let thread_id = submission.thread_id;
+        let client_id = submission.client_user_message_id.clone();
+        let request_id = app_server.next_request_id();
+        let result: Result<ThreadQueueAddResponse, _> = app_server
+            .request_handle()
+            .request_typed(ClientRequest::ThreadQueueAdd {
+                request_id,
+                params: ThreadQueueAddParams {
+                    thread_id: thread_id.to_string(),
+                    input: submission.input,
+                    client_user_message_id: client_id.clone(),
+                    trigger: None,
+                    action: Some(submission.action),
+                    destination: None,
+                },
+            })
+            .await;
+        match result {
+            Ok(response) if response.queued_submission.client_user_message_id == client_id => {
+                self.confirm_service_queue_add(thread_id, &client_id).await;
+                self.refresh_service_queue(app_server, thread_id, false)
+                    .await;
+                self.claim_service_queue_ui(app_server, thread_id).await;
+            }
+            Err(error) if definite_queue_add_rejection(&error) => {
+                self.reject_service_queue_add(thread_id, &client_id, submission.draft)
+                    .await;
+                self.chat_widget.add_error_message(format!(
+                    "Queue add was rejected: {error}. The draft is still available."
+                ));
+            }
+            _ => {
+                if self
+                    .service_queue_add_is_confirmed(app_server, thread_id, &client_id)
+                    .await
+                {
+                    self.confirm_service_queue_add(thread_id, &client_id).await;
+                    self.refresh_service_queue(app_server, thread_id, false)
+                        .await;
+                    self.claim_service_queue_ui(app_server, thread_id).await;
+                } else {
+                    self.chat_widget.add_info_message(
+                        if self.chat_widget.thread_id() == Some(thread_id) {
+                            "Could not confirm the queued draft. It remains available and has not been resent. Check the queue and thread history; do not retry until delivery is resolved.".into()
+                        } else {
+                            "Could not confirm a queued draft in another conversation. It remains there and has not been resent. Do not retry until delivery is resolved.".into()
+                        },
+                        None,
+                    );
+                }
+            }
+        }
+    }
+
+    pub(super) async fn confirm_service_queue_add(&mut self, thread_id: ThreadId, client_id: &str) {
+        if self.chat_widget.thread_id() == Some(thread_id) {
+            self.chat_widget.confirm_service_queue_submission(client_id);
+        }
+        if let Some(state) = self.agents_overview.input_states.get_mut(&thread_id) {
+            state.confirm_service_queue_submission(client_id);
+        }
+        if let Some(channel) = self.thread_event_channels.get(&thread_id)
+            && let Some(state) = channel.store.lock().await.input_state.as_mut()
+        {
+            state.confirm_service_queue_submission(client_id);
+        }
+        self.clear_service_queue_add_journal(thread_id, client_id);
+    }
+
+    async fn reject_service_queue_add(
+        &mut self,
+        thread_id: ThreadId,
+        client_id: &str,
+        draft: crate::chatwidget::QueueUiDraft,
+    ) {
+        if self.chat_widget.thread_id() == Some(thread_id) {
+            self.chat_widget
+                .reject_service_queue_submission(client_id, draft);
+        }
+        if let Some(state) = self.agents_overview.input_states.get_mut(&thread_id) {
+            state.reject_service_queue_submission(client_id);
+        }
+        if let Some(channel) = self.thread_event_channels.get(&thread_id)
+            && let Some(state) = channel.store.lock().await.input_state.as_mut()
+        {
+            state.reject_service_queue_submission(client_id);
+        }
+        self.clear_service_queue_add_journal(thread_id, client_id);
+    }
+
+    pub(super) async fn discard_local_queue_add(&mut self, thread_id: ThreadId, client_id: &str) {
+        if self.chat_widget.thread_id() == Some(thread_id) {
+            self.chat_widget.discard_service_queue_submission(client_id);
+        }
+        if let Some(state) = self.agents_overview.input_states.get_mut(&thread_id) {
+            state.discard_service_queue_submission(client_id);
+        }
+        if let Some(channel) = self.thread_event_channels.get(&thread_id)
+            && let Some(state) = channel.store.lock().await.input_state.as_mut()
+        {
+            state.discard_service_queue_submission(client_id);
+        }
+    }
+
+    fn clear_service_queue_add_journal(&mut self, thread_id: ThreadId, client_id: &str) {
+        if crate::queue_add_journal::remove(
+            self.local_settings.codex_home.as_path(),
+            thread_id,
+            client_id,
+        )
+        .is_err()
+        {
+            self.chat_widget.add_error_message(
+                "Could not clear the local queue recovery copy. This draft may reappear after restart."
+                    .into(),
+            );
+        }
+    }
+
+    pub(super) fn has_local_queue_add(&self, client_id: &str) -> bool {
+        self.chat_widget
+            .unconfirmed_service_queue_drafts()
+            .iter()
+            .any(|(id, _)| id == client_id)
+    }
+
+    pub(super) async fn service_queue_add_is_confirmed(
+        &mut self,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+        client_id: &str,
+    ) -> bool {
+        let mut cursor = None;
+        loop {
+            let request_id = app_server.next_request_id();
+            let page: Result<ThreadQueueListResponse, _> = app_server
+                .request_handle()
+                .request_typed(ClientRequest::ThreadQueueList {
+                    request_id,
+                    params: ThreadQueueListParams {
+                        thread_id: thread_id.to_string(),
+                        cursor,
+                        limit: Some(200),
+                    },
+                })
+                .await;
+            let Ok(page) = page else {
+                break;
+            };
+            if page
+                .data
+                .iter()
+                .any(|item| item.client_user_message_id == client_id)
+            {
+                return true;
+            }
+            let Some(next) = page.next_cursor else {
+                break;
+            };
+            cursor = Some(next);
+        }
+        // A NextTurn prompt may have started and its completed queue row may already be pruned.
+        app_server
+            .thread_read(thread_id, /*include_turns*/ true)
+            .await
+            .is_ok_and(|thread| {
+                thread.turns.iter().any(|turn| {
+                    turn.items.iter().any(|item| {
+                        matches!(item, codex_app_server_protocol::ThreadItem::UserMessage {
+                            client_id: Some(id), ..
+                        } if id == client_id)
+                    })
+                })
+            })
+    }
+}
