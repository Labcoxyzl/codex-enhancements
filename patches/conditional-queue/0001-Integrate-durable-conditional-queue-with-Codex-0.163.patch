+async fn set_goal(
+    app: &mut TestAppServer,
+    thread_id: &str,
+    status: &str,
+) -> Result<ThreadGoalSetResponse> {
+    let request_id = app
+        .send_raw_request(
+            "thread/goal/set",
+            Some(json!({
