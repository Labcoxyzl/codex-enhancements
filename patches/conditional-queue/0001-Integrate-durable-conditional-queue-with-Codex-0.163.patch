+#[test]
+fn local_recovery_actions_use_client_id_and_never_issue_service_mutations() {
+    let (mut view, mut rx) = view(vec![local_item("client-123", "A possible prompt")]);
+    for key in [
+        KeyCode::Char('e').into(),
+        KeyCode::Char('t').into(),
+        KeyCode::Char('a').into(),
+        KeyCode::Char('n').into(),
+        KeyEvent::new(KeyCode::Up, KeyModifiers::CONTROL),
+        KeyEvent::new(KeyCode::Down, KeyModifiers::CONTROL),
