+
+#[test]
+fn queue_variant_ids_use_camel_case_on_the_wire() {
+    for (trigger, expected) in [
+        (
+            QueueTrigger::TurnCompleted {
+                turn_id: "turn-1".to_string(),
+            },
+            json!({"type": "turnCompleted", "turnId": "turn-1"}),
+        ),
+        (
+            QueueTrigger::GoalCompleted {
+                goal_id: "goal-1".to_string(),
+            },
+            json!({"type": "goalCompleted", "goalId": "goal-1"}),
+        ),
+        (
+            QueueTrigger::QueuedGoalCompleted {
+                queued_item_id: "item-1".to_string(),
+            },
+            json!({"type": "queuedGoalCompleted", "queuedItemId": "item-1"}),
+        ),
+    ] {
+        assert_eq!(
+            serde_json::to_value(&trigger).expect("serialize trigger"),
+            expected
+        );
+        assert_eq!(
+            serde_json::from_value::<QueueTrigger>(expected).expect("deserialize trigger"),
+            trigger
+        );
+    }
+
+    let destination = QueueDestination::CreatedThread {
+        queued_item_id: "item-1".to_string(),
+    };
+    let expected = json!({"type": "createdThread", "queuedItemId": "item-1"});
+    assert_eq!(
+        serde_json::to_value(&destination).expect("serialize destination"),
+        expected
+    );
+    assert_eq!(
+        serde_json::from_value::<QueueDestination>(expected).expect("deserialize destination"),
+        destination
+    );
+}
