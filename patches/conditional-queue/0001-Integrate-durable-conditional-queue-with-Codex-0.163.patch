new file mode 100644
index 0000000000000000000000000000000000000000..90cde6a08545d2e5ac49dd7233207732811503e3
--- /dev/null
+++ b/codex-rs/tui/src/queue_add_journal.rs
@@ -0,0 +1,309 @@
+//! Durable handoff for Tab submissions before the app server acknowledges an add.
+
+use crate::chatwidget::QueueTabSubmission;
+use codex_protocol::ThreadId;
+use std::fs;
+#[cfg(unix)]
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use uuid::Uuid;
+
+fn thread_dir(codex_home: &Path, thread_id: ThreadId) -> PathBuf {
+    codex_home
+        .join("queue-add-journal")
+        .join(thread_id.to_string())
+}
+
+fn record_name(client_id: &str) -> io::Result<String> {
+    if client_id.is_empty() || client_id.len() > 128 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid queued submission client ID length",
+        ));
+    }
+    let mut name = String::with_capacity(client_id.len() * 2 + 5);
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    for byte in client_id.bytes() {
+        name.push(char::from(HEX[(byte >> 4) as usize]));
+        name.push(char::from(HEX[(byte & 0x0f) as usize]));
+    }
+    name.push_str(".json");
+    Ok(name)
+}
+
+fn record_path(codex_home: &Path, thread_id: ThreadId, client_id: &str) -> io::Result<PathBuf> {
+    Ok(thread_dir(codex_home, thread_id).join(record_name(client_id)?))
+}
+
+fn private_directory(path: &Path) -> io::Result<()> {
+    fs::create_dir_all(path)?;
+    if !fs::symlink_metadata(path)?.file_type().is_dir() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "queued submission journal directory is not a real directory",
+        ));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        fs::set_permissions(path, fs::Permissions::from_mode(0o700))?;
+    }
+    sync_directory(path)?;
+    if let Some(parent) = path.parent() {
+        sync_directory(parent)?;
+    }
+    Ok(())
+}
+
+fn sync_directory(path: &Path) -> io::Result<()> {
+    #[cfg(unix)]
+    File::open(path)?.sync_all()?;
+    #[cfg(not(unix))]
+    let _ = path;
+    Ok(())
+}
+
+/// Persist the exact request before the composer treats it as queued.
+pub(crate) fn stage(codex_home: &Path, submission: &QueueTabSubmission) -> io::Result<()> {
+    let dir = thread_dir(codex_home, submission.thread_id);
+    private_directory(&codex_home.join("queue-add-journal"))?;
+    private_directory(&dir)?;
+    let final_path = record_path(
+        codex_home,
+        submission.thread_id,
+        &submission.client_user_message_id,
+    )?;
+    if final_path.exists() {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "queued submission is already staged",
+        ));
+    }
+    let temp_path = dir.join(format!(".{}.tmp", Uuid::now_v7()));
+    let result = (|| {
+        let mut options = OpenOptions::new();
+        options.write(true).create_new(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let mut file = options.open(&temp_path)?;
+        serde_json::to_writer(&mut file, submission).map_err(io::Error::other)?;
+        file.flush()?;
+        file.sync_all()?;
+        drop(file);
+        fs::rename(&temp_path, &final_path)?;
+        if let Err(error) = sync_directory(&dir) {
+            let _ = fs::remove_file(&final_path);
+            let _ = sync_directory(&dir);
+            return Err(error);
+        }
+        Ok(())
+    })();
+    if result.is_err() {
+        let _ = fs::remove_file(&temp_path);
+    }
+    result
+}
+
+/// Read unresolved adds. A damaged record is an error, never a reason to resend others.
+pub(crate) fn load_for_thread(
+    codex_home: &Path,
+    thread_id: ThreadId,
+) -> io::Result<Vec<QueueTabSubmission>> {
+    let dir = thread_dir(codex_home, thread_id);
+    for directory in [codex_home.join("queue-add-journal"), dir.clone()] {
+        match fs::symlink_metadata(&directory) {
+            Ok(metadata) if metadata.file_type().is_dir() => {}
+            Ok(_) => {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "queued submission journal directory is not a real directory",
+                ));
+            }
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(Vec::new()),
+            Err(error) => return Err(error),
+        }
+    }
+    let entries = match fs::read_dir(&dir) {
+        Ok(entries) => entries,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(error) => return Err(error),
+    };
+    let mut submissions = Vec::new();
+    for entry in entries {
+        let entry = entry?;
+        let path = entry.path();
+        if path.extension().is_none_or(|extension| extension != "json") {
+            continue;
+        }
+        if !entry.file_type()?.is_file() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "queued submission journal entry is not a regular file",
+            ));
+        }
+        let submission: QueueTabSubmission =
+            serde_json::from_slice(&fs::read(&path)?).map_err(io::Error::other)?;
+        let expected_path = record_path(
+            codex_home,
+            submission.thread_id,
+            &submission.client_user_message_id,
+        )?;
+        if submission.thread_id != thread_id || path != expected_path {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "queued submission journal entry has a mismatched ID",
+            ));
+        }
+        submissions.push(submission);
+    }
+    submissions.sort_by(|a, b| a.client_user_message_id.cmp(&b.client_user_message_id));
+    Ok(submissions)
+}
+
+/// Forget one add only after an exact confirmation or definite rejection.
+pub(crate) fn remove(codex_home: &Path, thread_id: ThreadId, client_id: &str) -> io::Result<()> {
+    let path = record_path(codex_home, thread_id, client_id)?;
+    match fs::remove_file(&path) {
+        Ok(()) => sync_directory(&thread_dir(codex_home, thread_id)),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(error) => Err(error),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::chatwidget::QueueUiDraft;
+    use codex_app_server_protocol::QueueAction;
+    use codex_app_server_protocol::UserInput;
+    use serde_json::json;
+
+    fn submission(thread_id: ThreadId, client_id: &str) -> QueueTabSubmission {
+        let draft: QueueUiDraft = serde_json::from_value(json!({
+            "user_message": {
+                "text": "describe this image",
+                "local_images": [],
+                "remote_image_urls": ["data:image/png;base64,secret"],
+                "text_elements": [],
+                "mention_bindings": []
+            },
+            "action": "Plain",
+            "pending_pastes": [],
+            "source": "Prompt",
+            "history_record": "UserMessageText"
+        }))
+        .unwrap();
+        QueueTabSubmission {
+            thread_id,
+            input: vec![UserInput::Text {
+                text: "describe this image".into(),
+                text_elements: Vec::new(),
+            }],
+            action: QueueAction::Prompt,
+            client_user_message_id: client_id.into(),
+            draft,
+        }
+    }
+
+    #[test]
+    fn staged_add_survives_restart_and_removes_only_its_client_id() {
+        assert_eq!(record_name("first").unwrap(), "6669727374.json");
+        assert_eq!(record_name("a/b").unwrap(), "612f62.json");
+        let home = tempfile::tempdir().unwrap();
+        let thread_id = ThreadId::new();
+        let first = submission(thread_id, "first");
+        let second = submission(thread_id, "second");
+        let other_thread = ThreadId::new();
+        stage(home.path(), &first).unwrap();
+        stage(home.path(), &second).unwrap();
+        stage(home.path(), &submission(other_thread, "other")).unwrap();
+
+        let mut after_restart = load_for_thread(home.path(), thread_id).unwrap();
+        assert_eq!(after_restart.len(), 2);
+        assert_eq!(load_for_thread(home.path(), other_thread).unwrap().len(), 1);
+        assert!(
+            load_for_thread(home.path(), ThreadId::new())
+                .unwrap()
+                .is_empty()
+        );
+        assert_eq!(after_restart.remove(0).draft, first.draft);
+        assert_eq!(after_restart.remove(0).draft, second.draft);
+        assert_eq!(
+            stage(home.path(), &first).unwrap_err().kind(),
+            io::ErrorKind::AlreadyExists
+        );
+        remove(home.path(), thread_id, "first").unwrap();
+        remove(home.path(), thread_id, "first").unwrap();
+        let unresolved = load_for_thread(home.path(), thread_id).unwrap();
+        assert_eq!(unresolved.len(), 1);
+        assert_eq!(unresolved[0].client_user_message_id, "second");
+    }
+
+    #[test]
+    fn damaged_entry_fails_closed_and_incomplete_temp_is_not_an_add() {
+        let home = tempfile::tempdir().unwrap();
+        let thread_id = ThreadId::new();
+        stage(home.path(), &submission(thread_id, "first")).unwrap();
+        let dir = thread_dir(home.path(), thread_id);
+        fs::write(dir.join(".unfinished.tmp"), b"partial secret").unwrap();
+        assert_eq!(load_for_thread(home.path(), thread_id).unwrap().len(), 1);
+        fs::write(dir.join("damaged.json"), b"{").unwrap();
+        assert_eq!(
+            load_for_thread(home.path(), thread_id).unwrap_err().kind(),
+            io::ErrorKind::Other
+        );
+        assert_eq!(fs::read_dir(dir).unwrap().count(), 3);
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn staged_add_and_directories_are_private() {
+        use std::os::unix::fs::PermissionsExt;
+
+        let home = tempfile::tempdir().unwrap();
+        let thread_id = ThreadId::new();
+        stage(home.path(), &submission(thread_id, "first")).unwrap();
+        let root = home.path().join("queue-add-journal");
+        let dir = thread_dir(home.path(), thread_id);
+        let file = record_path(home.path(), thread_id, "first").unwrap();
+        for directory in [&root, &dir] {
+            assert_eq!(
+                fs::metadata(directory).unwrap().permissions().mode() & 0o777,
+                0o700
+            );
+        }
+        assert_eq!(
+            fs::metadata(file).unwrap().permissions().mode() & 0o777,
+            0o600
+        );
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn symlinked_journal_directory_cannot_receive_or_load_drafts() {
+        use std::os::unix::fs::symlink;
+
+        let home = tempfile::tempdir().unwrap();
+        let outside = tempfile::tempdir().unwrap();
+        symlink(outside.path(), home.path().join("queue-add-journal")).unwrap();
+        let thread_id = ThreadId::new();
+        assert_eq!(
+            stage(home.path(), &submission(thread_id, "first"))
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::InvalidData
+        );
+        assert_eq!(
+            load_for_thread(home.path(), thread_id).unwrap_err().kind(),
+            io::ErrorKind::InvalidData
+        );
+        assert!(fs::read_dir(outside.path()).unwrap().next().is_none());
+    }
+}
