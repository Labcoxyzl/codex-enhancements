+            destination: QueueDestination::SourceThread,
+            state: QueueItemState::Uncertain,
+            revision: 0,
+            expected_goal_id: None,
+            created_goal_id: None,
+            created_thread_id: None,
+        },
+    }
+}
+
+pub(crate) fn to_payload(item: &QueuedItem) -> serde_json::Result<String> {
+    serde_json::to_string(&ManagedPayload {
+        version: 1,
+        input: item.input.clone(),
+        trigger: item.trigger.clone(),
+        action: item.action.clone(),
+        destination: item.destination.clone(),
+        state: item.state.clone(),
+        revision: item.revision,
+        expected_goal_id: item.expected_goal_id.clone(),
+        created_goal_id: item.created_goal_id.clone(),
+        created_thread_id: item.created_thread_id.clone(),
+    })
+}
