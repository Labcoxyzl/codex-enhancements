                 .agents_overview
@@ -580,4 +574,27 @@ impl App {
         }
         Ok(())
     }
+
+    pub(super) fn rotate_app_event_receiver(
+        &mut self,
+        app_event_rx: &mut mpsc::UnboundedReceiver<AppEvent>,
+    ) {
+        // Old request handles stay attached to the dead connection. A Tab event still in this
+        // receiver has never issued an add request, so preserve it with its original client ID.
+        let mut unsent_queue_adds = Vec::new();
+        while let Ok(event) = app_event_rx.try_recv() {
+            if let AppEvent::QueueTabSubmission(submission) = event {
+                unsent_queue_adds.push(submission);
+            }
+        }
+        let (tx, rx) = mpsc::unbounded_channel();
+        self.app_event_tx = AppEventSender::new(tx);
+        *app_event_rx = rx;
+        for submission in unsent_queue_adds {
+            self.app_event_tx
+                .send(AppEvent::QueueTabSubmission(submission));
+        }
+        // The old timer targets the discarded channel, so a new preview can be scheduled.
+        self.config_notification_test_pending = None;
+    }
 }
