+#[tokio::test]
+async fn queue_add_confirmed_clears_all_source_copies() -> Result<()> {
+    let (mut app, _events, submission) = tab_submission().await?;
+    let server_home = tempfile::tempdir()?;
+    app.config.codex_home = AbsolutePathBuf::from_absolute_path(server_home.path())?;
+    assert_ne!(app.config.codex_home, app.local_settings.codex_home);
+    let thread_id = submission.thread_id;
+    let source = app.chat_widget.capture_thread_input_state().unwrap();
+    app.agents_overview
+        .input_states
+        .insert(thread_id, source.clone());
+    app.ensure_thread_channel(thread_id)
+        .store
+        .lock()
+        .await
+        .input_state = Some(source);
+    let item = server_item(&submission);
+    let listener = TcpListener::bind("127.0.0.1:0").await?;
+    let endpoint = crate::resolve_remote_addr(&format!("ws://{}", listener.local_addr()?))?;
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await?;
+        serve_reconnect_requests(
+            tokio_tungstenite::accept_async(stream).await?,
+            move |request| {
+                let item = item.clone();
+                async move {
+                    Some(match request.method.as_str() {
+                        "thread/queue/add" => json!({"result": {"queuedSubmission": item}}),
+                        "thread/queue/list" => {
+                            json!({"result": {"data": [item], "nextCursor": null}})
+                        }
+                        "thread/queue/claim" => json!({"result": {"queuedSubmission": null}}),
+                        method => panic!("unexpected request: {method}"),
+                    })
+                }
+            },
+        )
+        .await
+    });
+    let mut session = AppServerSession::new(
+        crate::connect_remote_app_server(endpoint).await?,
+        ThreadParamsMode::Remote,
+    );
+    app.add_service_queue_submission(&mut session, submission)
+        .await;
+    assert!(
+        !app.chat_widget
+            .capture_thread_input_state()
+            .is_some_and(|state| state.has_unconfirmed_messages())
+    );
+    assert!(!app.agents_overview.input_states[&thread_id].has_unconfirmed_messages());
+    assert!(
+        !app.thread_event_channels[&thread_id]
+            .store
+            .lock()
+            .await
+            .input_state
+            .as_ref()
+            .unwrap()
+            .has_unconfirmed_messages()
+    );
+    assert_eq!(app.chat_widget.service_queue_items().len(), 1);
+    drop(session);
+    server.await??;
+    Ok(())
+}
