+                destination: QueueDestination::CreatedThread {
+                    queued_item_id: first.id.clone(),
+                },
+                ..Default::default()
+            },
+        )
+        .await?;
+    emit_idle(&service, source_id).await;
+    assert!(listener_attached.load(Ordering::SeqCst));
+    let items = service.list(source_id).await?;
+    let target_id = ThreadId::from_string(
+        items[0]
+            .created_thread_id
+            .as_deref()
+            .context("new thread id missing")?,
+    )?;
+    assert_ne!(target_id, source_id);
+    assert_eq!(items[0].state, QueueItemState::Completed);
+    assert_eq!(items[1].state, QueueItemState::Pending);
+    let target = test.thread_manager.get_thread(target_id).await?;
+    wait_for_event_match(target.as_ref(), |event| {
+        matches!(event, EventMsg::TurnComplete(_)).then_some(())
+    })
+    .await;
+    let source_history = test.codex.load_history(false).await?;
+    let target_history = target.load_history(false).await?;
+    assert_eq!(
+        source_history
+            .items
+            .iter()
+            .filter(|item| matches!(
+                item,
+                codex_rollout::RolloutItem::EventMsg(EventMsg::TurnComplete(_))
+            ))
+            .count(),
+        1
+    );
+    assert_eq!(
+        target_history
+            .items
+            .iter()
+            .filter(|item| matches!(
+                item,
+                codex_rollout::RolloutItem::EventMsg(EventMsg::TurnComplete(_))
+            ))
+            .count(),
+        1
+    );
+    let source_config = test.codex.config().await;
+    let target_config = target.config().await;
+    assert_eq!(source_config.model, target_config.model);
+    assert_eq!(
+        source_config.model_provider_id,
+        target_config.model_provider_id
+    );
+    assert_eq!(source_config.permissions, target_config.permissions);
+    assert!(service.delete(source_id, follow_up.id).await?);
+    assert!(service.list(source_id).await?.is_empty());
+    Ok(())
 }
 
