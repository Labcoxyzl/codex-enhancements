+    assert_eq!(
+        rx.try_recv().unwrap(),
+        QueueViewOutput::Action { id: "b".into() }
+    );
+    assert_eq!(
+        rx.try_recv().unwrap(),
+        QueueViewOutput::Destination { id: "b".into() }
+    );
+    assert!(rx.try_recv().is_err());
+}
+
+#[test]
+fn empty_queue_ignores_item_actions() {
+    let (mut view, mut rx) = view(Vec::new());
+    for key in [
+        KeyCode::Enter.into(),
+        KeyCode::Delete.into(),
+        KeyEvent::new(KeyCode::Up, KeyModifiers::CONTROL),
