+//! Queue inspection and item actions. The service owns ordering; local recovery stays in the TUI.
+
+use codex_app_server_protocol::QueueItemState;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Constraint;
+use ratatui::layout::Layout;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Block;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+use tokio::sync::mpsc::UnboundedSender;
+
+use crate::key_hint;
+use crate::key_hint::KeyBindingListExt;
+use crate::keymap::KeymapContext;
+use crate::keymap::KeymapContextSet;
+use crate::keymap::ListAction;
+use crate::keymap::ListKeymap;
+use crate::render::Insets;
+use crate::render::RectExt;
+use crate::render::renderable::Renderable;
+use crate::style::user_message_style;
+
+use super::CancellationEvent;
+use super::bottom_pane_view::BottomPaneView;
+use super::picker_rows::render_rows_single_line;
+use super::picker_style::selection_style;
+use super::popup_consts::MAX_POPUP_ROWS;
+use super::scroll_state::ScrollState;
+use super::selection_popup_common::GenericDisplayRow;
+
+/// One queue item flattened for presentation. Local recovery IDs are client message IDs.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct QueueViewItem {
+    pub id: String,
+    pub local_unconfirmed: bool,
+    pub summary: String,
+    pub trigger: String,
+    pub action: String,
+    pub destination: String,
+    pub state: QueueItemState,
+}
+
+/// Intent for App to apply to a stable service item or local client message ID.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum QueueViewOutput {
+    Edit { id: String },
+    Trigger { id: String },
+    Action { id: String },
+    Destination { id: String },
+    Reorder { id: String, to_index: usize },
+    Cancel { id: String },
+    RecheckLocal { client_user_message_id: String },
+    DiscardLocal { client_user_message_id: String },
+    ConfirmDiscardLocal { client_user_message_id: String },
+}
+
+pub(crate) struct QueueManagerView {
+    items: Vec<QueueViewItem>,
+    state: ScrollState,
+    output_tx: UnboundedSender<QueueViewOutput>,
+    keymap: ListKeymap,
+    complete: bool,
+    send_failed: bool,
+}
+
+impl QueueManagerView {
+    pub(crate) fn new(
+        items: Vec<QueueViewItem>,
+        keymap: ListKeymap,
+        output_tx: UnboundedSender<QueueViewOutput>,
+    ) -> Self {
+        let mut state = ScrollState::new();
+        state.clamp_selection(items.len());
+        Self {
+            items,
+            state,
+            output_tx,
+            keymap,
+            complete: false,
+            send_failed: false,
+        }
+    }
+
+    /// Replace the snapshot without jumping away from the selected item.
+    pub(crate) fn set_items(&mut self, items: Vec<QueueViewItem>) {
+        let selected_id = self
+            .selected_item()
+            .map(|item| (item.id.clone(), item.local_unconfirmed));
+        let old_index = self.state.selected_idx;
+        self.items = items;
+        self.state.selected_idx = selected_id
+            .and_then(|(id, local)| {
+                self.items
+                    .iter()
+                    .position(|item| item.id == id && item.local_unconfirmed == local)
+            })
+            .or(old_index);
+        self.state.clamp_selection(self.items.len());
+        self.state.ensure_visible(self.items.len(), MAX_POPUP_ROWS);
+    }
+
+    pub(crate) fn select_latest(&mut self) {
+        self.state.selected_idx = self.items.len().checked_sub(1);
+        self.state.ensure_visible(self.items.len(), MAX_POPUP_ROWS);
+    }
+
+    fn selected_item(&self) -> Option<&QueueViewItem> {
+        self.state
+            .selected_idx
+            .and_then(|index| self.items.get(index))
+    }
+
+    fn send(&mut self, request: QueueViewOutput) {
+        if self.output_tx.send(request).is_err() {
+            self.send_failed = true;
+        }
+    }
+
+    fn reorder(&mut self, offset: isize) {
+        let Some(index) = self.state.selected_idx else {
+            return;
+        };
+        let Some(item) = self.items.get(index) else {
+            return;
+        };
+        if item.local_unconfirmed || item.state != QueueItemState::Pending {
+            return;
+        }
+        let target = index.saturating_add_signed(offset);
+        if target < self.items.len()
+            && target != index
+            && !self.items[target].local_unconfirmed
+            && self.items[target].state == QueueItemState::Pending
+        {
+            self.send(QueueViewOutput::Reorder {
+                id: item.id.clone(),
+                to_index: self.items[..target]
+                    .iter()
+                    .filter(|item| !item.local_unconfirmed)
+                    .count(),
+            });
+        }
+    }
+
+    fn rows(&self) -> Vec<GenericDisplayRow> {
+        self.items
+            .iter()
+            .enumerate()
+            .map(|(index, item)| GenericDisplayRow {
+                name: format!(
+                    "{} {}. {} · {}",
+                    if self.state.selected_idx == Some(index) {
+                        '›'
+                    } else {
+                        ' '
+                    },
+                    index + 1,
+                    item.summary,
+                    if item.local_unconfirmed {
+                        "unconfirmed local copy"
+                    } else {
+                        state_label(&item.state)
+                    }
+                ),
+                selection_style: Some(selection_style()),
+                ..Default::default()
+            })
+            .collect()
+    }
+
+    fn details(&self, width: u16) -> Vec<Line<'static>> {
+        let Some(item) = self.selected_item() else {
+            return Vec::new();
+        };
+        if item.local_unconfirmed {
+            return [
+                format!("Client message ID: {}", item.id),
+                format!("Item: {}", item.summary),
+                "State: Unconfirmed local copy".to_string(),
+                "Delivery may already have happened. Recheck delivery before discarding the local recovery copy. Discard does not undo a delivered action. This view never resends it.".to_string(),
+            ]
+            .into_iter()
+            .flat_map(|detail| {
+                textwrap::wrap(&detail, usize::from(width.max(1)))
+                    .into_iter()
+                    .map(|line| Line::from(line.into_owned()))
+                    .collect::<Vec<_>>()
+            })
+            .collect();
+        }
+        let mut lines = Vec::new();
+        for detail in [
+            format!("ID: {}", item.id),
+            format!("Item: {}", item.summary),
+            format!("Trigger: {}", item.trigger),
+            format!("Action: {}", item.action),
+            format!("Destination: {}", item.destination),
+            format!("State: {}", state_label(&item.state)),
+        ] {
+            lines.extend(
+                textwrap::wrap(&detail, usize::from(width.max(1)))
+                    .into_iter()
+                    .map(|line| Line::from(line.into_owned())),
+            );
+        }
+        if item.state == QueueItemState::AwaitingUi {
+            lines.extend(textwrap::wrap(
+                "Execution is unconfirmed; this command may already have run. Review it. Delete removes the queued record and unblocks later items.",
+                usize::from(width.max(1)),
+            ).into_iter().map(|line| Line::from(line.into_owned())));
+        } else if item.state == QueueItemState::Uncertain {
+            lines.extend(
+                textwrap::wrap(
+                    "Delivery may have started. Review this item before canceling or retrying it.",
+                    usize::from(width.max(1)),
+                )
+                .into_iter()
+                .map(|line| Line::from(line.into_owned())),
+            );
+        }
+        lines
+    }
+
+    fn footer_hint(&self) -> Line<'static> {
+        if self.send_failed {
+            return Line::from("Queue action could not be sent. Close and reopen the queue.").red();
+        }
+        let mut spans = Vec::new();
+        if let Some(up) = self.keymap.primary_hint(ListAction::MoveUp) {
+            spans.extend(up.spans());
+            spans.push("/".into());
+            if let Some(down) = self.keymap.primary_hint(ListAction::MoveDown) {
+                spans.extend(down.spans());
+            }
+            spans.push(" select · ".into());
+        }
+        let selected = self.selected_item();
+        if selected.is_some_and(|item| item.local_unconfirmed) {
+            if let Some(accept) = self.keymap.primary_hint(ListAction::Accept) {
+                spans.extend(accept.spans());
+                spans.push("/".into());
+            }
+            spans.push(key_hint::plain(KeyCode::Char('r')).into());
+            spans.push(" recheck delivery · ".into());
+            spans.push(key_hint::plain(KeyCode::Delete).into());
+            spans.push(" discard local copy · ".into());
+            if let Some(cancel) = self.keymap.primary_hint(ListAction::Cancel) {
+                spans.extend(cancel.spans());
+                spans.push(" close".into());
+            }
+            return Line::from(spans);
+        }
+        let state = selected.map(|item| &item.state);
+        if state == Some(&QueueItemState::Pending) {
+            if let Some(accept) = self.keymap.primary_hint(ListAction::Accept) {
+                spans.extend(accept.spans());
+                spans.push("/".into());
+            }
+            spans.push(key_hint::plain(KeyCode::Char('e')).into());
+            spans.push(" text · t trigger · a action · n destination · ".into());
+            spans.push(key_hint::ctrl(KeyCode::Up).into());
+            spans.push("/".into());
+            spans.push(key_hint::ctrl(KeyCode::Down).into());
+            spans.push(" move · ".into());
+        }
+        if matches!(
+            state,
+            Some(
+                &QueueItemState::Pending | &QueueItemState::Uncertain | &QueueItemState::AwaitingUi
+            )
+        ) {
+            spans.push(key_hint::plain(KeyCode::Delete).into());
+            spans.push(" cancel · ".into());
+        }
+        if let Some(cancel) = self.keymap.primary_hint(ListAction::Cancel) {
+            spans.extend(cancel.spans());
+            spans.push(" close".into());
+        }
+        Line::from(spans)
+    }
+}
+
+impl BottomPaneView for QueueManagerView {
+    fn view_id(&self) -> Option<&'static str> {
+        Some("service-queue")
+    }
+
+    fn update_queue_items(&mut self, items: Vec<QueueViewItem>) -> bool {
+        self.set_items(items);
+        true
+    }
+    fn keymap_contexts(&self) -> KeymapContextSet {
+        KeymapContextSet::new(KeymapContext::List)
+    }
+
+    fn handle_key_event(&mut self, key_event: KeyEvent) {
+        if self.complete || key_event.kind == KeyEventKind::Release {
+            return;
+        }
+        match (key_event.code, key_event.modifiers) {
+            (KeyCode::Up, KeyModifiers::CONTROL) => self.reorder(-1),
+            (KeyCode::Down, KeyModifiers::CONTROL) => self.reorder(1),
+            (KeyCode::Char('r'), KeyModifiers::NONE) => {
+                if let Some(item) = self.selected_item().filter(|item| item.local_unconfirmed) {
+                    self.send(QueueViewOutput::RecheckLocal {
+                        client_user_message_id: item.id.clone(),
+                    });
+                }
+            }
+            (KeyCode::Char('e'), KeyModifiers::NONE) => {
+                if let Some(item) = self
+                    .selected_item()
+                    .filter(|item| !item.local_unconfirmed && item.state == QueueItemState::Pending)
+                {
+                    self.send(QueueViewOutput::Edit {
+                        id: item.id.clone(),
+                    });
+                }
+            }
+            (KeyCode::Char('t'), KeyModifiers::NONE) => {
+                if let Some(item) = self
+                    .selected_item()
+                    .filter(|item| !item.local_unconfirmed && item.state == QueueItemState::Pending)
+                {
+                    self.send(QueueViewOutput::Trigger {
+                        id: item.id.clone(),
+                    });
+                }
+            }
+            (KeyCode::Char('a'), KeyModifiers::NONE) => {
+                if let Some(item) = self
+                    .selected_item()
+                    .filter(|item| !item.local_unconfirmed && item.state == QueueItemState::Pending)
+                {
+                    self.send(QueueViewOutput::Action {
+                        id: item.id.clone(),
+                    });
+                }
+            }
+            (KeyCode::Char('n'), KeyModifiers::NONE) => {
+                if let Some(item) = self
+                    .selected_item()
+                    .filter(|item| !item.local_unconfirmed && item.state == QueueItemState::Pending)
+                {
+                    self.send(QueueViewOutput::Destination {
+                        id: item.id.clone(),
+                    });
+                }
+            }
+            (KeyCode::Char('d') | KeyCode::Delete, KeyModifiers::NONE) => {
+                if let Some(item) = self.selected_item() {
+                    if item.local_unconfirmed {
+                        self.send(QueueViewOutput::DiscardLocal {
+                            client_user_message_id: item.id.clone(),
+                        });
+                    } else if matches!(
+                        item.state,
+                        QueueItemState::Pending
+                            | QueueItemState::Uncertain
+                            | QueueItemState::AwaitingUi
+                    ) {
+                        self.send(QueueViewOutput::Cancel {
+                            id: item.id.clone(),
+                        });
+                    }
+                }
+            }
+            _ if self.keymap.move_up.is_pressed(key_event) => {
+                self.state.move_up_wrap(self.items.len());
+            }
+            _ if self.keymap.move_down.is_pressed(key_event) => {
+                self.state.move_down_wrap(self.items.len());
+            }
+            _ if self.keymap.page_up.is_pressed(key_event) => {
+                self.state.page_up_clamped(self.items.len(), MAX_POPUP_ROWS);
+            }
+            _ if self.keymap.page_down.is_pressed(key_event) => {
+                self.state
+                    .page_down_clamped(self.items.len(), MAX_POPUP_ROWS);
+            }
+            _ if self.keymap.jump_top.is_pressed(key_event) => {
+                self.state.jump_top(self.items.len(), MAX_POPUP_ROWS);
+            }
+            _ if self.keymap.jump_bottom.is_pressed(key_event) => {
+                self.state.jump_bottom(self.items.len(), MAX_POPUP_ROWS);
+            }
+            _ if self.keymap.accept.is_pressed(key_event) => {
+                if let Some(item) = self.selected_item() {
+                    if item.local_unconfirmed {
+                        self.send(QueueViewOutput::RecheckLocal {
+                            client_user_message_id: item.id.clone(),
+                        });
+                    } else if item.state == QueueItemState::Pending {
+                        self.send(QueueViewOutput::Edit {
+                            id: item.id.clone(),
+                        });
+                    }
+                }
+            }
+            _ if self.keymap.cancel.is_pressed(key_event) => {
+                self.on_ctrl_c();
+            }
+            _ => {}
+        }
+        self.state.ensure_visible(self.items.len(), MAX_POPUP_ROWS);
+    }
+
+    fn is_complete(&self) -> bool {
+        self.complete
+    }
+
+    fn on_ctrl_c(&mut self) -> CancellationEvent {
+        self.complete = true;
+        CancellationEvent::Handled
+    }
+}
+
+fn state_label(state: &QueueItemState) -> &'static str {
+    match state {
+        QueueItemState::Pending => "pending",
+        QueueItemState::Dispatching => "sending",
+        QueueItemState::Uncertain => "uncertain",
+        QueueItemState::AwaitingUi => "awaiting TUI review",
+        QueueItemState::Completed => "completed",
+        QueueItemState::Canceled => "canceled",
+    }
+}
+
+impl Renderable for QueueManagerView {
+    fn desired_height(&self, width: u16) -> u16 {
+        let inner_width = width.saturating_sub(4);
+        let footer_height =
+            super::selection_popup_common::wrap_styled_line(&self.footer_hint(), inner_width).len()
+                as u16;
+        2 + 1
+            + (self.items.len().clamp(1, MAX_POPUP_ROWS) as u16 + 2)
+            + u16::from(!self.items.is_empty())
+            + self.details(inner_width).len() as u16
+            + 1
+            + footer_height
+    }
+
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        if area.is_empty() {
+            return;
+        }
+        Block::default()
+            .style(user_message_style())
+            .render(area, buf);
+        let inner = area.inset(Insets::vh(/*v*/ 1, /*h*/ 2));
+        if inner.is_empty() {
+            return;
+        }
+        let footer = self.footer_hint();
+        let footer_lines = super::selection_popup_common::wrap_styled_line(&footer, inner.width);
+        let details = self.details(inner.width);
+        let [header_area, rows_area, _, detail_area, _, footer_area] = Layout::vertical([
+            Constraint::Length(1),
+            Constraint::Length(self.items.len().clamp(1, MAX_POPUP_ROWS) as u16 + 2),
+            Constraint::Length(u16::from(!details.is_empty())),
+            Constraint::Fill(1),
+            Constraint::Length(1),
+            Constraint::Length(footer_lines.len() as u16),
+        ])
+        .areas(inner);
+        Paragraph::new(Line::from(format!("Queue ({})", self.items.len())).bold())
+            .render(header_area, buf);
+        render_rows_single_line(
+            rows_area,
+            buf,
+            &self.rows(),
+            &self.state,
+            MAX_POPUP_ROWS,
+            "  No queued items",
+        );
+        Paragraph::new(details).render(detail_area, buf);
+        Paragraph::new(footer_lines).dim().render(footer_area, buf);
+    }
+}
