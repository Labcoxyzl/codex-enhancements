diff --git a/codex-rs/ext/queue/src/model.rs b/codex-rs/ext/queue/src/model.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3b4e39abd6f2bfca789e77caafebce44eb312280
--- /dev/null
+++ b/codex-rs/ext/queue/src/model.rs
@@ -0,0 +1,175 @@
+use codex_core::TurnInput;
+use codex_thread_store::QueuedUserSubmissionRecord;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "type", rename_all = "camelCase")]
+pub enum QueueTrigger {
+    #[default]
+    NextTurn,
+    TurnCompleted {
+        turn_id: String,
+    },
+    GoalCompleted {
+        goal_id: String,
+    },
+    QueuedGoalCompleted {
+        queued_item_id: String,
+    },
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "type", rename_all = "camelCase")]
+pub enum QueueAction {
+    #[default]
+    Prompt,
+    Goal {
+        objective: String,
+    },
+    UiCommand {
+        draft: Value,
+    },
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "type", rename_all = "camelCase")]
+pub enum QueueDestination {
+    #[default]
+    SourceThread,
+    NewThread,
+    CreatedThread {
+        queued_item_id: String,
+    },
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub enum QueueItemState {
+    #[default]
+    Pending,
+    Dispatching,
+    Uncertain,
+    AwaitingUi,
+    Completed,
+    Canceled,
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct QueueMetadata {
+    pub trigger: QueueTrigger,
+    pub action: QueueAction,
+    pub destination: QueueDestination,
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct QueueMetadataPatch {
+    pub trigger: Option<QueueTrigger>,
+    pub action: Option<QueueAction>,
+    pub destination: Option<QueueDestination>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct QueuedItem {
+    pub id: String,
+    pub input: TurnInput,
+    pub trigger: QueueTrigger,
+    pub action: QueueAction,
+    pub destination: QueueDestination,
+    pub state: QueueItemState,
+    pub revision: u64,
+    pub expected_goal_id: Option<String>,
+    pub created_goal_id: Option<String>,
+    pub created_thread_id: Option<String>,
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct ManagedPayload {
+    version: u8,
+    input: TurnInput,
+    trigger: QueueTrigger,
+    action: QueueAction,
+    destination: QueueDestination,
+    state: QueueItemState,
+    revision: u64,
+    #[serde(default)]
+    expected_goal_id: Option<String>,
+    #[serde(default)]
+    created_goal_id: Option<String>,
+    #[serde(default)]
+    created_thread_id: Option<String>,
+}
+
+pub(crate) fn from_record(record: QueuedUserSubmissionRecord) -> serde_json::Result<QueuedItem> {
+    let payload: Value = serde_json::from_str(&record.payload)?;
+    if payload.get("version").is_some() {
+        let payload: ManagedPayload = serde_json::from_value(payload)?;
+        Ok(QueuedItem {
+            id: record.id,
+            input: payload.input,
+            trigger: payload.trigger,
+            action: payload.action,
+            destination: payload.destination,
+            state: payload.state,
+            revision: payload.revision,
+            expected_goal_id: payload.expected_goal_id,
+            created_goal_id: payload.created_goal_id,
+            created_thread_id: payload.created_thread_id,
+        })
+    } else {
+        Ok(QueuedItem {
+            id: record.id,
+            input: serde_json::from_value(payload)?,
+            trigger: QueueTrigger::default(),
+            action: QueueAction::default(),
+            destination: QueueDestination::default(),
+            state: QueueItemState::default(),
+            revision: 0,
+            expected_goal_id: None,
+            created_goal_id: None,
+            created_thread_id: None,
+        })
+    }
+}
+
+pub(crate) fn visible_item_from_record(record: QueuedUserSubmissionRecord) -> QueuedItem {
+    match from_record(record.clone()) {
+        Ok(item) => item,
+        Err(_) => QueuedItem {
+            id: record.id,
+            input: TurnInput::UserInput {
+                content: vec![],
+                client_id: Some(String::new()),
+            },
+            trigger: QueueTrigger::NextTurn,
+            action: QueueAction::UiCommand {
