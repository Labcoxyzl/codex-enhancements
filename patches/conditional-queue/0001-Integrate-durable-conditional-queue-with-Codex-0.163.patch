+async fn held_queue_input_emits_one_service_submission_after_release() {
+    for rate_limit_hold in [false, true] {
+        let (mut chat, mut events, _ops) = helpers::make_chatwidget_manual(None).await;
+        chat.thread_id = Some(ThreadId::new());
+        chat.codex_op_target = CodexOpTarget::AppEvent;
+        if rate_limit_hold {
+            chat.hold_rate_limit_recovery();
+        } else {
+            chat.set_queue_autosend_suppressed(true);
+        }
+        assert!(chat.queue_user_message_with_options(
+            UserMessage::from("held follow-up"),
+            QueuedInputAction::Plain,
+            Vec::new(),
+        ));
+        assert_eq!(chat.queued_user_message_texts(), vec!["held follow-up"]);
+        assert!(events.try_recv().is_err());
+
+        if rate_limit_hold {
+            chat.finish_rate_limit_recovery();
+        } else {
+            chat.set_queue_autosend_suppressed(false);
+            chat.maybe_send_next_queued_input();
+        }
+        let AppEvent::QueueTabSubmission(submission) = events.try_recv().unwrap() else {
+            panic!("expected one service submission after release")
+        };
+        assert_eq!(chat.queued_user_message_texts(), vec!["held follow-up"]);
+        chat.recover_pending_service_queue_drafts();
+        assert!(!chat.capture_thread_input_state().unwrap().recovered_queue);
+        let mut offscreen = chat.capture_thread_input_state().unwrap();
+        assert!(offscreen.has_unconfirmed_messages());
+        assert!(offscreen.confirm_service_queue_submission(&submission.client_user_message_id));
+        assert!(!offscreen.has_unconfirmed_messages());
+        assert!(
+            submission.input.iter().any(
+                |part| matches!(part, UserInput::Text { text, .. } if text == "held follow-up")
+            )
+        );
+        assert!(chat.confirm_service_queue_submission(&submission.client_user_message_id));
+        assert!(chat.queued_user_message_texts().is_empty());
+        chat.maybe_send_next_queued_input();
+        assert!(events.try_recv().is_err());
+        assert!(chat.queue_user_message_with_options(
+            UserMessage::from("after ack"),
+            QueuedInputAction::Plain,
+            Vec::new(),
+        ));
+        assert!(matches!(
+            events.try_recv(),
+            Ok(AppEvent::QueueTabSubmission(_))
+        ));
+    }
+}
