+#[test]
+fn pending_item_cannot_move_ahead_of_unresolved_head() {
+    for state in [QueueItemState::AwaitingUi, QueueItemState::Uncertain] {
+        let (mut view, mut rx) = view(vec![
+            item("unresolved", "May have run", state),
+            item("pending", "Later action", QueueItemState::Pending),
+        ]);
+        view.handle_key_event(KeyCode::Down.into());
