index 0000000000000000000000000000000000000000..7a7a7822099433923a7115362f7a4c2f80f2afa2
--- /dev/null
+++ b/codex-rs/ext/queue/src/watch.rs
@@ -0,0 +1,383 @@
+use super::*;
+
+impl QueuedItemService {
+    async fn hold_source(&self, thread_id: ThreadId) -> std::io::Result<Option<QueueLoadedTarget>> {
+        let loader = self
+            .target_loader
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone();
+        let Some(loader) = loader else {
+            return Ok(None);
+        };
+        let loaded = loader(thread_id).await?;
+        if loaded.thread.startup_metadata().thread_id != thread_id {
+            return Err(std::io::Error::other(
+                "queued source loader returned a different thread",
+            ));
+        }
+        Ok(Some(loaded))
+    }
+
+    // Check SQLite's inexpensive data version every 10 seconds, then use the
+    // durable revision index to discover only changed threads. Independent
+    // dispatch tasks keep a blocked or failed thread from starving other queues.
+    pub(crate) async fn watch_external_messages(service: Weak<Self>) {
+        let mut last_version = None;
+        let mut last_revision = 0;
+        let mut dispatches: HashMap<ThreadId, tokio::task::JoinHandle<()>> = HashMap::new();
+        let mut interval = tokio::time::interval(Duration::from_secs(/*secs*/ 10));
+        let mut manager_initialized = false;
+        let mut thread_created = None;
+        let mut newly_loaded_threads = HashSet::new();
+        loop {
+            interval.tick().await;
+            let Some(service) = service.upgrade() else {
+                return;
+            };
+            let Some(manager) = service.thread_manager.upgrade() else {
+                if manager_initialized {
+                    return;
+                }
+                drop(service);
+                tokio::time::sleep(Duration::from_millis(/*millis*/ 1)).await;
+                interval.reset_immediately();
+                continue;
+            };
+            manager_initialized = true;
+            let thread_created =
+                thread_created.get_or_insert_with(|| manager.subscribe_thread_created());
+            loop {
+                match thread_created.try_recv() {
+                    Ok(thread_id) => {
+                        newly_loaded_threads.insert(thread_id);
+                    }
+                    Err(TryRecvError::Lagged(_)) => {
+                        newly_loaded_threads.extend(manager.list_thread_ids().await);
+                    }
+                    Err(TryRecvError::Empty) => break,
+                    Err(TryRecvError::Closed) => return,
+                }
+            }
+            newly_loaded_threads.extend(
+                service
+                    .resumed_threads
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                    .drain(),
+            );
+
+            let version = match service.queue.change_version().await {
+                Ok(version) => version,
+                Err(error) => {
+                    tracing::warn!(%error, "failed to check queue change version");
+                    continue;
+                }
+            };
+            let pending_sources = match service.queue.source_thread_ids().await {
+                Ok(thread_ids) => thread_ids,
+                Err(error) => {
+                    tracing::warn!(%error, "failed to discover queued source threads");
+                    continue;
+                }
+            };
+            let version_changed = last_version != Some(version);
+            if !version_changed && newly_loaded_threads.is_empty() && pending_sources.is_empty() {
+                continue;
+            }
+
+            let loaded_thread_ids = manager.list_thread_ids().await;
+            let thread_ids = loaded_thread_ids
+                .iter()
+                .chain(&pending_sources)
+                .copied()
+                .collect::<HashSet<_>>()
+                .into_iter()
+                .collect::<Vec<_>>();
+            let mut changes = Vec::new();
+            let mut observed_revision = last_revision;
+            if version_changed {
+                match service
+                    .queue
+                    .changes_since(last_revision, &thread_ids)
+                    .await
+                {
+                    Ok(changed_threads) => {
+                        if let Some((_, revision)) = changed_threads.last() {
+                            observed_revision = *revision;
+                        }
+                        changes.extend(changed_threads);
+                    }
+                    Err(error) => {
+                        tracing::warn!(%error, "failed to discover changed thread queues");
+                        continue;
+                    }
+                }
+            }
+            if !newly_loaded_threads.is_empty() {
+                let created_threads = loaded_thread_ids
+                    .iter()
+                    .copied()
+                    .filter(|thread_id| newly_loaded_threads.contains(thread_id))
+                    .collect::<Vec<_>>();
+                match service
+                    .queue
+                    .changes_since(/*revision*/ 0, &created_threads)
+                    .await
+                {
+                    Ok(changed_threads) => changes.extend(changed_threads),
+                    Err(error) => {
+                        tracing::warn!(%error, "failed to discover newly loaded thread queues");
+                        continue;
+                    }
+                }
+            }
+            last_version = Some(version);
+            last_revision = observed_revision;
+            newly_loaded_threads.clear();
+            dispatches.retain(|_, dispatch| !dispatch.is_finished());
+
+            let mut changed_threads = HashSet::new();
+            let mut dispatch_sources = pending_sources.into_iter().collect::<HashSet<_>>();
+            for (thread_id, _) in changes {
+                if !changed_threads.insert(thread_id) {
+                    continue;
+                }
+                service.emit_changed(thread_id);
+                dispatch_sources.insert(thread_id);
+            }
+            for thread_id in dispatch_sources {
+                if dispatches
+                    .get(&thread_id)
+                    .is_some_and(|dispatch| !dispatch.is_finished())
+                {
+                    continue;
+                }
+                let service = Arc::downgrade(&service);
+                let dispatch = tokio::spawn(async move {
+                    let mut source_hold: Option<QueueLoadedTarget> = None;
+                    loop {
+                        {
+                            let Some(service) = service.upgrade() else {
+                                return;
+                            };
+                            let Some(manager) = service.thread_manager.upgrade() else {
+                                return;
+                            };
+                            let (thread, loaded_hold) = if let Some(held) = source_hold.as_ref() {
+                                (Arc::clone(&held.thread), None)
+                            } else {
+                                match manager.get_thread(thread_id).await {
+                                    Ok(thread) => {
+                                        let Some((record, items)) = (match service
+                                            .head_record(thread_id)
+                                            .await
+                                        {
+                                            Ok(head) => head,
+                                            Err(error) => {
+                                                tracing::warn!(%thread_id, %error, "failed to inspect loaded source queue");
+                                                return;
+                                            }
+                                        }) else {
+                                            return;
+                                        };
+                                        let Ok(item) = from_record(record) else {
+                                            return;
+                                        };
+                                        if item.state == QueueItemState::Pending
+                                            && !matches!(item.action, QueueAction::UiCommand { .. })
+                                            && matches!(
+                                                service
+                                                    .eligible(
+                                                        thread_id,
+                                                        Some(&thread),
+                                                        &item,
+                                                        &items
+                                                    )
+                                                    .await,
+                                                Ok(Eligibility::Ready)
+                                            )
+                                        {
+                                            match service.hold_source(thread_id).await {
+                                                Ok(Some(loaded)) => {
+                                                    (Arc::clone(&loaded.thread), Some(loaded))
+                                                }
+                                                Ok(None) => (thread, None),
+                                                Err(error) => {
+                                                    tracing::warn!(%thread_id, %error, "failed to retain queued source thread");
+                                                    tokio::time::sleep(Duration::from_secs(
+                                                        /*secs*/ 10,
+                                                    ))
+                                                    .await;
+                                                    continue;
+                                                }
+                                            }
+                                        } else {
+                                            (thread, None)
+                                        }
+                                    }
+                                    Err(_) => {
+                                        let Some((record, items)) = (match service
+                                            .head_record(thread_id)
+                                            .await
+                                        {
+                                            Ok(head) => head,
+                                            Err(error) => {
+                                                tracing::warn!(%thread_id, %error, "failed to inspect cold source queue");
+                                                return;
+                                            }
+                                        }) else {
+                                            return;
+                                        };
+                                        let Ok(item) = from_record(record) else {
+                                            return;
+                                        };
+                                        let eligibility = if item.state == QueueItemState::Pending {
+                                            match service
+                                                .eligible(thread_id, None, &item, &items)
+                                                .await
+                                            {
+                                                Ok(eligibility) => eligibility,
+                                                Err(error) => {
+                                                    tracing::warn!(%thread_id, %error, "failed to inspect cold queue trigger");
+                                                    return;
+                                                }
+                                            }
+                                        } else {
+                                            Eligibility::Waiting
+                                        };
+                                        if item.state == QueueItemState::Dispatching
+                                            || eligibility == Eligibility::Uncertain
+                                        {
+                                            let _guard = service.dispatch_guard(thread_id).await;
+                                            if let Ok(Some((record, items))) =
+                                                service.head_record(thread_id).await
+                                                && let Ok(mut current) = from_record(record.clone())
+                                                && (current.state == QueueItemState::Dispatching
+                                                    || (current.state == QueueItemState::Pending
+                                                        && matches!(
+                                                            service
+                                                                .eligible(
+                                                                    thread_id, None, &current,
+                                                                    &items
+                                                                )
+                                                                .await,
+                                                            Ok(Eligibility::Uncertain)
+                                                        )))
+                                            {
+                                                current.state = QueueItemState::Uncertain;
+                                                if let Err(error) = service
+                                                    .persist_item(thread_id, record, current)
+                                                    .await
+                                                {
+                                                    tracing::warn!(%thread_id, %error, "failed to mark cold queued item uncertain");
+                                                }
+                                            }
+                                            return;
+                                        }
+                                        if item.state != QueueItemState::Pending {
+                                            return;
+                                        }
+                                        if matches!(item.action, QueueAction::UiCommand { .. }) {
+                                            return;
+                                        }
+                                        if eligibility == Eligibility::Waiting {
+                                            tokio::time::sleep(Duration::from_secs(
+                                                /*secs*/ 10,
+                                            ))
+                                            .await;
+                                            continue;
+                                        }
+                                        let loaded = match service.hold_source(thread_id).await {
+                                            Ok(Some(loaded)) => loaded,
+                                            Ok(None) => return,
+                                            Err(error) => {
+                                                tracing::warn!(%thread_id, %error, "failed to resume queued source thread");
+                                                tokio::time::sleep(Duration::from_secs(
+                                                    /*secs*/ 10,
+                                                ))
+                                                .await;
+                                                continue;
+                                            }
+                                        };
+                                        (Arc::clone(&loaded.thread), Some(loaded))
+                                    }
+                                }
+                            };
+                            if let Some(loaded) = loaded_hold {
+                                source_hold = Some(loaded);
+                            }
+                            if thread.agent_status().await == AgentStatus::Running {
+                                tokio::time::sleep(Duration::from_secs(/*secs*/ 10)).await;
+                                continue;
+                            }
+                            if matches!(
+                                thread.agent_status().await,
+                                AgentStatus::Interrupted
+                                    | AgentStatus::Errored(_)
+                                    | AgentStatus::Shutdown
+                                    | AgentStatus::NotFound
+                            ) {
+                                return;
+                            }
+                            if source_hold.is_some() {
+                                let Some((record, items)) = (match service
+                                    .head_record(thread_id)
+                                    .await
+                                {
+                                    Ok(head) => head,
+                                    Err(error) => {
+                                        tracing::warn!(%thread_id, %error, "failed to inspect held source queue");
+                                        return;
+                                    }
+                                }) else {
+                                    return;
+                                };
+                                let Ok(item) = from_record(record) else {
+                                    return;
+                                };
+                                if item.state == QueueItemState::Pending {
+                                    if matches!(item.action, QueueAction::UiCommand { .. }) {
+                                        return;
+                                    }
+                                    match service
+                                        .eligible(thread_id, Some(&thread), &item, &items)
+                                        .await
+                                    {
+                                        Ok(Eligibility::Waiting) => return,
+                                        Ok(Eligibility::Ready | Eligibility::Uncertain) => {}
+                                        Err(error) => {
+                                            tracing::warn!(%thread_id, %error, "failed to inspect held queue trigger");
+                                            return;
+                                        }
+                                    }
+                                } else if item.state != QueueItemState::Dispatching {
+                                    return;
+                                }
+                            }
+                            match service
+                                .queue
+                                .list_page(thread_id, /*offset*/ 0, /*limit*/ 1)
+                                .await
+                            {
+                                Ok(items) if items.is_empty() => return,
+                                Ok(_) => {
+                                    thread
+                                        .emit_thread_idle_lifecycle_if_idle(
+                                            ThreadIdleCause::Completed,
+                                        )
+                                        .await;
+                                }
+                                Err(error) => {
+                                    tracing::warn!(%thread_id, %error, "failed to check queued user input");
+                                }
+                            }
+                        }
+                        tokio::time::sleep(Duration::from_secs(/*secs*/ 10)).await;
+                    }
+                });
+                dispatches.insert(thread_id, dispatch);
+            }
+        }
+    }
+}
