+
+fn validate_metadata(
+    metadata: &QueueMetadata,
+    existing: &[QueuedItem],
+    position: usize,
+) -> Result<(), QueueServiceError> {
+    let prior_item = |id: &str| existing.iter().take(position).find(|item| item.id == id);
+    match &metadata.trigger {
+        QueueTrigger::NextTurn => {}
+        QueueTrigger::TurnCompleted { turn_id } if !turn_id.trim().is_empty() => {}
+        QueueTrigger::GoalCompleted { goal_id } if !goal_id.trim().is_empty() => {}
+        QueueTrigger::QueuedGoalCompleted { queued_item_id }
+            if prior_item(queued_item_id)
+                .is_some_and(|item| matches!(item.action, QueueAction::Goal { .. })) => {}
+        _ => {
+            return Err(QueueServiceError::InvalidEntry(
+                "queue trigger must reference a valid earlier goal item or nonempty turn/goal ID"
+                    .to_string(),
+            ));
+        }
+    }
+    match &metadata.destination {
+        QueueDestination::SourceThread | QueueDestination::NewThread => {}
+        QueueDestination::CreatedThread { queued_item_id }
+            if prior_item(queued_item_id)
+                .is_some_and(|item| item.destination == QueueDestination::NewThread) => {}
+        QueueDestination::CreatedThread { .. } => {
+            return Err(QueueServiceError::InvalidEntry(
+                "destination must reference an earlier new-thread item".to_string(),
+            ));
+        }
+    }
+    match &metadata.action {
+        QueueAction::Prompt => {}
+        QueueAction::Goal { objective }
+            if !objective.trim().is_empty()
+                && objective.chars().count() <= MAX_USER_INPUT_TEXT_CHARS => {}
+        QueueAction::Goal { .. } => {
+            return Err(QueueServiceError::InvalidEntry(
+                "goal objective must be nonempty and within the input size limit".to_string(),
+            ));
+        }
+        QueueAction::UiCommand { draft }
+            if metadata.destination == QueueDestination::SourceThread
+                && draft.is_object()
+                && serde_json::to_vec(draft)?.len() <= 1024 * 1024 => {}
+        QueueAction::UiCommand { .. } => {
+            return Err(QueueServiceError::InvalidEntry(
+                "UI command must target the source thread with an object draft of at most 1 MiB"
+                    .to_string(),
+            ));
+        }
+    }
+    Ok(())
+}
