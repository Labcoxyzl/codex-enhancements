diff --git a/codex-rs/tui/src/chatwidget/service_queue.rs b/codex-rs/tui/src/chatwidget/service_queue.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4b0ebbbe2b5d3a31f692ec20f804fc8ce773e7ff
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/service_queue.rs
@@ -0,0 +1,725 @@
+//! TUI drafts enter the durable thread queue through the app server.
+
+use super::*;
+use crate::bottom_pane::QueueViewItem;
+use crate::bottom_pane::QueueViewOutput;
+use crate::bottom_pane::custom_prompt_view::CustomPromptView;
+use codex_app_server_protocol::ImageReference;
+use codex_app_server_protocol::QueueAction;
+use codex_app_server_protocol::QueueDestination;
+use codex_app_server_protocol::QueueItemState;
+use codex_app_server_protocol::QueueTrigger;
+use codex_app_server_protocol::QueuedSubmission;
+use serde::Deserialize;
+use serde::Serialize;
+
+pub(crate) fn service_queue_ui_action_from_item(item: &QueuedSubmission) -> Option<QueueAction> {
+    if let QueueAction::UiCommand { .. } = &item.action {
+        return Some(item.action.clone());
+    }
+    let mut message = UserMessage {
+        text: String::new(),
+        local_images: Vec::new(),
+        remote_image_urls: Vec::new(),
+        text_elements: Vec::new(),
+        mention_bindings: Vec::new(),
+    };
+    let remote_image_count = item
+        .input
+        .iter()
+        .filter(|part| {
+            matches!(
+                part,
+                UserInput::Image {
+                    image: ImageReference::Inline { .. },
+                    ..
+                }
+            )
+        })
+        .count();
+    for input in &item.input {
+        match input {
+            UserInput::Text {
+                text,
+                text_elements,
+            } => {
+                let offset = message.text.len();
+                message.text.push_str(text);
+                message
+                    .text_elements
+                    .extend(text_elements.iter().cloned().map(|element| {
+                        let mut element: codex_protocol::user_input::TextElement = element.into();
+                        element.byte_range.start += offset;
+                        element.byte_range.end += offset;
+                        element
+                    }));
+            }
+            UserInput::Image {
+                image: ImageReference::Inline { url },
+                ..
+            } => {
+                message.remote_image_urls.push(url.clone());
+            }
+            UserInput::LocalImage { path, .. } => {
+                message.local_images.push(LocalImageAttachment {
+                    placeholder: codex_protocol::models::local_image_label_text(
+                        remote_image_count + message.local_images.len() + 1,
+                    ),
+                    path: path.clone(),
+                });
+            }
+            UserInput::Mention { .. } | UserInput::Skill { .. } => {}
+            UserInput::Image {
+                image: ImageReference::File { .. },
+                ..
+            }
+            | UserInput::Audio { .. }
+            | UserInput::LocalAudio { .. } => return None,
+        }
+    }
+    message.mention_bindings =
+        user_messages::mention_bindings_from_user_inputs(&item.input, &message.text);
+    let action = if message.text.starts_with('!') {
+        QueuedInputAction::RunShell
+    } else if message.text.starts_with('/') {
+        QueuedInputAction::ParseSlash
+    } else {
+        QueuedInputAction::Literal
+    };
+    serde_json::to_value(QueueUiDraft {
+        user_message: message,
+        action,
+        pending_pastes: Vec::new(),
+        source: UserMessageSource::Prompt,
+        history_record: UserMessageHistoryRecord::UserMessageText,
+    })
+    .ok()
+    .map(|draft| QueueAction::UiCommand { draft })
+}
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub(crate) struct QueueUiDraft {
+    pub(crate) user_message: UserMessage,
+    pub(crate) action: QueuedInputAction,
+    pub(crate) pending_pastes: Vec<(String, String)>,
+    pub(in crate::chatwidget) source: UserMessageSource,
+    pub(in crate::chatwidget) history_record: UserMessageHistoryRecord,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub(crate) struct QueueTabSubmission {
+    pub(crate) thread_id: ThreadId,
+    pub(crate) input: Vec<UserInput>,
+    pub(crate) action: QueueAction,
+    pub(crate) client_user_message_id: String,
+    pub(crate) draft: QueueUiDraft,
+}
+
+impl ChatWidget {
+    pub(crate) fn remote_image_editor_markers(
+        item: &QueuedSubmission,
+        original_text: &str,
+    ) -> Vec<(usize, String)> {
+        let mut image_number = 0;
+        let mut remote_index = 0;
+        item.input
+            .iter()
+            .filter_map(|part| match part {
+                UserInput::Image {
+                    image: ImageReference::Inline { .. },
+                    ..
+                } => {
+                    image_number += 1;
+                    let index = remote_index;
+                    remote_index += 1;
+                    let mut marker =
+                        format!("[Remote image #{image_number} — delete this line to remove]");
+                    while original_text.contains(&marker) {
+                        marker.push('!');
+                    }
+                    Some((index, marker))
+                }
+                UserInput::LocalImage { .. } => {
+                    image_number += 1;
+                    None
+                }
+                _ => None,
+            })
+            .collect()
+    }
+
+    pub(crate) fn request_open_service_queue(&mut self) {
+        if let Some(thread_id) = self.thread_id {
+            self.app_event_tx
+                .send(AppEvent::OpenServiceQueue { thread_id });
+        }
+    }
+
+    pub(super) fn enqueue_service_draft(
+        &mut self,
+        queued: QueuedUserMessage,
+        history_record: UserMessageHistoryRecord,
+    ) -> bool {
+        let Some(thread_id) = self.thread_id else {
+            return false;
+        };
+        let mut mention_bindings = queued.user_message.mention_bindings.clone();
+        let mut input = Vec::new();
+        input.extend(
+            queued
+                .user_message
+                .remote_image_urls
+                .iter()
+                .map(|url| UserInput::Image {
+                    image: ImageReference::Inline { url: url.clone() },
+                    detail: None,
+                }),
+        );
+        input.extend(
+            queued
+                .user_message
+                .local_images
+                .iter()
+                .map(|image| UserInput::LocalImage {
+                    path: image.path.clone(),
+                    detail: None,
+                }),
+        );
+        if !queued.user_message.text.is_empty() {
+            input.push(UserInput::Text {
+                text: queued.user_message.text.clone(),
+                text_elements: user_messages::app_server_text_elements(
+                    &queued.user_message.text_elements,
+                ),
+            });
+        }
+        self.enrich_user_input_mentions(
+            &queued.user_message.text,
+            &mut input,
+            &mut mention_bindings,
+        );
+        self.maybe_apply_ide_context(&mut input);
+        crate::task_mentions::apply_task_references(&mut input, &mention_bindings, self.thread_id);
+
+        let draft = QueueUiDraft {
+            user_message: queued.user_message,
+            action: queued.action,
+            pending_pastes: queued.pending_pastes,
+            source: queued.source,
+            history_record,
+        };
+        let action = if draft.action == QueuedInputAction::Plain
+            && !draft.user_message.text.starts_with('!')
+            && draft.pending_pastes.is_empty()
+            && draft.source == UserMessageSource::Prompt
+        {
+            QueueAction::Prompt
+        } else {
+            let Ok(value) = serde_json::to_value(&draft) else {
+                self.add_error_message("Could not save the queued draft.".to_string());
+                self.restore_failed_service_queue_draft(draft);
+                return false;
+            };
+            QueueAction::UiCommand { draft: value }
+        };
+        let client_user_message_id = uuid::Uuid::now_v7().to_string();
+        let submission = QueueTabSubmission {
+            thread_id,
+            input,
+            action,
+            client_user_message_id: client_user_message_id.clone(),
+            draft,
+        };
+        if let Err(error) =
+            crate::queue_add_journal::stage(self.local_settings.codex_home.as_path(), &submission)
+        {
+            tracing::warn!(kind = ?error.kind(), "queue draft journal write failed");
+            self.add_error_message(
+                "Could not safely save the queued draft. It is still editable.".into(),
+            );
+            self.restore_failed_service_queue_draft(submission.draft);
+            return false;
+        }
+        self.input_queue
+            .queued_user_messages
+            .push_front(QueuedUserMessage {
+                user_message: submission.draft.user_message.clone(),
+                action: submission.draft.action,
+                delivery: MessageDelivery::QueueAddUnconfirmed(client_user_message_id),
+                pending_pastes: submission.draft.pending_pastes.clone(),
+                source: submission.draft.source,
+            });
+        self.input_queue
+            .queued_user_message_history_records
+            .push_front(submission.draft.history_record.clone());
+        self.refresh_service_queue_views();
+        self.app_event_tx
+            .send(AppEvent::QueueTabSubmission(submission));
+        true
+    }
+
+    pub(crate) fn confirm_service_queue_submission(&mut self, client_id: &str) -> bool {
+        let removed = remove_confirmed_queue_draft(
+            &mut self.input_queue.queued_user_messages,
+            &mut self.input_queue.queued_user_message_history_records,
+            client_id,
+        );
+        if removed {
+            self.refresh_service_queue_views();
+            self.maybe_send_next_queued_input();
+        }
+        removed
+    }
+
+    pub(crate) fn discard_service_queue_submission(&mut self, client_id: &str) -> bool {
+        let removed = remove_confirmed_queue_draft(
+            &mut self.input_queue.queued_user_messages,
+            &mut self.input_queue.queued_user_message_history_records,
+            client_id,
+        );
+        if removed {
+            self.input_queue.recovered_queue |= !self.input_queue.queued_user_messages.is_empty()
+                || !self.input_queue.rejected_steers_queue.is_empty()
+                || !self.input_queue.pending_steers.is_empty();
+            self.refresh_service_queue_views();
+        }
+        removed
+    }
+
+    pub(crate) fn recover_pending_service_queue_drafts(&mut self) {
+        let Some(thread_id) = self.thread_id else {
+            return;
+        };
+        let pending = match crate::queue_add_journal::load_for_thread(
+            self.local_settings.codex_home.as_path(),
+            thread_id,
+        ) {
+            Ok(pending) => pending,
+            Err(error) => {
+                tracing::warn!(kind = ?error.kind(), "queue draft journal read failed");
+                self.input_queue.recovered_queue = true;
+                self.add_error_message(
+                    "Could not read pending queued drafts. Input is paused.".into(),
+                );
+                return;
+            }
+        };
+        if pending.is_empty() {
+            return;
+        }
+        let mut restored = false;
+        for submission in pending.into_iter().rev() {
+            if self.input_queue.queued_user_messages.iter().any(|message| {
+                matches!(&message.delivery, MessageDelivery::QueueAddUnconfirmed(id) if id == &submission.client_user_message_id)
+            }) {
+                continue;
+            }
+            self.input_queue
+                .queued_user_messages
+                .push_front(QueuedUserMessage {
+                    user_message: submission.draft.user_message,
+                    action: submission.draft.action,
+                    delivery: MessageDelivery::QueueAddUnconfirmed(
+                        submission.client_user_message_id,
+                    ),
+                    pending_pastes: submission.draft.pending_pastes,
+                    source: submission.draft.source,
+                });
+            self.input_queue
+                .queued_user_message_history_records
+                .push_front(submission.draft.history_record);
+            restored = true;
+        }
+        if restored {
+            self.refresh_service_queue_views();
+        }
+    }
+
+    pub(crate) fn reject_service_queue_submission(
+        &mut self,
+        client_id: &str,
+        draft: QueueUiDraft,
+    ) -> bool {
+        let removed = remove_confirmed_queue_draft(
+            &mut self.input_queue.queued_user_messages,
+            &mut self.input_queue.queued_user_message_history_records,
+            client_id,
+        );
+        if removed {
+            self.input_queue.recovered_queue |= !self.input_queue.queued_user_messages.is_empty();
+            self.restore_failed_service_queue_draft(draft);
+            self.refresh_service_queue_views();
+        }
+        removed
+    }
+
+    pub(crate) fn set_service_queue_items(
+        &mut self,
+        thread_id: ThreadId,
+        items: Vec<QueuedSubmission>,
+    ) {
+        if self.thread_id == Some(thread_id) {
+            self.input_queue.service_items = items;
+            self.refresh_service_queue_views();
+        }
+    }
+
+    fn refresh_service_queue_views(&mut self) {
+        self.refresh_pending_input_preview();
+        self.bottom_pane
+            .refresh_queue_manager(self.service_queue_view_items());
+    }
+
+    pub(crate) fn service_queue_items(&self) -> &[QueuedSubmission] {
+        &self.input_queue.service_items
+    }
+
+    pub(crate) fn unconfirmed_service_queue_drafts(&self) -> Vec<(String, String)> {
+        self.input_queue
+            .queued_user_messages
+            .iter()
+            .enumerate()
+            .filter_map(|(index, message)| {
+                let MessageDelivery::QueueAddUnconfirmed(client_id) = &message.delivery else {
+                    return None;
+                };
+                let summary = user_messages::user_message_preview_text(
+                    message,
+                    self.input_queue
+                        .queued_user_message_history_records
+                        .get(index),
+                );
+                Some((
+                    client_id.clone(),
+                    if summary.trim().is_empty() {
+                        "[attachment or action]".into()
+                    } else {
+                        crate::text_formatting::truncate_text(&summary, 80)
+                    },
+                ))
+            })
+            .collect()
+    }
+
+    pub(crate) fn has_visible_service_queue_items(&self) -> bool {
+        !self.unconfirmed_service_queue_drafts().is_empty()
+            || self.input_queue.service_items.iter().any(|item| {
+                !matches!(
+                    item.state,
+                    QueueItemState::Completed | QueueItemState::Canceled
+                )
+            })
+    }
+
+    pub(crate) fn show_service_queue_manager(&mut self, thread_id: ThreadId) {
+        if self.thread_id != Some(thread_id) {
+            return;
+        }
+        let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel::<QueueViewOutput>();
+        let app_event_tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            while let Some(output) = rx.recv().await {
+                app_event_tx.send(AppEvent::ServiceQueueViewOutput { thread_id, output });
+            }
+        });
+        self.bottom_pane
+            .show_queue_manager(self.service_queue_view_items(), tx);
+    }
+
+    fn service_queue_view_items(&self) -> Vec<QueueViewItem> {
+        let mut items: Vec<QueueViewItem> = self
+            .input_queue
+            .service_items
+            .iter()
+            .filter(|item| {
+                !matches!(
+                    item.state,
+                    QueueItemState::Completed | QueueItemState::Canceled
+                )
+            })
+            .map(|item| {
+                let summary = item
+                    .input
+                    .iter()
+                    .filter_map(|input| match input {
+                        UserInput::Text { text, .. } => Some(text.as_str()),
+                        _ => None,
+                    })
+                    .collect::<Vec<_>>()
+                    .join(" ");
+                let summary = if summary.is_empty() {
+                    "[attachment or action]".to_string()
+                } else {
+                    summary
+                };
+                QueueViewItem {
+                    id: item.id.clone(),
+                    local_unconfirmed: false,
+                    summary,
+                    trigger: match &item.trigger {
+                        QueueTrigger::NextTurn => "after response (or now if idle)".to_string(),
+                        QueueTrigger::TurnCompleted { turn_id } => {
+                            format!("after response {turn_id}")
+                        }
+                        QueueTrigger::GoalCompleted { goal_id } => format!("after goal {goal_id}"),
+                        QueueTrigger::QueuedGoalCompleted { queued_item_id } => {
+                            format!("after queued goal {queued_item_id}")
+                        }
+                    },
+                    action: match &item.action {
+                        QueueAction::Prompt => "send prompt".to_string(),
+                        QueueAction::Goal { .. } => format!(
+                            "set goal{}",
+                            item.created_goal_id
+                                .as_ref()
+                                .map(|id| format!(" ({id})"))
+                                .unwrap_or_default()
+                        ),
+                        QueueAction::UiCommand { .. } => "run in TUI".to_string(),
+                    },
+                    destination: match &item.destination {
+                        QueueDestination::SourceThread => "current thread".to_string(),
+                        QueueDestination::NewThread => format!(
+                            "new thread{}",
+                            item.created_thread_id
+                                .as_ref()
+                                .map(|id| format!(" ({id})"))
+                                .unwrap_or_default()
+                        ),
+                        QueueDestination::CreatedThread { queued_item_id } => {
+                            format!("thread from item {queued_item_id}")
+                        }
+                    },
+                    state: item.state.clone(),
+                }
+            })
+            .collect();
+        for (client_id, summary) in self.unconfirmed_service_queue_drafts() {
+            if self
+                .input_queue
+                .service_items
+                .iter()
+                .any(|item| item.client_user_message_id == client_id)
+            {
+                continue;
+            }
+            items.push(QueueViewItem {
+                id: client_id,
+                local_unconfirmed: true,
+                summary,
+                trigger: "delivery unconfirmed".into(),
+                action: "review before retrying".into(),
+                destination: "current thread".into(),
+                state: QueueItemState::Uncertain,
+            });
+        }
+        items
+    }
+
+    pub(crate) fn open_service_queue_text_editor(
+        &mut self,
+        thread_id: ThreadId,
+        item: &QueuedSubmission,
+    ) {
+        let mut initial_text = match &item.action {
+            QueueAction::Goal { objective } => objective.clone(),
+            QueueAction::Prompt | QueueAction::UiCommand { .. } => item
+                .input
+                .iter()
+                .filter_map(|input| match input {
+                    UserInput::Text { text, .. } => Some(text.as_str()),
+                    _ => None,
+                })
+                .collect(),
+        };
+        for (_, marker) in Self::remote_image_editor_markers(item, &initial_text) {
+            initial_text.push('\n');
+            initial_text.push_str(&marker);
+        }
+        let id = item.id.clone();
+        let app_event_tx = self.app_event_tx.clone();
+        self.bottom_pane.show_text_prompt(CustomPromptView::new(
+            "Edit queued item".to_string(),
+            "Message or goal objective".to_string(),
+            initial_text,
+            Some(format!("ID: {}", item.id)),
+            Box::new(move |text| {
+                app_event_tx.send(AppEvent::ServiceQueueEditText {
+                    thread_id,
+                    id: id.clone(),
+                    text,
+                });
+            }),
+        ));
+    }
+
+    pub(crate) fn restore_failed_service_queue_draft(&mut self, draft: QueueUiDraft) {
+        if self.bottom_pane.composer_is_empty() {
+            self.restore_composer_state(ThreadComposerState {
+                text: draft.user_message.text,
+                local_images: draft.user_message.local_images,
+                remote_image_urls: draft.user_message.remote_image_urls,
+                text_elements: draft.user_message.text_elements,
+                mention_bindings: draft.user_message.mention_bindings,
+                pending_pastes: draft.pending_pastes,
+            });
+        } else {
+            self.input_queue
+                .queued_user_messages
+                .push_back(QueuedUserMessage {
+                    user_message: draft.user_message,
+                    action: draft.action,
+                    delivery: MessageDelivery::Unsent,
+                    pending_pastes: draft.pending_pastes,
+                    source: draft.source,
+                });
+            self.input_queue
+                .queued_user_message_history_records
+                .push_back(draft.history_record);
+            self.input_queue.recovered_queue = true;
+            self.refresh_pending_input_preview();
+        }
+    }
+
+    pub(crate) fn run_claimed_service_queue_draft(
+        &mut self,
+        thread_id: ThreadId,
+        mut draft: QueueUiDraft,
+        input: &[UserInput],
+    ) -> bool {
+        if !self.can_claim_service_queue_ui(thread_id) {
+            return false;
+        }
+        let snapshot_paths: Vec<_> = input
+            .iter()
+            .filter_map(|input| match input {
+                UserInput::LocalImage { path, .. } => Some(path),
+                _ => None,
+            })
+            .collect();
+        if snapshot_paths.len() != draft.user_message.local_images.len() {
+            self.add_error_message(
+                "Queued command image snapshots do not match its draft.".to_string(),
+            );
+            return false;
+        }
+        for (image, path) in draft
+            .user_message
+            .local_images
+            .iter_mut()
+            .zip(snapshot_paths)
+        {
+            image.path = path.clone();
+        }
+        let action = draft.action;
+        self.input_queue
+            .queued_user_messages
+            .push_front(QueuedUserMessage {
+                user_message: draft.user_message,
+                action: draft.action,
+                delivery: MessageDelivery::Unsent,
+                pending_pastes: draft.pending_pastes,
+                source: draft.source,
+            });
+        self.input_queue
+            .queued_user_message_history_records
+            .push_front(draft.history_record);
+        let queued_before = self.input_queue.queued_user_messages.len();
+        self.input_queue.executing_claimed_ui = true;
+        let sent = self.maybe_send_next_queued_input();
+        self.input_queue.executing_claimed_ui = false;
+        let consumed = self.input_queue.queued_user_messages.len() < queued_before;
+        if !consumed {
+            self.input_queue.queued_user_messages.pop_front();
+            self.input_queue
+                .queued_user_message_history_records
+                .pop_front();
+            self.refresh_pending_input_preview();
+        }
+        match action {
+            QueuedInputAction::Literal | QueuedInputAction::Plain => sent,
+            QueuedInputAction::ParseSlash | QueuedInputAction::RunShell => consumed,
+        }
+    }
+
+    pub(crate) fn acknowledge_claimed_service_queue_ui_when_ready(
+        &mut self,
+        thread_id: ThreadId,
+        id: String,
+        revision: u64,
+    ) {
+        if self.bottom_pane.no_modal_or_popup_active() {
+            self.app_event_tx.send(AppEvent::AckServiceQueueUi {
+                thread_id,
+                id,
+                revision,
+            });
+        } else {
+            self.input_queue.pending_service_ui_ack = Some((thread_id, id, revision));
+        }
+    }
+
+    pub(crate) fn can_claim_service_queue_ui(&self, thread_id: ThreadId) -> bool {
+        self.thread_id == Some(thread_id)
+            && self.is_session_configured()
+            && !self.is_user_turn_pending_or_running()
+            && !self.input_queue.submissions_paused()
+            && !self.input_queue.rate_limit_recovery_pending
+            && !self.input_queue.recovered_queue
+            && !self.input_queue.has_unconfirmed_messages()
+            && !self.fork_in_progress
+            && !self.blocks_direct_input
+            && !self.has_misalignment_policy_violation()
+            && self.bottom_pane.no_modal_or_popup_active()
+    }
+
+    pub(crate) fn service_queue_latest_turn_id(&self) -> Option<String> {
+        self.turn_lifecycle.last_turn_id.clone()
+    }
+}
+
+impl ThreadInputState {
+    pub(crate) fn confirm_service_queue_submission(&mut self, client_id: &str) -> bool {
+        remove_confirmed_queue_draft(
+            &mut self.queued_user_messages,
+            &mut self.queued_user_message_history_records,
+            client_id,
+        )
+    }
+
+    pub(crate) fn discard_service_queue_submission(&mut self, client_id: &str) -> bool {
+        let removed = self.confirm_service_queue_submission(client_id);
+        if removed {
+            self.recovered_queue |= !self.queued_user_messages.is_empty()
+                || !self.rejected_steers_queue.is_empty()
+                || !self.pending_steers.is_empty();
+        }
+        removed
+    }
+
+    pub(crate) fn reject_service_queue_submission(&mut self, client_id: &str) -> bool {
+        let Some(message) = self.queued_user_messages.iter_mut().find(|message| {
+            matches!(&message.delivery, MessageDelivery::QueueAddUnconfirmed(id) if id == client_id)
+        }) else {
+            return false;
+        };
+        message.delivery = MessageDelivery::Unsent;
+        self.recovered_queue = true;
+        true
+    }
+}
+
+fn remove_confirmed_queue_draft(
+    messages: &mut std::collections::VecDeque<QueuedUserMessage>,
+    records: &mut std::collections::VecDeque<UserMessageHistoryRecord>,
+    client_id: &str,
+) -> bool {
+    let Some(index) = messages.iter().position(|message| {
+        matches!(&message.delivery, MessageDelivery::QueueAddUnconfirmed(id) if id == client_id)
+    }) else {
+        return false;
+    };
+    messages.remove(index);
+    records.remove(index);
+    true
+}
