new file mode 100644
index 0000000000000000000000000000000000000000..b061bbae501943a0eed3be70bf127fee7dd64661
--- /dev/null
+++ b/codex-rs/tui/tests/suite/queue_pty.rs
@@ -0,0 +1,561 @@
+//! Queue journeys through the actual Codex terminal input and embedded app server.
+
+use super::focus_palette::PtyCodex;
+use super::focus_palette::write_test_config;
+use anyhow::Result;
+use anyhow::bail;
+use anyhow::ensure;
+use axum::Json;
+use axum::Router;
+use axum::body::Body;
+use axum::extract::State;
+use axum::http::StatusCode;
+use axum::http::header;
+use axum::response::IntoResponse;
+use axum::response::Response;
+use axum::routing::post;
+use core_test_support::responses;
+use futures::stream;
+use serde_json::Value;
+use std::fs;
+use std::path::Path;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::Instant;
+use tokio::sync::Notify;
+use wiremock::Match;
+use wiremock::MockServer;
+use wiremock::Request;
+
+const INITIAL: &str = "QUEUE_INITIAL_83173";
+const FIRST: &str = "QUEUE_FIRST_83173";
+const SECOND: &str = "QUEUE_SECOND_83173";
+const EDITED_FIRST: &str = "QUEUE_FIRST_83173_EDITED";
+const EDITED_SECOND: &str = "QUEUE_SECOND_83173_EDITED";
+
+#[derive(Clone)]
+struct UserTurnContaining {
+    prompt: &'static str,
+    requests: Arc<Mutex<Vec<Request>>>,
+}
+
+impl UserTurnContaining {
+    fn new(prompt: &'static str) -> Self {
+        Self {
+            prompt,
+            requests: Arc::new(Mutex::new(Vec::new())),
+        }
+    }
+
+    fn requests(&self) -> Vec<Request> {
+        self.requests
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone()
+    }
+
+    fn last_user_text(&self) -> Option<String> {
+        self.requests().last().and_then(last_user_text)
+    }
+}
+
+fn last_user_text(request: &Request) -> Option<String> {
+    let body: Value = serde_json::from_slice(&request.body).ok()?;
+    last_user_text_body(&body)
+}
+
+fn last_user_text_body(body: &Value) -> Option<String> {
+    Some(
+        body.get("input")?
+            .as_array()?
+            .iter()
+            .rev()
+            .find(|item| item.get("role").and_then(Value::as_str) == Some("user"))?
+            .get("content")?
+            .as_array()?
+            .iter()
+            .filter(|span| span.get("type").and_then(Value::as_str) == Some("input_text"))
+            .filter_map(|span| span.get("text").and_then(Value::as_str))
+            .collect::<String>(),
+    )
+}
+
+fn includes_prior_completed_response(
+    request: &Request,
+    prior_prompt: &str,
+    prior_answer: &str,
+) -> bool {
+    let Ok(body) = serde_json::from_slice::<Value>(&request.body) else {
+        return false;
+    };
+    body.get("previous_response_id").and_then(Value::as_str)
+        == Some(format!("done-{prior_prompt}").as_str())
+        || body
+            .get("input")
+            .is_some_and(|input| input.to_string().contains(prior_answer))
+}
+
+impl Match for UserTurnContaining {
+    fn matches(&self, request: &Request) -> bool {
+        let body = String::from_utf8_lossy(&request.body);
+        let matches = body.contains(r#"\"thread_source\":\"user\""#)
+            && last_user_text(request).as_deref() == Some(self.prompt);
+        if matches {
+            self.requests
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .push(request.clone());
+        }
+        matches
+    }
+}
+
+async fn setup() -> Result<(tempfile::TempDir, tempfile::TempDir, MockServer)> {
+    let workspace = tempfile::tempdir_in("/tmp")?;
+    let home = tempfile::tempdir_in("/tmp")?;
+    let server = responses::start_mock_server().await;
+    write_mock_config(home.path(), workspace.path(), &server.uri())?;
+    let _title = responses::mount_sse_once_match(
+        &server,
+        wiremock::matchers::body_string_contains(r#"\"thread_source\":\"system\""#),
+        responses::sse(vec![
+            responses::ev_assistant_message("title", r#"{"title":"Queue PTY test"}"#),
+            responses::ev_completed("title-response"),
+        ]),
+    )
+    .await;
+    Ok((workspace, home, server))
+}
+
+fn write_mock_config(home: &Path, workspace: &Path, server_uri: &str) -> Result<()> {
+    write_test_config(home, workspace)?;
+    let config_path = home.join("config.toml");
+    let config = fs::read_to_string(&config_path)?
+        .replace("model_provider = \"openai\"", "model_provider = \"test\"");
+    fs::write(
+        config_path,
+        format!(
+            "{config}\n[model_providers.test]\nname = \"Mock\"\nbase_url = \"{server_uri}/v1\"\nwire_api = \"responses\"\nrequires_openai_auth = false\nsupports_websockets = false\n"
+        ),
+    )?;
+    Ok(())
+}
+
+#[derive(Default)]
+struct CompletionGate {
+    initial_requests: AtomicUsize,
+    first_requests: AtomicUsize,
+    second_requests: AtomicUsize,
+    completion_chunk_sent: AtomicBool,
+    second_before_completion: AtomicBool,
+    release_completion: Notify,
+}
+
+fn sse_body(body: Body) -> Response {
+    ([(header::CONTENT_TYPE, "text/event-stream")], body).into_response()
+}
+
+async fn gated_response(
+    State(gate): State<Arc<CompletionGate>>,
+    Json(body): Json<Value>,
+) -> Response {
+    if body.to_string().contains(r#"\"thread_source\":\"system\""#) {
+        return sse_body(Body::from(responses::sse(vec![
+            responses::ev_assistant_message("title", r#"{"title":"Queue PTY test"}"#),
+            responses::ev_completed("title-response"),
+        ])));
+    }
+    match last_user_text_body(&body).as_deref() {
+        Some(INITIAL) => {
+            gate.initial_requests.fetch_add(1, Ordering::SeqCst);
+            tokio::time::sleep(Duration::from_secs(12)).await;
+            sse_body(Body::from(responses::sse(vec![
+                responses::ev_assistant_message("reply-initial", "INITIAL_DONE"),
+                responses::ev_completed("done-initial"),
+            ])))
+        }
+        Some(FIRST) => {
+            gate.first_requests.fetch_add(1, Ordering::SeqCst);
+            let events = stream::unfold(0_u8, move |phase| {
+                let gate = Arc::clone(&gate);
+                async move {
+                    match phase {
+                        0 => Some((
+                            Ok::<_, std::convert::Infallible>(responses::sse(vec![
+                                responses::ev_assistant_message("reply-first", "FIRST_DONE"),
+                            ])),
+                            1,
+                        )),
+                        1 => {
+                            gate.release_completion.notified().await;
+                            gate.completion_chunk_sent.store(true, Ordering::SeqCst);
+                            Some((
+                                Ok(responses::sse(vec![responses::ev_completed("done-first")])),
+                                2,
+                            ))
+                        }
+                        _ => None,
+                    }
+                }
+            });
+            sse_body(Body::from_stream(events))
+        }
+        Some(SECOND) => {
+            if !gate.completion_chunk_sent.load(Ordering::SeqCst) {
+                gate.second_before_completion.store(true, Ordering::SeqCst);
+            }
+            gate.second_requests.fetch_add(1, Ordering::SeqCst);
+            sse_body(Body::from(responses::sse(vec![
+                responses::ev_assistant_message("reply-second", "SECOND_DONE"),
+                responses::ev_completed("done-second"),
+            ])))
+        }
+        _ => (StatusCode::BAD_REQUEST, "unexpected model request").into_response(),
+    }
+}
+
+async fn setup_gated() -> Result<(
+    tempfile::TempDir,
+    tempfile::TempDir,
+    Arc<CompletionGate>,
+    tokio::task::JoinHandle<()>,
+)> {
+    let workspace = tempfile::tempdir_in("/tmp")?;
+    let home = tempfile::tempdir_in("/tmp")?;
+    let gate = Arc::new(CompletionGate::default());
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+    write_mock_config(
+        home.path(),
+        workspace.path(),
+        &format!("http://{}", listener.local_addr()?),
+    )?;
+    let router = Router::new()
+        .route("/v1/responses", post(gated_response))
+        .with_state(Arc::clone(&gate));
+    let server = tokio::spawn(async move {
+        let _ = axum::serve(listener, router).await;
+    });
+    Ok((workspace, home, gate, server))
+}
+
+async fn user_reply(
+    server: &MockServer,
+    prompt: &'static str,
+    answer: &str,
+    delay: Duration,
+) -> UserTurnContaining {
+    let body = responses::sse(vec![
+        responses::ev_assistant_message(&format!("reply-{prompt}"), answer),
+        responses::ev_completed(&format!("done-{prompt}")),
+    ]);
+    let matcher = UserTurnContaining::new(prompt);
+    let _response = responses::mount_response_once_match(
+        server,
+        matcher.clone(),
+        responses::sse_response(body).set_delay(delay),
+    )
+    .await;
+    matcher
+}
+
+fn queue_with_tab(terminal: &mut PtyCodex, prompt: &str) -> Result<()> {
+    terminal.write_input(prompt.as_bytes())?;
+    terminal.wait_for_screen(prompt)?;
+    // Bulk PTY writes are paste-like; let the Enter/Tab suppression window pass.
+    std::thread::sleep(Duration::from_millis(250));
+    terminal.write_input(b"\t")?;
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while Instant::now() < deadline {
+        terminal.read_output(Duration::from_millis(50))?;
+        if queue_preview_line(terminal.screen_contents().as_str(), prompt).is_some() {
+            return Ok(());
+        }
+        terminal.ensure_running()?;
+    }
+    bail!(
+        "Tab did not queue {prompt:?}; screen:\n{}",
+        terminal.screen_contents()
+    )
+}
+
+fn queue_preview_line(screen: &str, prompt: &str) -> Option<usize> {
+    screen
+        .lines()
+        .position(|line| line.contains('↳') && line.contains(prompt))
+}
+
+fn wait_for_queue(terminal: &mut PtyCodex, first: &str, second: &str) -> Result<()> {
+    terminal.wait_for_screen("Queued follow-up inputs")?;
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while Instant::now() < deadline {
+        terminal.read_output(Duration::from_millis(50))?;
+        let screen = terminal.screen_contents();
+        if let (Some(first_line), Some(second_line)) = (
+            queue_preview_line(&screen, first),
+            queue_preview_line(&screen, second),
+        ) && first_line != second_line
+        {
+            return Ok(());
+        }
+        terminal.ensure_running()?;
+    }
+    bail!(
+        "two separate queued prompts were not visible:\n{}",
+        terminal.screen_contents()
+    )
+}
+
+fn start(working_dir: &Path, home: tempfile::TempDir) -> Result<PtyCodex> {
+    PtyCodex::start_cli(
+        working_dir,
+        home,
+        &["--no-alt-screen", "-c", "features.shell_snapshot=false"],
+    )
+}
+
+fn submit_initial(terminal: &mut PtyCodex) -> Result<()> {
+    terminal.write_input(INITIAL.as_bytes())?;
+    terminal.wait_for_screen(INITIAL)?;
+    std::thread::sleep(Duration::from_millis(250));
+    terminal.write_input(b"\r")?;
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn tab_queue_drafts_remain_independent_when_editing_with_shift_left() -> Result<()> {
+    let (workspace, home, server) = setup().await?;
+    let initial = user_reply(&server, INITIAL, "INITIAL_DONE", Duration::from_secs(25)).await;
+    let first = user_reply(
+        &server,
+        EDITED_FIRST,
+        "FIRST_EDITED_DONE",
+        Duration::from_secs(6),
+    )
+    .await;
+    let second = user_reply(&server, EDITED_SECOND, "SECOND_EDITED_DONE", Duration::ZERO).await;
+    let mut terminal = start(workspace.path(), home)?;
+    terminal.wait_for_startup()?;
+    submit_initial(&mut terminal)?;
+    wait_for_request(&mut terminal, &initial, 1)?;
+
+    queue_with_tab(&mut terminal, FIRST)?;
+    queue_with_tab(&mut terminal, SECOND)?;
+    wait_for_queue(&mut terminal, FIRST, SECOND)?;
+
+    // Shift+Left opens the service queue with item 2 selected, without popping either draft.
+    terminal.write_input(b"\x1b[1;2D")?;
+    terminal.wait_for_screen("Queue (2)")?;
+    ensure!(terminal.screen_contains(FIRST) && terminal.screen_contains(SECOND));
+    ensure!(
+        terminal
+            .screen_contents()
+            .lines()
+            .any(|line| line.contains('›') && line.contains(SECOND)),
+        "the latest queued item was not selected:\n{}",
+        terminal.screen_contents()
+    );
+
+    terminal.write_input(b"e")?;
+    terminal.wait_for_screen("Edit queued item")?;
+    terminal.wait_for_screen(SECOND)?;
+    terminal.write_input(b"_EDITED")?;
+    terminal.wait_for_screen(EDITED_SECOND)?;
+    std::thread::sleep(Duration::from_millis(250));
+    terminal.write_input(b"\r")?;
+    terminal.wait_for_screen(&format!("2. {EDITED_SECOND} · pending"))?;
+    ensure!(
+        terminal.screen_contains(&format!("1. {FIRST} · pending")),
+        "editing item 2 dropped item 1"
+    );
+
+    terminal.write_input(b"\x1b[A")?;
+    terminal.wait_for_screen(&format!("Item: {FIRST}"))?;
+    terminal.write_input(b"e")?;
+    terminal.wait_for_screen("Edit queued item")?;
+    terminal.wait_for_screen(FIRST)?;
+    ensure!(
+        !terminal
+            .screen_contents()
+            .contains(&format!("{FIRST}{SECOND}")),
+        "the two drafts were combined in the editor"
+    );
+    terminal.write_input(b"_EDITED")?;
+    terminal.wait_for_screen(EDITED_FIRST)?;
+    std::thread::sleep(Duration::from_millis(250));
+    terminal.write_input(b"\r")?;
+    terminal.wait_for_screen(&format!("1. {EDITED_FIRST} · pending"))?;
+    ensure!(
+        terminal.screen_contains(&format!("2. {EDITED_SECOND} · pending")),
+        "editing item 1 changed or dropped item 2:\n{}",
+        terminal.screen_contents()
+    );
+    ensure!(
+        first.requests().is_empty() && second.requests().is_empty(),
+        "edited prompts dispatched during the initial response"
+    );
+    terminal.wait_for_screen("INITIAL_DONE")?;
+    wait_for_request(&mut terminal, &first, 1)?;
+    wait_for_response_without_request(&mut terminal, "FIRST_EDITED_DONE", &second)?;
+    wait_for_request(&mut terminal, &second, 1)?;
+    terminal.wait_for_screen("SECOND_EDITED_DONE")?;
+    ensure!(
+        first.requests().len() == 1 && first.last_user_text().as_deref() == Some(EDITED_FIRST),
+        "first edited prompt was not dispatched exactly once"
+    );
+    ensure!(
+        includes_prior_completed_response(&first.requests()[0], INITIAL, "INITIAL_DONE"),
+        "first edited request did not include the completed initial response"
+    );
+    ensure!(
+        second.requests().len() == 1 && second.last_user_text().as_deref() == Some(EDITED_SECOND),
+        "second edited prompt was not dispatched exactly once"
+    );
+    ensure!(
+        includes_prior_completed_response(&second.requests()[0], EDITED_FIRST, "FIRST_EDITED_DONE"),
+        "second edited request did not include the completed first response"
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn tab_queue_dispatches_each_prompt_after_the_prior_response() -> Result<()> {
+    let (workspace, home, server) = setup().await?;
+    let initial = user_reply(&server, INITIAL, "INITIAL_DONE", Duration::from_secs(12)).await;
+    let first = user_reply(&server, FIRST, "FIRST_DONE", Duration::from_secs(6)).await;
+    let second = user_reply(&server, SECOND, "SECOND_DONE", Duration::ZERO).await;
+    let mut terminal = start(workspace.path(), home)?;
+    terminal.wait_for_startup()?;
+    submit_initial(&mut terminal)?;
+    wait_for_request(&mut terminal, &initial, 1)?;
+
+    queue_with_tab(&mut terminal, FIRST)?;
+    queue_with_tab(&mut terminal, SECOND)?;
+    wait_for_queue(&mut terminal, FIRST, SECOND)?;
+    ensure!(
+        first.requests().is_empty() && second.requests().is_empty(),
+        "queued prompts dispatched during the initial response"
+    );
+    terminal.wait_for_screen("INITIAL_DONE")?;
+    wait_for_request(&mut terminal, &first, 1)?;
+    wait_for_response_without_request(&mut terminal, "FIRST_DONE", &second)?;
+    wait_for_request(&mut terminal, &second, 1)?;
+    terminal.wait_for_screen("SECOND_DONE")?;
+
+    ensure!(
+        first.requests().len() == 1 && first.last_user_text().as_deref() == Some(FIRST),
+        "first queued turn did not send its own prompt"
+    );
+    ensure!(
+        includes_prior_completed_response(&first.requests()[0], INITIAL, "INITIAL_DONE"),
+        "first request did not include the completed initial response"
+    );
+    ensure!(
+        second.requests().len() == 1 && second.last_user_text().as_deref() == Some(SECOND),
+        "second queued turn did not send its own prompt"
+    );
+    ensure!(
+        includes_prior_completed_response(&second.requests()[0], FIRST, "FIRST_DONE"),
+        "second request did not include the completed first response"
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn next_queued_prompt_waits_for_response_completed_after_assistant_text() -> Result<()> {
+    let (workspace, home, gate, server) = setup_gated().await?;
+    let mut terminal = start(workspace.path(), home)?;
+    terminal.wait_for_startup()?;
+    submit_initial(&mut terminal)?;
+    wait_for_count(&mut terminal, &gate.initial_requests, 1)?;
+
+    queue_with_tab(&mut terminal, FIRST)?;
+    queue_with_tab(&mut terminal, SECOND)?;
+    wait_for_queue(&mut terminal, FIRST, SECOND)?;
+    ensure!(gate.first_requests.load(Ordering::SeqCst) == 0);
+    ensure!(gate.second_requests.load(Ordering::SeqCst) == 0);
+
+    terminal.wait_for_screen("INITIAL_DONE")?;
+    wait_for_count(&mut terminal, &gate.first_requests, 1)?;
+    terminal.wait_for_screen("FIRST_DONE")?;
+    let hold_until = Instant::now() + Duration::from_secs(1);
+    while Instant::now() < hold_until {
+        terminal.read_output(Duration::from_millis(50))?;
+        ensure!(
+            gate.second_requests.load(Ordering::SeqCst) == 0,
+            "second prompt dispatched after assistant text but before response.completed"
+        );
+        ensure!(!gate.completion_chunk_sent.load(Ordering::SeqCst));
+        terminal.ensure_running()?;
+    }
+
+    gate.release_completion.notify_one();
+    wait_for_count(&mut terminal, &gate.second_requests, 1)?;
+    terminal.wait_for_screen("SECOND_DONE")?;
+    ensure!(gate.completion_chunk_sent.load(Ordering::SeqCst));
+    ensure!(!gate.second_before_completion.load(Ordering::SeqCst));
+    ensure!(gate.first_requests.load(Ordering::SeqCst) == 1);
+    ensure!(gate.second_requests.load(Ordering::SeqCst) == 1);
+    server.abort();
+    Ok(())
+}
+
+fn wait_for_count(terminal: &mut PtyCodex, count: &AtomicUsize, expected: usize) -> Result<()> {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while Instant::now() < deadline {
+        terminal.read_output(Duration::from_millis(50))?;
+        if count.load(Ordering::SeqCst) >= expected {
+            return Ok(());
+        }
+        terminal.ensure_running()?;
+    }
+    bail!(
+        "mock did not receive request; screen:\n{}",
+        terminal.screen_contents()
+    )
+}
+
+fn wait_for_response_without_request(
+    terminal: &mut PtyCodex,
+    completion: &str,
+    next: &UserTurnContaining,
+) -> Result<()> {
+    let deadline = Instant::now() + Duration::from_secs(15);
+    while Instant::now() < deadline {
+        ensure!(
+            next.requests().is_empty(),
+            "next prompt dispatched before {completion}"
+        );
+        terminal.read_output(Duration::from_millis(50))?;
+        if terminal.screen_contains(completion) {
+            return Ok(());
+        }
+        terminal.ensure_running()?;
+    }
+    bail!(
+        "missing {completion:?}; screen:\n{}",
+        terminal.screen_contents()
+    )
+}
+
+fn wait_for_request(
+    terminal: &mut PtyCodex,
+    response: &UserTurnContaining,
+    count: usize,
+) -> Result<()> {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while Instant::now() < deadline {
+        terminal.read_output(Duration::from_millis(50))?;
+        if response.requests().len() >= count {
+            return Ok(());
+        }
+        terminal.ensure_running()?;
+    }
+    bail!(
+        "model did not receive request; screen:\n{}",
+        terminal.screen_contents()
+    )
+}
diff --git a/scripts/local-codex-launcher.sh b/scripts/local-codex-launcher.sh
new file mode 100755
index 0000000000000000000000000000000000000000..7668ca3749914bace3d53023140a56e84a79877e
--- /dev/null
+++ b/scripts/local-codex-launcher.sh
@@ -0,0 +1,107 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
+link="$HOME/.local/bin/codex"
+record="$HOME/.local/state/codex-queue/launcher-targets"
+shim="$(dirname "$record")/codex-shim"
+temp_dir=""
+
+die() { printf '%s\n' "$*" >&2; exit 1; }
+cleanup() {
+  if [[ -n "$temp_dir" ]]; then
+    rm -f "$temp_dir/link"
+    rmdir "$temp_dir"
+  fi
+}
+trap cleanup EXIT
+
+replace_link() {
+  temp_dir=$(mktemp -d "$(dirname "$link")/.codex-queue.XXXXXX")
+  ln -s "$1" "$temp_dir/link"
+  mv -T "$temp_dir/link" "$link"
+  rmdir "$temp_dir"
+  temp_dir=""
+}
+
+write_shim() {
+  local replacement
+  replacement=$(mktemp "$(dirname "$shim")/.codex-shim.XXXXXX")
+  printf '#!/usr/bin/env bash\nset -euo pipefail\nlocal_binary=%q\nofficial=%q\nif [[ -x "$local_binary" ]]; then\n  exec "$local_binary" "$@"\nfi\nexec "$official" "$@"\n' "$binary" "$official" > "$replacement"
+  chmod 700 "$replacement"
+  mv -T "$replacement" "$shim"
+}
+
+saved=()
+if [[ -e "$record" ]]; then
+  mapfile -t saved < "$record"
+  [[ ${#saved[@]} -eq 3 && -n ${saved[0]} && -n ${saved[1]} && -n ${saved[2]} ]] || die "Invalid launcher backup: $record"
+fi
+
+case "${1:-}" in
+  install)
+    [[ $# -le 2 ]] || die "Usage: $0 install [binary]"
+    binary=${2:-$root/codex-rs/target/release/codex}
+    [[ -f "$binary" && -x "$binary" ]] || die "Missing executable binary: $binary"
+    binary=$(realpath "$binary")
+    [[ -L "$link" ]] || die "Refusing to replace non-symlink: $link"
+    current=$(readlink "$link")
+    if [[ ${#saved[@]} -eq 3 ]]; then
+      [[ "$binary" == "${saved[1]}" ]] || die "Rollback the current local build before changing binaries"
+      [[ "$current" == "${saved[0]}" || "$current" == "$shim" ]] || die "Launcher changed since install: $link"
+      official=${saved[2]}
+    else
+      [[ "$current" != "$shim" ]] || die "Cannot recover the original launcher target"
+      official=$current
+      [[ "$official" == /* ]] || official="$(dirname "$link")/$official"
+      [[ -f "$official" && -x "$official" ]] || die "Missing original executable: $official"
+      [[ $(realpath "$official") != "$binary" ]] || die "Cannot use the local build as its own fallback"
+      mkdir -p "$(dirname "$record")"
+      temp_record=$(mktemp "$(dirname "$record")/.launcher-targets.XXXXXX")
+      printf '%s\n%s\n%s\n' "$current" "$binary" "$official" > "$temp_record"
+      if ! ln "$temp_record" "$record"; then
+        rm -f "$temp_record"
+        die "Launcher backup already exists: $record"
+      fi
+      rm -f "$temp_record"
+    fi
+    write_shim
+    [[ "$current" != "$shim" ]] || { printf 'Already installed: %s\n' "$binary"; exit 0; }
+    replace_link "$shim"
+    printf 'Installed: %s\n' "$binary"
+    ;;
+  rollback)
+    [[ $# -eq 1 ]] || die "Usage: $0 rollback"
+    [[ ${#saved[@]} -eq 3 ]] || die "No launcher backup: $record"
+    [[ -L "$link" ]] || die "Refusing to replace non-symlink: $link"
+    current=$(readlink "$link")
+    [[ "$current" == "${saved[0]}" || "$current" == "$shim" ]] || die "Launcher changed since install: $link"
+    if [[ "$current" != "${saved[0]}" ]]; then
+      replace_link "${saved[0]}"
+    fi
+    rm -f "$shim"
+    rm "$record"
+    printf 'Restored: %s\n' "${saved[0]}"
+    ;;
+  rollback-all)
+    [[ $# -eq 1 ]] || die "Usage: $0 rollback-all"
+    [[ ${#saved[@]} -eq 3 ]] || die "No launcher backup: $record"
+    [[ -L "$link" ]] || die "Refusing to replace non-symlink: $link"
+    current=$(readlink "$link")
+    [[ "$current" == "${saved[0]}" || "$current" == "$shim" ]] || die "Launcher changed since install: $link"
+    [[ -x "${saved[2]}" ]] || die "Original Codex package is unavailable: ${saved[2]}"
+    "${saved[2]}" app-server daemon update --from-cli --yes
+    "$0" rollback
+    ;;
+  status)
+    [[ $# -eq 1 ]] || die "Usage: $0 status"
+    [[ -L "$link" ]] || die "Not a symlink: $link"
+    current=$(readlink "$link")
+    printf 'Current: %s\n' "$current"
+    if [[ ${#saved[@]} -eq 3 ]]; then
+      printf 'Local: %s\nFallback: %s\nRollback: %s\n' "${saved[1]}" "${saved[2]}" "${saved[0]}"
+      [[ "$current" == "${saved[0]}" || "$current" == "$shim" ]] || die "Launcher changed since install: $link"
+    fi
+    ;;
+  *) die "Usage: $0 {install [binary]|status|rollback|rollback-all}" ;;
+esac
diff --git a/scripts/test-local-codex-launcher.sh b/scripts/test-local-codex-launcher.sh
new file mode 100755
index 0000000000000000000000000000000000000000..d7d343e9caf863f61b79af66ff7dc9dad867689d
--- /dev/null
+++ b/scripts/test-local-codex-launcher.sh
@@ -0,0 +1,110 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+script=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/local-codex-launcher.sh
+fixture=$(mktemp -d)
+trap 'rm -rf "$fixture"' EXIT
+export HOME="$fixture/home"
+mkdir -p "$HOME/.local/bin" "$fixture/build"
+official="$fixture/official codex"
+local_binary="$fixture/build/local codex"
+export CODEX_QUEUE_TEST_LOG="$fixture/invocation.log"
+cat > "$official" <<'SH'
+#!/bin/sh
+printf '%s\n' official "$@" > "$CODEX_QUEUE_TEST_LOG"
+SH
+cat > "$local_binary" <<'SH'
+#!/bin/sh
+printf '%s\n' local "$@" > "$CODEX_QUEUE_TEST_LOG"
+SH
+chmod +x "$official" "$local_binary"
+link="$HOME/.local/bin/codex"
+ln -s "$official" "$link"
+
+"$script" status | grep -Fx "Current: $official"
+"$script" install "$local_binary"
+shim="$HOME/.local/state/codex-queue/codex-shim"
+[[ $(readlink "$link") == "$shim" ]]
+"$link" 'first arg' --help
+[[ $(cat "$CODEX_QUEUE_TEST_LOG") == $'local\nfirst arg\n--help' ]]
+record="$HOME/.local/state/codex-queue/launcher-targets"
+mapfile -t saved < "$record"
+[[ ${saved[0]} == "$official" && ${saved[1]} == "$local_binary" && ${saved[2]} == "$official" ]]
+"$script" status | grep -Fx "Rollback: $official"
+"$script" install "$local_binary" | grep -Fx "Already installed: $local_binary"
+chmod -x "$local_binary"
+"$link" 'fallback arg'
+[[ $(cat "$CODEX_QUEUE_TEST_LOG") == $'official\nfallback arg' ]]
+chmod +x "$local_binary"
+
+other="$fixture/other"
+ln -s "$other" "$fixture/replacement"
+mv -T "$fixture/replacement" "$link"
+if "$script" rollback 2>/dev/null; then
+  echo 'Rollback replaced a changed link' >&2
+  exit 1
+fi
+[[ $(readlink "$link") == "$other" ]]
+ln -s "$shim" "$fixture/replacement"
+mv -T "$fixture/replacement" "$link"
+"$script" rollback
+[[ $(readlink "$link") == "$official" && ! -e "$record" && ! -e "$shim" ]]
+
+rm "$link"
+printf 'preserve me\n' > "$link"
+if "$script" install "$local_binary" 2>/dev/null; then
+  echo 'Install replaced a regular file' >&2
+  exit 1
+fi
+[[ $(cat "$link") == 'preserve me' ]]
+rm "$link"
+ln -s "$official" "$link"
+if "$script" install "$fixture/missing" 2>/dev/null; then
+  echo 'Install accepted a missing binary' >&2
+  exit 1
+fi
+[[ $(readlink "$link") == "$official" && ! -e "$record" ]]
+chmod -x "$local_binary"
+if "$script" install "$local_binary" 2>/dev/null; then
+  echo 'Install accepted a non-executable binary' >&2
+  exit 1
+fi
+chmod +x "$local_binary"
+rm "$link"
+cp "$official" "$HOME/.local/original"
+ln -s '../original' "$link"
+"$script" install "$local_binary" >/dev/null
+"$link" 'relative fallback'
+[[ $(cat "$CODEX_QUEUE_TEST_LOG") == $'local\nrelative fallback' ]]
+chmod -x "$local_binary"
+"$link" 'relative official'
+[[ $(cat "$CODEX_QUEUE_TEST_LOG") == $'official\nrelative official' ]]
+chmod +x "$local_binary"
+"$script" rollback >/dev/null
+[[ $(readlink "$link") == '../original' && ! -e "$record" ]]
+
+rm "$link"
+official_current="$fixture/official-current"
+ln -s "$official" "$official_current"
+ln -s "$official_current" "$link"
+"$script" install "$local_binary" >/dev/null
+new_official="$fixture/new official"
+cat > "$new_official" <<'SH'
+#!/bin/sh
+printf '%s\n' updated-official "$@" > "$CODEX_QUEUE_TEST_LOG"
+SH
+chmod +x "$new_official"
+ln -s "$new_official" "$fixture/replacement"
+mv -T "$fixture/replacement" "$official_current"
