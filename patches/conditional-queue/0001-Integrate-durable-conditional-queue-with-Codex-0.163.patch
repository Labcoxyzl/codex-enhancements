+++ b/codex-rs/tui/src/app/queue_item_editor.rs
@@ -0,0 +1,310 @@
+//! Convert and edit queued prompt, goal, and TUI command payloads.
+
+use crate::app_event::ServiceQueueChange;
+use codex_app_server_protocol::QueueAction;
+use codex_app_server_protocol::QueueDestination;
+use codex_app_server_protocol::QueuedSubmission;
+use codex_app_server_protocol::UserInput;
+
+pub(super) fn service_queue_action_choices(
+    item: &QueuedSubmission,
+) -> (Vec<(String, ServiceQueueChange)>, Vec<(String, String)>) {
+    let mut choices = Vec::new();
+    let mut disabled = Vec::new();
+    for (name, action) in [
+        ("Send prompt", QueueAction::Prompt),
+        (
+            "Set or replace goal",
+            QueueAction::Goal {
+                objective: String::new(),
+            },
+        ),
+    ] {
+        match converted_queue_action(item, action) {
+            Ok((_, action)) => choices.push((name.to_string(), ServiceQueueChange::Action(action))),
+            Err(reason) => disabled.push((name.to_string(), reason)),
+        }
+    }
+    if item.destination == QueueDestination::SourceThread
+        && !matches!(item.action, QueueAction::Goal { .. })
+        && let Some(action) = crate::chatwidget::service_queue_ui_action_from_item(item)
+    {
+        choices.push((
+            "Run in this TUI".to_string(),
+            ServiceQueueChange::Action(action),
+        ));
+    }
+    (choices, disabled)
+}
+
+pub(super) fn converted_queue_action(
+    item: &QueuedSubmission,
+    action: QueueAction,
+) -> Result<(Vec<UserInput>, QueueAction), String> {
+    let text = if let QueueAction::Goal { objective } = &item.action {
+        objective.clone()
+    } else if let QueueAction::UiCommand { draft } = &item.action {
+        let draft: crate::chatwidget::QueueUiDraft = serde_json::from_value(draft.clone())
+            .map_err(|error| format!("Could not read queued command: {error}"))?;
+        if draft.pending_pastes.iter().any(|(placeholder, _)| {
+            draft.user_message.text.contains(placeholder)
+                && !draft.user_message.text_elements.iter().any(|element| {
+                    element.placeholder(&draft.user_message.text) == Some(placeholder.as_str())
+                })
+        }) {
+            return Err(
+                "Queued paste marker cannot be expanded. Edit the item before changing its action."
+                    .to_string(),
+            );
+        }
+        crate::bottom_pane::ChatComposer::expand_pending_pastes(
+            &draft.user_message.text,
+            draft.user_message.text_elements,
+            &draft.pending_pastes,
+        )
+        .0
+    } else {
+        item.input
+            .iter()
+            .filter_map(|part| match part {
+                UserInput::Text { text, .. } => Some(text.as_str()),
+                _ => None,
+            })
+            .collect::<String>()
+    };
+    match action {
+        QueueAction::Prompt => {
+            if text.chars().count() > codex_protocol::user_input::MAX_USER_INPUT_TEXT_CHARS {
+                return Err("Expanded prompt is too long for a queued message. Keep this TUI action or shorten the paste.".to_string());
+            }
+            let input = if matches!(&item.action, QueueAction::Goal { .. }) {
+                vec![UserInput::Text {
+                    text,
+                    text_elements: Vec::new(),
+                }]
+            } else {
+                edit_queue_item_text(item, text, &[])?.0
+            };
+            Ok((input, QueueAction::Prompt))
+        }
+        QueueAction::Goal { .. } => {
+            if item.input.iter().any(|part| {
+                !matches!(
+                    part,
+                    UserInput::Text { .. } | UserInput::Mention { .. } | UserInput::Skill { .. }
+                )
+            }) {
+                return Err("A queued goal cannot carry attachments. Keep this TUI action or remove its attachments.".to_string());
+            }
+            let objective = text
+                .strip_prefix("/goal ")
+                .unwrap_or(&text)
+                .trim()
+                .to_string();
+            if objective.is_empty()
+                || objective.chars().count()
+                    > codex_protocol::protocol::MAX_THREAD_GOAL_OBJECTIVE_CHARS
+            {
+                return Err("Queued goal objective must be 1–4000 characters. Keep /goal as a TUI action for large pastes.".to_string());
+            }
+            Ok((Vec::new(), QueueAction::Goal { objective }))
+        }
+        action @ QueueAction::UiCommand { .. } => Ok((item.input.clone(), action)),
+    }
+}
+
+pub(super) fn edit_queue_item_from_editor(
+    item: &QueuedSubmission,
+    text: String,
+) -> Result<(Vec<UserInput>, Option<QueueAction>), String> {
+    let original_text = item
+        .input
+        .iter()
+        .filter_map(|part| match part {
+            UserInput::Text { text, .. } => Some(text.as_str()),
+            _ => None,
+        })
+        .collect::<String>();
+    let markers = crate::chatwidget::ChatWidget::remote_image_editor_markers(item, &original_text);
+    let removed_remote_images = markers
+        .iter()
+        .filter_map(|(index, marker)| (!text.lines().any(|line| line == marker)).then_some(*index))
+        .collect::<Vec<_>>();
+    let text = text
+        .lines()
+        .filter(|line| !markers.iter().any(|(_, marker)| line == marker))
+        .collect::<Vec<_>>()
+        .join("\n");
+    edit_queue_item_text(item, text, &removed_remote_images)
+}
+
+fn edit_queue_item_text(
+    item: &QueuedSubmission,
+    text: String,
+    removed_remote_images: &[usize],
+) -> Result<(Vec<UserInput>, Option<QueueAction>), String> {
+    if let QueueAction::Goal { .. } = &item.action {
+        let objective = text.trim();
+        if objective.is_empty()
+            || objective.chars().count() > codex_protocol::protocol::MAX_THREAD_GOAL_OBJECTIVE_CHARS
+        {
+            return Err("Queued goal objective must be 1–4000 characters.".to_string());
+        }
+        return Ok((
+            Vec::new(),
+            Some(QueueAction::Goal {
+                objective: objective.to_string(),
+            }),
+        ));
+    }
+    let mut input = item.input.clone();
+    let original_text = item
+        .input
+        .iter()
+        .filter_map(|part| match part {
+            UserInput::Text { text, .. } => Some(text.as_str()),
+            _ => None,
+        })
+        .collect::<String>();
+    let mut image_number = 0;
+    let mut remote_image_index = 0;
+    let mut replaced_text = false;
+    input.retain_mut(|part| match part {
+        UserInput::Text {
+            text: old,
+            text_elements,
+        } if !replaced_text => {
+            *old = text.clone();
+            text_elements.clear();
+            replaced_text = true;
+            true
+        }
+        UserInput::Text { .. } => false,
+        UserInput::Mention { name, path } => {
+            has_mention_token(&text, &format!("@{name}"))
+                || path.starts_with("app://")
+                    && has_mention_token(
+                        &text,
+                        &format!(
+                            "${}",
+                            codex_connectors::metadata::connector_mention_slug_from_name(name)
+                        ),
+                    )
+        }
+        UserInput::Skill { name, .. } => has_mention_token(&text, &format!("${name}")),
+        UserInput::Image {
+            image: codex_app_server_protocol::ImageReference::Inline { .. },
+            ..
+        } => {
+            image_number += 1;
+            let index = remote_image_index;
+            remote_image_index += 1;
+            !removed_remote_images.contains(&index)
+        }
+        UserInput::LocalImage { .. } => {
+            image_number += 1;
+            let marker = codex_protocol::models::local_image_label_text(image_number);
+            // Keep markerless attachments because this text editor cannot identify them.
+            !original_text.contains(&marker) || text.contains(&marker)
+        }
+        _ => true,
+    });
+    if !replaced_text {
+        input.push(UserInput::Text {
+            text: text.clone(),
+            text_elements: Vec::new(),
+        });
+    }
+    let action = match &item.action {
+        QueueAction::Goal { .. } => unreachable!("goal entries are handled above"),
+        QueueAction::UiCommand { draft } => {
+            let mut original: crate::chatwidget::QueueUiDraft =
+                serde_json::from_value(draft.clone())
+                    .map_err(|error| format!("Could not edit queued command: {error}"))?;
+            let previous_text = original.user_message.text.clone();
+            let previous_elements = std::mem::take(&mut original.user_message.text_elements);
+            original.user_message.text = text.clone();
+            for element in previous_elements {
+                let Some(marker) =
+                    previous_text.get(element.byte_range.start..element.byte_range.end)
+                else {
+                    continue;
+                };
+                let mut positions = text.match_indices(marker);
+                let Some((start, _)) = positions.next() else {
+                    continue;
+                };
+                if positions.next().is_none()
+                    && !original
+                        .user_message
+                        .text_elements
+                        .iter()
+                        .any(|kept| kept.byte_range.start == start)
+                {
+                    original
+                        .user_message
+                        .text_elements
+                        .push(element.map_range(|_| (start..start + marker.len()).into()));
+                }
+            }
+            original.user_message.mention_bindings.retain(|binding| {
+                has_mention_token(&text, &format!("{}{}", binding.sigil, binding.mention))
+            });
+            original
+                .user_message
+                .local_images
+                .retain(|image| image.placeholder.is_empty() || text.contains(&image.placeholder));
+            let mut remote_image_number = 0;
+            original.user_message.remote_image_urls.retain(|_| {
+                let index = remote_image_number;
+                remote_image_number += 1;
+                !removed_remote_images.contains(&index)
+            });
+            original
+                .pending_pastes
+                .retain(|(placeholder, _)| text.contains(placeholder));
+            for (placeholder, _) in &original.pending_pastes {
+                if original
+                    .user_message
+                    .text_elements
+                    .iter()
+                    .any(|element| element.placeholder(&text) == Some(placeholder.as_str()))
+                {
+                    continue;
+                }
+                let mut positions = text.match_indices(placeholder);
+                let Some((start, _)) = positions.next() else {
+                    continue;
+                };
+                if positions.next().is_some() {
+                    return Err(format!(
+                        "Paste marker {placeholder} occurs more than once in the edit."
+                    ));
+                }
+                original.user_message.text_elements.push(
+                    codex_protocol::user_input::TextElement::new(
+                        (start..start + placeholder.len()).into(),
+                        Some(placeholder.clone()),
+                    ),
+                );
+            }
+            let draft = serde_json::to_value(original)
+                .map_err(|error| format!("Could not save queued command edit: {error}"))?;
+            Some(QueueAction::UiCommand { draft })
+        }
+        QueueAction::Prompt => None,
+    };
+    Ok((input, action))
+}
+
+fn has_mention_token(text: &str, token: &str) -> bool {
+    text.match_indices(token).any(|(start, _)| {
+        text.as_bytes()
+            .get(start + token.len())
+            .is_none_or(|byte| !byte.is_ascii_alphanumeric() && !matches!(byte, b'_' | b'-'))
+    })
+}
+
