+use super::*;
+use pretty_assertions::assert_eq;
+
+fn item(id: &str, summary: &str, state: QueueItemState) -> QueueViewItem {
+    QueueViewItem {
+        id: id.into(),
+        local_unconfirmed: false,
+        summary: summary.into(),
+        trigger: "After this response".into(),
+        action: "Send prompt".into(),
+        destination: "Current thread".into(),
+        state,
+    }
+}
+
+fn local_item(id: &str, summary: &str) -> QueueViewItem {
+    QueueViewItem {
+        local_unconfirmed: true,
+        state: QueueItemState::Uncertain,
+        ..item(id, summary, QueueItemState::Uncertain)
+    }
+}
+
+fn view(
+    items: Vec<QueueViewItem>,
+) -> (
+    QueueManagerView,
+    tokio::sync::mpsc::UnboundedReceiver<QueueViewOutput>,
+) {
+    let (tx, rx) = tokio::sync::mpsc::unbounded_channel();
+    (
+        QueueManagerView::new(items, crate::keymap::RuntimeKeymap::defaults().list, tx),
+        rx,
+    )
+}
+
+fn render(view: &QueueManagerView, width: u16) -> String {
+    let area = Rect::new(0, 0, width, view.desired_height(width));
+    let mut buf = Buffer::empty(area);
+    view.render(area, &mut buf);
+    (0..area.height)
+        .map(|row| {
+            (0..area.width)
+                .map(|col| buf[(col, row)].symbol())
+                .collect::<String>()
+                .trim_end()
+                .to_string()
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+        .trim_end()
+        .to_string()
+}
+
+#[test]
+fn selecting_and_refreshing_tracks_the_item_id_for_edit() {
+    let (mut view, mut rx) = view(vec![
+        item("first", "Repeated prompt", QueueItemState::Pending),
+        item("second", "Repeated prompt", QueueItemState::Pending),
+    ]);
+    view.handle_key_event(KeyCode::Down.into());
+    view.set_items(vec![
+        item("second", "Repeated prompt", QueueItemState::Pending),
+        item("first", "Repeated prompt", QueueItemState::Pending),
+    ]);
+    view.handle_key_event(KeyCode::Enter.into());
+
+    assert_eq!(
+        rx.try_recv().unwrap(),
+        QueueViewOutput::Edit {
+            id: "second".into()
+        }
+    );
+    assert!(rx.try_recv().is_err());
+}
+
+#[test]
+fn reorder_requests_use_selected_id_and_zero_based_target_without_local_mutation() {
+    let (mut view, mut rx) = view(vec![
+        item("a", "A", QueueItemState::Pending),
+        item("b", "B", QueueItemState::Pending),
+        item("c", "C", QueueItemState::Pending),
+    ]);
+    view.handle_key_event(KeyCode::Down.into());
+    view.handle_key_event(KeyEvent::new(KeyCode::Up, KeyModifiers::CONTROL));
+    view.handle_key_event(KeyEvent::new(KeyCode::Down, KeyModifiers::CONTROL));
+
+    assert_eq!(
+        rx.try_recv().unwrap(),
+        QueueViewOutput::Reorder {
+            id: "b".into(),
+            to_index: 0
+        }
+    );
+    assert_eq!(
+        rx.try_recv().unwrap(),
+        QueueViewOutput::Reorder {
+            id: "b".into(),
+            to_index: 2
+        }
+    );
+    assert_eq!(
+        view.items
+            .iter()
+            .map(|item| item.id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["a", "b", "c"]
+    );
+    assert!(rx.try_recv().is_err());
+}
+
+#[test]
+fn cancel_requests_target_only_the_selected_entry_and_escape_closes_without_request() {
+    let (mut view, mut rx) = view(vec![
+        item("a", "A", QueueItemState::Pending),
+        item("b", "B", QueueItemState::Pending),
+    ]);
+    view.handle_key_event(KeyCode::Down.into());
+    view.handle_key_event(KeyCode::Delete.into());
+    view.handle_key_event(KeyCode::Esc.into());
+
+    assert_eq!(
+        rx.try_recv().unwrap(),
+        QueueViewOutput::Cancel { id: "b".into() }
