+#[derive(Debug)]
+struct HoldAdmission(Arc<AtomicBool>);
+
+impl TurnStartAdmission for HoldAdmission {
+    fn admit_turn_start(&self) -> Option<Box<dyn Send>> {
+        if self.0.load(Ordering::SeqCst) {
+            Some(Box::new(()))
+        } else {
