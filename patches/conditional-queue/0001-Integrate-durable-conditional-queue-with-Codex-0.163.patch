+#[test]
+fn editing_ui_command_keeps_only_referenced_pastes_and_mentions() {
+    let draft = serde_json::json!({
+        "user_message": {
+            "text": "/goal @tool [paste-1] [paste-2]",
+            "local_images": [],
+            "remote_image_urls": [],
+            "text_elements": [
+                {"byte_range": {"start": 12, "end": 21}, "placeholder": "[paste-1]"},
+                {"byte_range": {"start": 22, "end": 31}, "placeholder": "[paste-2]"}
+            ],
+            "mention_bindings": [{"sigil": "@", "mention": "tool", "path": "app://tool"}]
+        },
+        "action": "ParseSlash",
+        "pending_pastes": [["[paste-1]", "first contents"], ["[paste-2]", "second contents"]],
+        "source": "Prompt",
+        "history_record": "UserMessageText"
+    });
+    let item = QueuedSubmission {
+        id: "item".into(),
+        input: vec![
+            UserInput::Text {
+                text: "/goal @tool [paste-1] [paste-2]".into(),
+                text_elements: Vec::new(),
+            },
+            UserInput::Mention {
+                name: "tool".into(),
+                path: "app://tool".into(),
+            },
+        ],
+        client_user_message_id: "message".into(),
+        trigger: QueueTrigger::NextTurn,
+        action: QueueAction::UiCommand { draft },
+        destination: QueueDestination::SourceThread,
+        state: QueueItemState::Pending,
+        revision: 0,
+        position: 0,
+        created_goal_id: None,
+        created_thread_id: None,
+    };
+    let (input, action) =
+        edit_queue_item_text(&item, "/goal revised [paste-2]".into(), &[]).unwrap();
+    assert_eq!(
+        input,
+        vec![UserInput::Text {
+            text: "/goal revised [paste-2]".into(),
+            text_elements: Vec::new()
+        }]
+    );
+    let Some(QueueAction::UiCommand { draft }) = action else {
+        panic!("expected UI command")
+    };
+    let edited_item = QueuedSubmission {
+        input,
+        action: QueueAction::UiCommand {
+            draft: draft.clone(),
+        },
+        ..item
+    };
+    let edited: crate::chatwidget::QueueUiDraft = serde_json::from_value(draft).unwrap();
+    assert_eq!(edited.user_message.text, "/goal revised [paste-2]");
+    assert!(edited.user_message.mention_bindings.is_empty());
+    assert_eq!(
+        edited.pending_pastes,
+        vec![("[paste-2]".into(), "second contents".into())]
+    );
+    assert_eq!(
+        crate::bottom_pane::ChatComposer::expand_pending_pastes(
+            &edited.user_message.text,
+            edited.user_message.text_elements,
+            &edited.pending_pastes,
+        )
+        .0,
+        "/goal revised second contents"
+    );
+
+    let (prompt_input, prompt_action) =
+        converted_queue_action(&edited_item, QueueAction::Prompt).unwrap();
+    assert_eq!(prompt_action, QueueAction::Prompt);
+    assert_eq!(
+        prompt_input,
+        vec![UserInput::Text {
+            text: "/goal revised second contents".into(),
+            text_elements: Vec::new(),
+        }]
+    );
+    let (goal_input, goal_action) = converted_queue_action(
+        &edited_item,
+        QueueAction::Goal {
+            objective: String::new(),
+        },
+    )
+    .unwrap();
+    assert_eq!(
+        goal_action,
+        QueueAction::Goal {
+            objective: "revised second contents".into()
+        }
+    );
+    assert!(goal_input.is_empty());
+    let (choices, disabled) = service_queue_action_choices(&edited_item);
+    assert!(disabled.is_empty());
+    assert!(choices.iter().any(|(name, change)| {
+            name == "Set or replace goal"
+                && matches!(change, ServiceQueueChange::Action(QueueAction::Goal { objective }) if objective == "revised second contents")
+        }));
+
+    let mut oversized = edited_item;
+    let QueueAction::UiCommand { draft } = &mut oversized.action else {
+        unreachable!()
+    };
+    draft["pending_pastes"][0][1] = serde_json::json!(
+        "x".repeat(codex_protocol::protocol::MAX_THREAD_GOAL_OBJECTIVE_CHARS + 1)
+    );
+    assert!(
+        converted_queue_action(
+            &oversized,
+            QueueAction::Goal {
+                objective: String::new()
+            }
+        )
+        .unwrap_err()
+        .contains("1–4000")
+    );
+    assert!(converted_queue_action(&oversized, QueueAction::Prompt).is_ok());
+    let (choices, disabled) = service_queue_action_choices(&oversized);
+    assert!(choices.iter().any(|(name, _)| name == "Send prompt"));
+    assert!(
+        !choices
+            .iter()
+            .any(|(name, _)| name == "Set or replace goal")
+    );
+    assert!(
+        disabled
+            .iter()
+            .any(|(name, reason)| name == "Set or replace goal" && reason.contains("1–4000"))
+    );
+}
