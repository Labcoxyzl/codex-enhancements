+                action: Some(QueueAction::Goal {
+                    objective: "Revised goal".to_string(),
+                }),
+                destination: None,
+                expected_revision: Some(goal.revision),
+            },
+        })
+        .await?;
+    assert_eq!(updated.queued_submission.revision, goal.revision + 1);
+    assert_eq!(updated.queued_submission.id, goal.id);
+    assert_eq!(updated.queued_submission.trigger, goal.trigger);
+    assert_eq!(updated.queued_submission.destination, goal.destination);
+    let stale = app
+        .send_raw_request(
+            "thread/queue/update",
+            Some(json!({
+                "threadId": thread_id,
+                "queuedSubmissionId": goal.id,
+                "input": [],
+                "expectedRevision": goal.revision
+            })),
+        )
+        .await?;
+    let error: JSONRPCError = timeout(
+        READ_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(stale)),
+    )
+    .await??;
+    assert!(error.error.message.contains("changed"));
+    Ok(())
+}
