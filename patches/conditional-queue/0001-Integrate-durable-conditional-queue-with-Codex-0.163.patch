+async fn blocked_queue_model(
+    count: usize,
+) -> (StreamingSseServer, Vec<tokio::sync::oneshot::Sender<()>>) {
+    let mut releases = Vec::new();
+    let responses = (0..count)
+        .map(|index| {
+            let (release, gate) = tokio::sync::oneshot::channel();
+            releases.push(release);
+            let id = format!("running-queue-{index}");
+            vec![
+                StreamingSseChunk {
+                    gate: None,
+                    body: responses::sse(vec![responses::ev_response_created(&id)]),
+                },
+                StreamingSseChunk {
+                    gate: Some(gate),
+                    body: responses::sse(vec![responses::ev_completed(&id)]),
+                },
+            ]
+        })
+        .collect();
+    let (server, _completions) = start_streaming_sse_server(responses).await;
+    (server, releases)
+}
+
+fn configure_queue_model(app: &mut App, uri: &str, resume_cwd: &str) -> Result<()> {
+    app.config.model = Some("gpt-5.2".into());
+    app.config.model_provider_id = "queue-test".into();
+    app.config.model_provider = ModelProviderInfo {
+        name: "Queue test".into(),
+        base_url: Some(format!("{uri}/v1")),
+        request_max_retries: Some(0),
+        stream_max_retries: Some(0),
+        ..ModelProviderInfo::default()
+    };
+    app_test_support::MockResponsesConfig::new(uri)
+        .with_model("gpt-5.2")
+        .with_model_provider("queue-test")
+        .with_provider_name("Queue test")
+        .with_extra_config(&format!("[tui]\nresume_cwd = \"{resume_cwd}\"\n"))
+        .write(app.config.codex_home.as_path())?;
+    Ok(())
+}
+
+async fn start_blocked_queue_turn(
+    app: &mut App,
+    app_server: &mut crate::app_server_session::AppServerSession,
+    model: &StreamingSseServer,
+    thread_id: ThreadId,
+    request_count: usize,
+) -> Result<()> {
+    let request_id = app_server.next_request_id();
+    let started: TurnStartResponse = app_server
+        .request_handle()
+        .request_typed(ClientRequest::TurnStart {
+            request_id,
+            params: TurnStartParams {
+                thread_id: thread_id.to_string(),
+                input: vec![codex_app_server_protocol::UserInput::Text {
+                    text: "Work while I queue a follow-up".into(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            },
+        })
+        .await?;
+    tokio::time::timeout(
+        std::time::Duration::from_secs(5),
+        model.wait_for_request_count(request_count),
+    )
+    .await?;
+    assert!(matches!(
+        app_server.thread_read(thread_id, false).await?.status,
+        ThreadStatus::Active { .. }
+    ));
+    app.chat_widget.handle_server_notification(
+        ServerNotification::TurnStarted(codex_app_server_protocol::TurnStartedNotification {
+            thread_id: thread_id.to_string(),
+            turn: started.turn,
+        }),
+        None,
+    );
+    Ok(())
+}
+
+async fn source_queue(
+    app_server: &mut crate::app_server_session::AppServerSession,
+    thread_id: ThreadId,
+) -> Result<Vec<QueuedSubmission>> {
+    let request_id = app_server.next_request_id();
+    let response: ThreadQueueListResponse = app_server
+        .request_handle()
+        .request_typed(ClientRequest::ThreadQueueList {
+            request_id,
+            params: ThreadQueueListParams {
+                thread_id: thread_id.to_string(),
+                cursor: None,
+                limit: Some(200),
+            },
+        })
+        .await?;
+    Ok(response.data)
+}
+
+async fn submit_queued_follow_up(
+    app: &mut App,
+    tui: &mut crate::tui::Tui,
+    app_server: &mut crate::app_server_session::AppServerSession,
+    events: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+    thread_id: ThreadId,
+    text: &str,
+) -> Result<()> {
+    app.chat_widget.apply_external_edit(text.into());
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Tab, KeyModifiers::NONE));
+    let event = std::iter::from_fn(|| events.try_recv().ok())
+        .find(|event| matches!(event, AppEvent::QueueTabSubmission(_)))
+        .expect("Tab emits a service queue submission");
+    let AppEvent::QueueTabSubmission(submission) = &event else {
+        unreachable!()
+    };
+    assert_eq!(submission.thread_id, thread_id);
+    Box::pin(app.handle_event(tui, app_server, event)).await?;
+    let queued = source_queue(app_server, thread_id).await?;
+    assert_eq!(queued.len(), 1);
+    assert_eq!(queued[0].state, QueueItemState::Pending);
+    assert!(queued[0].input.iter().any(|part| {
+        matches!(part, codex_app_server_protocol::UserInput::Text { text: queued_text, .. } if queued_text == text)
+    }));
+    Ok(())
+}
