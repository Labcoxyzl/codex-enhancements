+async fn tab_submission() -> Result<(
+    Box<App>,
+    tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+    QueueTabSubmission,
+)> {
+    let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let init = app.chatwidget_init_for_forked_or_resumed_thread(
+        &mut tui,
+        app.config.clone(),
+        /*initial_user_message*/ None,
+    );
+    app.replace_chat_widget(ChatWidget::new_with_app_event(init));
+    let thread_id = ThreadId::new();
+    app.active_thread_id = Some(thread_id);
+    app.chat_widget
+        .handle_thread_session(test_thread_session(thread_id, app.config.cwd.to_path_buf()));
+    while events.try_recv().is_ok() {}
+    assert!(app.chat_widget.queue_user_message_with_options(
+        "keep queued draft".into(),
+        QueuedInputAction::Plain,
+        Vec::new(),
+    ));
+    let submission = std::iter::from_fn(|| events.try_recv().ok())
+        .find_map(|event| match event {
+            AppEvent::QueueTabSubmission(submission) => Some(submission),
+            _ => None,
+        })
+        .expect("Tab submission event");
+    assert!(
+        app.chat_widget
+            .capture_thread_input_state()
+            .is_some_and(|state| state.has_unconfirmed_messages())
+    );
+    Ok((app, events, submission))
+}
+
+fn server_item(submission: &QueueTabSubmission) -> QueuedSubmission {
+    QueuedSubmission {
+        id: "queued-1".into(),
+        input: submission.input.clone(),
+        client_user_message_id: submission.client_user_message_id.clone(),
+        trigger: QueueTrigger::NextTurn,
+        action: QueueAction::Prompt,
+        destination: QueueDestination::SourceThread,
+        state: QueueItemState::Pending,
+        revision: 0,
+        position: 0,
+        created_goal_id: None,
+        created_thread_id: None,
+    }
+}
