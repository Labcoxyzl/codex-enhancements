+#[tokio::test]
+async fn overview_recent_grouping_orders_activity_and_preserves_selection() {
+    let mut app = make_test_app().await;
+    let mut threads = [
+        (1, 90, Some(10)),
+        (2, 20, None),
+        (3, 1, Some(30)),
+        (4, 0, None),
+        (5, 2, Some(30)),
+    ]
+    .into_iter()
+    .map(|(id, updated_at, recency_at)| {
+        let mut thread = overview_thread(
+            ThreadId::from_u128(id),
+            /*parent_thread_id*/ None,
+            &format!("Task {id}"),
+            if id == 3 {
+                ThreadStatus::NotLoaded
+            } else {
+                ThreadStatus::Idle
+            },
+        );
+        thread.updated_at = updated_at;
+        thread.recency_at = recency_at;
+        thread.cwd = test_path_buf(&format!("/tmp/project-{id}")).abs();
+        thread.model = Some(format!("model-{id}"));
+        thread
+    })
+    .collect::<Vec<_>>();
+    let selected = ThreadId::from_u128(2);
+    let mut view = app.agents_overview_view(threads.clone(), Some(selected));
+    for _ in 0..3 {
+        view.handle_key_event(KeyCode::Char('g').into());
+    }
+    assert_eq!(
+        app.agents_overview.view_state.lock().unwrap().grouping,
+        AgentsOverviewGrouping::Recent
+    );
+    view.pinned_thread_ranks = Some(HashMap::from([(ThreadId::from_u128(4), 0)]));
+    let order = |view: &mut AgentsOverviewView| {
+        view.handle_key_event(KeyCode::Home.into());
+        (0..view.rows.len())
+            .map(|_| {
+                let id = view.rows[view.selected_index().unwrap()].thread_id;
+                view.handle_key_event(KeyCode::Down.into());
+                id
+            })
+            .collect::<Vec<_>>()
+    };
+    assert_eq!(
+        view.rows[view.selected_index().unwrap()].thread_id,
+        selected
+    );
+    assert_eq!(order(&mut view), [4, 5, 3, 2, 1].map(ThreadId::from_u128));
+    app.chat_widget.show_bottom_pane_view(Box::new(view));
+    let rendered = render_bottom_popup(&app.chat_widget, 100);
+    assert!(rendered.contains("Recent"), "{rendered}");
+    assert!(rendered.contains("Pinned"), "{rendered}");
+    insta::assert_snapshot!(
+        "agents_overview_recent_grouping",
+        normalize_agent_center_snapshot(rendered.replace("fwd del", "del"))
+    );
+
+    threads[0].recency_at = Some(40);
+    let mut refreshed = app.agents_overview_view(threads, Some(selected));
+    refreshed.pinned_thread_ranks = Some(HashMap::from([(ThreadId::from_u128(4), 0)]));
+    assert_eq!(
+        refreshed.rows[refreshed.selected_index().unwrap()].thread_id,
+        selected
+    );
+    assert_eq!(
+        order(&mut refreshed),
+        [4, 1, 5, 3, 2].map(ThreadId::from_u128)
+    );
+    refreshed.handle_key_event(KeyCode::End.into());
+    refreshed.handle_key_event(KeyCode::Up.into());
+    assert_eq!(
+        refreshed.rows[refreshed.selected_index().unwrap()].thread_id,
+        ThreadId::from_u128(3)
+    );
+    refreshed.handle_key_event(KeyCode::Char('g').into());
+    assert_eq!(
+        app.agents_overview.view_state.lock().unwrap().grouping,
+        AgentsOverviewGrouping::Project
+    );
+}
