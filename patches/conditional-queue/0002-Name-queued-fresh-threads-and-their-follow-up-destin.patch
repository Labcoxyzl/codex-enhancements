+async fn new_thread_name_is_optional_and_normalized() -> anyhow::Result<()> {
+    let old: QueueDestination = serde_json::from_value(serde_json::json!({"type": "newThread"}))?;
+    assert_eq!(old, QueueDestination::NewThread { name: None });
+    assert_eq!(
