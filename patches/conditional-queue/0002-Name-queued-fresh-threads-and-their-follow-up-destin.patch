+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn named_new_thread_appears_as_follow_up_destination() -> Result<()> {
+    let (workspace, home, server) = setup().await?;
+    let initial = user_reply(&server, INITIAL, "INITIAL_DONE", Duration::from_secs(60)).await;
+    let mut terminal = start(workspace.path(), home)?;
+    terminal.wait_for_startup()?;
+    submit_initial(&mut terminal)?;
+    wait_for_request(&mut terminal, &initial, 1)?;
+    queue_with_tab(&mut terminal, FIRST)?;
+    queue_with_tab(&mut terminal, SECOND)?;
+    terminal.write_input(b"\x1b[1;2D")?;
+    terminal.wait_for_screen("Queue (2)")?;
+    terminal.write_input(b"\x1b[A")?;
+    terminal.wait_for_screen(&format!("Item: {FIRST}"))?;
+    terminal.write_input(b"n")?;
+    terminal.wait_for_screen("Where should this run?")?;
+    terminal.wait_for_screen("New thread (name it")?;
+    terminal.write_input(b"\x1b[B\x1b[B\r")?;
+    terminal.wait_for_screen("Name new thread")?;
+    terminal.write_input(b"Implementation")?;
+    std::thread::sleep(Duration::from_millis(250));
+    terminal.write_input(b"\r")?;
+    terminal.wait_for_screen("new thread (Implementation)")?;
+    terminal.write_input(b"\x1b[B")?;
+    terminal.wait_for_screen(&format!("Item: {SECOND}"))?;
+    terminal.write_input(b"n")?;
+    terminal.wait_for_screen("Implementation (item 1)")?;
+    ensure!(
+        initial.requests().len() == 1,
+        "queued prompts ran before the initial response completed"
+    );
+    Ok(())
+}
