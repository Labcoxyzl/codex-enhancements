+        serde_json::json!({"type": "newThread"})
+    );
+
+    let (queue, _home) = test_queue().await?;
+    let source_id = ThreadId::new();
+    let service =
+        QueuedItemService::new(queue.clone(), Weak::new(), Arc::new(NoopExtensionEventSink));
+    let blank = service
+        .enqueue_with_metadata(
+            source_id,
+            user_input("blank"),
+            QueueMetadata {
+                destination: QueueDestination::NewThread {
+                    name: Some("   ".to_string()),
+                },
+                ..Default::default()
+            },
+        )
+        .await?;
+    assert_eq!(blank.destination, old);
+    let named = service
+        .update_with_metadata(
+            source_id,
+            blank.id,
+            blank.input,
+            QueueMetadataPatch {
+                destination: Some(QueueDestination::NewThread {
+                    name: Some("  Named follow-up  ".to_string()),
+                }),
+                ..Default::default()
+            },
+            Some(blank.revision),
+        )
+        .await?
+        .context("queued item disappeared")?;
+    assert_eq!(
+        named.destination,
+        QueueDestination::NewThread {
+            name: Some("Named follow-up".to_string()),
+        }
+    );
+    assert_eq!(
+        service.list(source_id).await?[0].destination,
+        named.destination
+    );
+    assert!(matches!(
+        service
+            .enqueue_with_metadata(
+                source_id,
+                user_input("too long"),
+                QueueMetadata {
+                    destination: QueueDestination::NewThread {
+                        name: Some("x".repeat(257)),
+                    },
+                    ..Default::default()
+                },
+            )
+            .await,
+        Err(QueueServiceError::InvalidEntry(_))
+    ));
+    Ok(())
+}
